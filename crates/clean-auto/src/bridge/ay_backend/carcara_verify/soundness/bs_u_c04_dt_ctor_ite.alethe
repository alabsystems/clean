(assume a0 (not (= (ite true 0) (ite false 0))))
(step t1 (cl (= (not (= (ite true 0) (ite false 0))) false)) :rule evaluate)
(step t2 (cl (not (= (not (= (ite true 0) (ite false 0))) false)) (not (not (= (ite true 0) (ite false 0)))) false) :rule equiv_pos2)
(step t3 (cl (not false)) :rule false)
(step t4 (cl) :rule resolution :premises (t2 t1 a0 t3))
