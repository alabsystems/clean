def ir_vcg_mframes (s : VcgMach) : IRList VcgFrame := @VcgMach.rec (fun (_ : VcgMach) => IRList VcgFrame) (fun (fs : IRList VcgFrame) (_ : IRList VcgCell) (_ : VcgNat) => fs) s

def ir_vcg_mna (s : VcgMach) : VcgNat := @VcgMach.rec (fun (_ : VcgMach) => VcgNat) (fun (_ : IRList VcgFrame) (_ : IRList VcgCell) (na : VcgNat) => na) s

def ir_vcg_lget (l : IRList VcgBind) (k : Nat) : VcgVal := @IRList.rec VcgBind (fun (_ : IRList VcgBind) => VcgVal) VcgVal.undef_ (fun (b : VcgBind) (_ : IRList VcgBind) (ih : VcgVal) => @VcgBind.rec (fun (_ : VcgBind) => VcgVal) (fun (i : Nat) (v : VcgVal) => @Bool.rec (fun (_ : Bool) => VcgVal) ih v (ir_nat_eqb i k)) b) l

def ir_vcg_getd (s : VcgMach) (k : Nat) : VcgVal := @IRList.rec VcgFrame (fun (_ : IRList VcgFrame) => VcgVal) VcgVal.undef_ (fun (f : VcgFrame) (_ : IRList VcgFrame) (_ : VcgVal) => @VcgFrame.rec (fun (_ : VcgFrame) => VcgVal) (fun (_ : Nat) (_ : Nat) (_ : Nat) (loc : IRList VcgBind) (_ : IROption (IRList Nat)) => ir_vcg_lget loc k) f) (ir_vcg_mframes s)

def ir_vcg_addr (v : VcgVal) : VcgNat := @VcgVal.rec (fun (_ : VcgVal) => VcgNat) (VcgNat.lit Nat.zero) (fun (_ : Bool) => VcgNat.lit Nat.zero) (fun (_ : VcgNat) => VcgNat.lit Nat.zero) (fun (_ : Nat) => VcgNat.lit Nat.zero) (VcgNat.lit Nat.zero) (fun (a : VcgNat) => a) (VcgNat.lit Nat.zero) (fun (dd : VcgNat) (_ : VcgNat) => dd) (fun (_ : Nat) => VcgNat.lit Nat.zero) (fun (_ : VcgVal) (_ : VcgNat) => VcgNat.lit Nat.zero) (VcgNat.lit Nat.zero) (fun (_ : VcgVal) (_ : VcgVal) (_ : VcgNat) (_ : VcgNat) => VcgNat.lit Nat.zero) (fun (_ : Nat) => VcgNat.lit Nat.zero) v

def ir_vcg_bindex (fs : IRList VcgFact) (a : VcgNat) : IROption Nat := @IRList.rec VcgFact (fun (_ : IRList VcgFact) => Nat -> IROption Nat) (fun (_ : Nat) => @IROption.none Nat) (fun (f : VcgFact) (_ : IRList VcgFact) (ih : Nat -> IROption Nat) => fun (j : Nat) => @VcgFact.rec (fun (_ : VcgFact) => IROption Nat) (fun (_ : VcgNat) (_ : VcgVal) (_ : Bool) => ih (Nat.succ j)) (fun (_ : VcgNat) (_ : VcgNat) => ih (Nat.succ j)) (fun (_ : IRList VcgCell) (x : VcgNat) => @Bool.rec (fun (_ : Bool) => IROption Nat) (ih (Nat.succ j)) (@IROption.some Nat j) (ir_vcg_nbeq x a)) f) fs Nat.zero

def ir_vcg_is_bottom (s : VcgMach) : Bool := @IRList.rec VcgFrame (fun (_ : IRList VcgFrame) => Bool) Bool.false (fun (f : VcgFrame) (rest : IRList VcgFrame) (_ : Bool) => @IRList.rec VcgFrame (fun (_ : IRList VcgFrame) => Bool) Bool.true (fun (_ : VcgFrame) (_ : IRList VcgFrame) (_ : Bool) => Bool.false) rest) (ir_vcg_mframes s)

def ir_vcg_resolve (s : VcgMach) (ids : IRList Nat) : IRList VcgVal := @IRList.rec Nat (fun (_ : IRList Nat) => IRList VcgVal) (@IRList.nil VcgVal) (fun (i : Nat) (_ : IRList Nat) (ih : IRList VcgVal) => @IRList.cons VcgVal (ir_vcg_getd s i) ih) ids

def ir_vcg_nmem (l : IRList Nat) (k : Nat) : Bool := @IRList.rec Nat (fun (_ : IRList Nat) => Bool) Bool.false (fun (x : Nat) (_ : IRList Nat) (ih : Bool) => Bool.or (ir_nat_eqb x k) ih) l

def ir_vcg_classify_inst (stops : IRList Nat) (fs : IRList VcgFact) (s : VcgMach) (rs : IRList Nat) (i : IRInst) : VcgStep := @IRInst.rec (fun (_ : IRInst) => VcgStep)
  (fun (_ : IRBinOp) (_ : IRTy) (_ : Nat) (_ : Nat) => VcgStep.pure s)
  (fun (_ : IRUnOp) (_ : IRTy) (_ : Nat) => VcgStep.pure s)
  (fun (_ : IROverflowOp) (_ : IRTy) (_ : Nat) (_ : Nat) => VcgStep.pure s)
  (fun (_ : IRICmpOp) (_ : IRTy) (_ : Nat) (_ : Nat) => VcgStep.pure s)
  (fun (_ : IRFCmpOp) (_ : IRTy) (_ : Nat) (_ : Nat) => VcgStep.pure s)
  (fun (_ : IRCastOp) (_ : IRTy) (_ : IRTy) (_ : Nat) => VcgStep.pure s)
  (fun (t : IRTy) (p : Nat) (_ : Bool) => VcgStep.load s rs t (ir_vcg_addr (ir_vcg_getd s p)))
  (fun (_ : IRTy) (p : Nat) (v : Nat) (_ : Bool) => VcgStep.store s (ir_vcg_addr (ir_vcg_getd s p)) (ir_vcg_getd s v))
  (fun (_ : IRTy) (_ : IROption Nat) => VcgStep.pure s)
  (fun (_ : IRTy) (_ : Nat) (_ : IRList Nat) (_ : Bool) => VcgStep.pure s)
  (fun (_ : IRTy) (_ : Nat) => VcgStep.pure s)
  (fun (_ : IRTy) (_ : IRTy) (_ : Nat) => VcgStep.pure s)
  (fun (_ : IRTy) (_ : IRTy) (_ : Nat) (_ : Nat) => VcgStep.pure s)
  (fun (_ : Nat) (_ : IRList Nat) => VcgStep.pure s)
  (fun (_ : Nat) (_ : Nat) (_ : IRList Nat) (_ : Nat) (_ : IRList Nat) => VcgStep.pure s)
  (fun (_ : Nat) (_ : Nat) (_ : IRList Nat) (_ : IRList IRSwitchCase) (_ : Bool) => VcgStep.pure s)
  (fun (fid : Nat) (_ : IRList Nat) => @Bool.rec (fun (_ : Bool) => VcgStep) (VcgStep.pure s) (VcgStep.stop s) (ir_vcg_nmem stops fid))
  (fun (_ : Nat) (_ : Nat) (_ : IRList Nat) (_ : Nat) => VcgStep.pure s)
  (fun (ids : IRList Nat) => @Bool.rec (fun (_ : Bool) => VcgStep) (VcgStep.pure s) (VcgStep.fin s (ir_vcg_mfresh s) (ir_vcg_mna s) (ir_vcg_resolve s ids)) (ir_vcg_is_bottom s))
  (fun (_ : IRTy) (_ : Nat) (_ : Nat) => VcgStep.pure s)
  (fun (_ : IRTy) (_ : Nat) (_ : Nat) (_ : Nat) => VcgStep.pure s)
  (fun (_ : IRTy) (_ : Nat) (_ : Nat) => VcgStep.pure s)
  (fun (_ : IRTy) (_ : IRConst) => VcgStep.pure s)
  (fun (_ : Nat) => VcgStep.pure s)
  (fun (_ : IRTy) => VcgStep.pure s)
  (fun (_ : Nat) => VcgStep.pure s)
  (VcgStep.pure s)
  (fun (_ : IRTy) (_ : Nat) (_ : Nat) (_ : Nat) => VcgStep.pure s)
  (fun (p : Nat) => @IROption.rec Nat (fun (_ : IROption Nat) => VcgStep) (VcgStep.borrowl s rs (ir_vcg_addr (ir_vcg_getd s p))) (fun (j : Nat) => VcgStep.borrowf s rs j) (ir_vcg_bindex fs (ir_vcg_addr (ir_vcg_getd s p))))
  (fun (_ : IRTy) (_ : Nat) => VcgStep.pure s)
  (fun (_ : Nat) (_ : Nat) => VcgStep.pure s)
  (fun (_ : Nat) (_ : Nat) (_ : Nat) => VcgStep.pure s)
  i

def ir_vcg_fetch (m : IRModule) (s : VcgMach) : IROption IRNode := @IRList.rec VcgFrame (fun (_ : IRList VcgFrame) => IROption IRNode) (@IROption.none IRNode) (fun (f : VcgFrame) (_ : IRList VcgFrame) (_ : IROption IRNode) => @VcgFrame.rec (fun (_ : VcgFrame) => IROption IRNode) (fun (fn : Nat) (bl : Nat) (pc : Nat) (_ : IRList VcgBind) (_ : IROption (IRList Nat)) => @IROption.rec IRFunc (fun (_ : IROption IRFunc) => IROption IRNode) (@IROption.none IRNode) (fun (fu : IRFunc) => @IROption.rec IRBlock (fun (_ : IROption IRBlock) => IROption IRNode) (@IROption.none IRNode) (fun (b : IRBlock) => ir_nodes_get (ir_block_nodes b) pc) (ir_block_find (ir_func_blocks fu) bl)) (ir_func_find (ir_mod_funcs m) fn)) f) (ir_vcg_mframes s)

def ir_vcg_classify (m : IRModule) (stops : IRList Nat) (fs : IRList VcgFact) (s : VcgMach) : VcgStep := @IROption.rec IRNode (fun (_ : IROption IRNode) => VcgStep) (VcgStep.pure s) (fun (nd : IRNode) => @IRNode.rec (fun (_ : IRNode) => VcgStep) (fun (i : IRInst) (rs : IRList Nat) => ir_vcg_classify_inst stops fs s rs i) nd) (ir_vcg_fetch m s)

def ir_vcg_is_fin (st : VcgStep) : Bool := @VcgStep.rec (fun (_ : VcgStep) => Bool) (fun (_ : VcgMach) => Bool.false) (fun (_ : VcgMach) (_ : IRList Nat) (_ : IRTy) (_ : VcgNat) => Bool.false) (fun (_ : VcgMach) (_ : IRList Nat) (_ : VcgNat) => Bool.false) (fun (_ : VcgMach) (_ : IRList Nat) (_ : Nat) => Bool.false) (fun (_ : VcgMach) (_ : VcgNat) (_ : VcgVal) => Bool.false) (fun (_ : VcgMach) (_ : IRList VcgCell) (_ : VcgNat) (_ : IRList VcgVal) => Bool.true) (fun (_ : VcgMach) => Bool.true) st

def ir_vcg_cfg_mach (c : IRConfig) : IRMachine := @IRConfig.rec (fun (_ : IRConfig) => IRMachine) (fun (s : IRMachine) => s) (fun (_ : IROutcome) => IRMachine.mk (@IRList.nil IRFrame) (@IRList.nil IRMemSlot) Nat.zero) c

def ir_vcg_trace_c (m : IRModule) (stops : IRList Nat) (nv : Nat) (fs : IRList VcgFact) (fuel : Nat) (c0 : IRMachine) : IRList VcgStep := @Nat.rec (fun (_ : Nat) => IRMachine -> IRList VcgStep) (fun (_ : IRMachine) => @IRList.nil VcgStep) (fun (_ : Nat) (ih : IRMachine -> IRList VcgStep) => fun (c : IRMachine) => @Bool.rec (fun (_ : Bool) => IRList VcgStep) (@IRConfig.rec (fun (_ : IRConfig) => IRList VcgStep) (fun (c2 : IRMachine) => @IRList.cons VcgStep (ir_vcg_classify m stops fs (ir_vcg_rmach nv (ir_vcg_mlen (ir_vcg_fact_mem (ir_vcg_penv nv) fs)) c)) (ih c2)) (fun (_ : IROutcome) => @IRList.cons VcgStep (ir_vcg_classify m stops fs (ir_vcg_rmach nv (ir_vcg_mlen (ir_vcg_fact_mem (ir_vcg_penv nv) fs)) c)) (@IRList.nil VcgStep)) (ir_step m c)) (@IRList.cons VcgStep (ir_vcg_classify m stops fs (ir_vcg_rmach nv (ir_vcg_mlen (ir_vcg_fact_mem (ir_vcg_penv nv) fs)) c)) (@IRList.nil VcgStep)) (ir_vcg_is_fin (ir_vcg_classify m stops fs (ir_vcg_rmach nv (ir_vcg_mlen (ir_vcg_fact_mem (ir_vcg_penv nv) fs)) c)))) fuel c0

def ir_vcg_trace (m : IRModule) (stops : IRList Nat) (nv : Nat) (fs : IRList VcgFact) (s0 : VcgMach) (fuel : Nat) : IRList VcgStep := ir_vcg_trace_c m stops nv fs fuel (ir_vcg_place nv fs s0)
