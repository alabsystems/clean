(assume h1 (P x))
(assume h2 (not (P a)))
(anchor :step s :args ((:= (x U) a)))
(step s.t1 (cl (= (=> (= x a) (P x)) (=> (= a a) (P x)))) :rule refl)
(step s (cl (= (forall ((x U)) (=> (= x a) (P x))) (=> (= a a) (P x)))) :rule onepoint)
(step t2 (cl (not (= (forall ((x U)) (=> (= x a) (P x))) (=> (= a a) (P x)))) (forall ((x U)) (=> (= x a) (P x))) (not (=> (= a a) (P x)))) :rule equiv_pos1)
(step t3 (cl (forall ((x U)) (=> (= x a) (P x))) (not (=> (= a a) (P x)))) :rule resolution :premises (s t2))
(step t4 (cl (=> (= a a) (P x)) (not (P x))) :rule implies_neg2)
(step t5 (cl (=> (= a a) (P x))) :rule resolution :premises (t4 h1))
(step t6 (cl (forall ((x U)) (=> (= x a) (P x)))) :rule resolution :premises (t3 t5))
(step t7 (cl (or (not (forall ((x U)) (=> (= x a) (P x)))) (=> (= a a) (P a)))) :rule forall_inst :args (a))
(step t8 (cl (not (forall ((x U)) (=> (= x a) (P x)))) (=> (= a a) (P a))) :rule or :premises (t7))
(step t9 (cl (=> (= a a) (P a))) :rule resolution :premises (t8 t6))
(step t10 (cl (not (= a a)) (P a)) :rule implies :premises (t9))
(step t11 (cl (= a a)) :rule eq_reflexive)
(step t12 (cl) :rule resolution :premises (t10 t11 h2))
