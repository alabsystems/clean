def ir_vcg_env6s (x0 : Nat) (x1 : Nat) (x2 : Nat) (x3 : Nat) (x4 : Nat) (x5 : Nat) (w : IRScalar) : QE := QE.m (IRList.cons Nat x0 (IRList.cons Nat x1 (IRList.cons Nat x2 (IRList.cons Nat x3 (IRList.cons Nat x4 (IRList.cons Nat x5 (IRList.nil Nat))))))) (IRList.cons IRScalar w (IRList.nil IRScalar))

def vqi (n : Nat) : QV := QV.i (QN.l n)

def vqp (i : Nat) (k : Nat) : QV := QV.p (QN.v i k)

def vqb0 : IRList QB := IRList.nil QB


inductive QL : Type
| p : Nat -> QV -> QL -> QL
| q : IRList QB -> QL -> QL
| j : Nat -> IRList QB -> QL -> QL
| a : QC -> QN -> Nat -> QV -> QL -> QL
| l : Nat -> IRTy -> QN -> QV -> QL -> QL
| b : Nat -> QN -> QL -> QL
| f : Nat -> Nat -> QV -> QL -> QL
| s : QN -> QV -> QL -> QL
| c : Nat -> Nat -> IRList QB -> IRList Nat -> QL -> QL
| r : IRList QB -> QL -> QL
| x : IRList QV -> QL
| t : QL
| k : Nat -> QN -> QN -> Bool -> QL -> QL

def ir_vcg_bapp (bs : IRList QB) (loc : IRList QB) : IRList QB := IRList.rec QB (fun (_ : IRList QB) => IRList QB) loc (fun (b : QB) (_ : IRList QB) (ih : IRList QB) => IRList.cons QB b ih) bs

def ir_vcg_mframes (s : QM) : IRList QR := QM.rec (fun (_ : QM) => IRList QR) (fun (fs : IRList QR) (_ : IRList QC) (_ : QN) => fs) s

def ir_vcg_mna (s : QM) : QN := QM.rec (fun (_ : QM) => QN) (fun (_ : IRList QR) (_ : IRList QC) (na : QN) => na) s

def ir_vcg_ontop (g : QR -> QR) (fs : IRList QR) : IRList QR := IRList.rec QR (fun (_ : IRList QR) => IRList QR) (IRList.nil QR) (fun (f : QR) (rest : IRList QR) (_ : IRList QR) => IRList.cons QR (g f) rest) fs

def ir_vcg_fadv (bs : IRList QB) (f : QR) : QR := QR.rec (fun (_ : QR) => QR) (fun (fn : Nat) (bl : Nat) (pc : Nat) (loc : IRList QB) (ds : IROption (IRList Nat)) => QR.m fn bl (Nat.succ pc) (ir_vcg_bapp bs loc) ds) f

def ir_vcg_fjmp (b : Nat) (bs : IRList QB) (f : QR) : QR := QR.rec (fun (_ : QR) => QR) (fun (fn : Nat) (bl : Nat) (pc : Nat) (loc : IRList QB) (ds : IROption (IRList Nat)) => QR.m fn b Nat.zero (ir_vcg_bapp bs loc) ds) f

def ir_vcg_fbind (bs : IRList QB) (f : QR) : QR := QR.rec (fun (_ : QR) => QR) (fun (fn : Nat) (bl : Nat) (pc : Nat) (loc : IRList QB) (ds : IROption (IRList Nat)) => QR.m fn bl pc (ir_vcg_bapp bs loc) ds) f

