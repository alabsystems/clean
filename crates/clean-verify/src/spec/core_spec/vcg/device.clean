en env rest mem)) (ir_vcg_nden env a)) (@IROption.some IRMemSlot (ir_vcg_cden env c0))) (fun (_ : Eq Bool (ir_vcg_nbeq ca a) Bool.false) => ir_vcg_bcase (ir_vcg_distinct fs ca a) (fun (b2 : Bool) => Eq (IROption VcgCell) (@Bool.rec (fun (_ : Bool) => IROption VcgCell) (@IROption.none VcgCell) (ir_vcg_lookup fs rest a) b2) (@IROption.some VcgCell c0) -> Eq (IROption IRMemSlot) (ir_mem_lookup (@IRList.cons IRMemSlot (ir_vcg_cden env (VcgCell.mk ca cv clv)) (ir_vcg_memden env rest mem)) (ir_vcg_nden env a)) (@IROption.some IRMemSlot (ir_vcg_cden env c0))) (fun (_ : Eq Bool (ir_vcg_distinct fs ca a) Bool.false) (hn : Eq (IROption VcgCell) (@IROption.none VcgCell) (@IROption.some VcgCell c0)) => ir_vcg_none_some VcgCell c0 hn (Eq (IROption IRMemSlot) (ir_mem_lookup (@IRList.cons IRMemSlot (ir_vcg_cden env (VcgCell.mk ca cv clv)) (ir_vcg_memden env rest mem)) (ir_vcg_nden env a)) (@IROption.some IRMemSlot (ir_vcg_cden env c0)))) (fun (hd : Eq Bool (ir_vcg_distinct fs ca a) Bool.true) (hl : Eq (IROption VcgCell) (ir_vcg_lookup fs rest a) (@IROption.some VcgCell c0)) => Eq.subst Bool (fun (b3 : Bool) => Eq (IROption IRMemSlot) (@Bool.rec (fun (_ : Bool) => IROption IRMemSlot) (ir_mem_lookup (ir_vcg_memden env rest mem) (ir_vcg_nden env a)) (@IROption.some IRMemSlot (IRMemSlot.mk (ir_vcg_nden env ca) (ir_vcg_vden env cv) clv)) b3) (@IROption.some IRMemSlot (ir_vcg_cden env c0))) Bool.false (ir_nat_eqb (ir_vcg_nden env ca) (ir_vcg_nden env a)) (Eq.symm Bool (ir_nat_eqb (ir_vcg_nden env ca) (ir_vcg_nden env a)) Bool.false (ir_vcg_distinct_sound env mem fs hf ca a hd)) (ih c0 hl))) (fun (hb : Eq Bool (ir_vcg_nbeq ca a) Bool.true) (hl : Eq (IROption VcgCell) (@IROption.some VcgCell (VcgCell.mk ca cv clv)) (@IROption.some VcgCell c0)) => Eq.subst VcgCell (fun (c1 : VcgCell) => Eq (IROption IRMemSlot) (ir_mem_lookup (@IRList.cons IRMemSlot (ir_vcg_cden env (VcgCell.mk ca cv clv)) (ir_vcg_memden env rest mem)) (ir_vcg_nden env a)) (@IROption.some IRMemSlot (ir_vcg_cden env c1))) (V