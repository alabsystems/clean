def ir_vcg_cmp_ok (env : QE) (mem : IRList IRMemSlot) (fs : IRList QF) (hf : ir_vcg_facts_hold env mem fs) (x : QN) (y : QN) (K1 : IRConfig) (KR : Bool -> IRConfig) (tg : IRConfig) (K0 : IRConfig) (hK : Eq IRConfig K0 K1) (h1 : Eq IRConfig (ir_vcg_oL Bool (ir_vcg_cmpd fs x y) (fun (_ : Bool) => K1)) (ir_vcg_oR Bool (ir_vcg_cmpd fs x y) (fun (_ : Bool) => KR (ir_nat_eqb (ir_vcg_nden env x) (ir_vcg_nden env y))))) (h2 : Eq IRConfig (ir_vcg_oL Bool (ir_vcg_cmpd fs x y) (fun (b : Bool) => KR b)) (ir_vcg_oR Bool (ir_vcg_cmpd fs x y) (fun (_ : Bool) => tg))) : Eq IRConfig K0 tg := Eq.trans IRConfig K0 K1 tg hK (ir_vcg_ocase Bool (ir_vcg_cmpd fs x y) (fun (o : IROption Bool) => Eq IRConfig (ir_vcg_oL Bool o (fun (_ : Bool) => K1)) (ir_vcg_oR Bool o (fun (_ : Bool) => KR (ir_nat_eqb (ir_vcg_nden env x) (ir_vcg_nden env y)))) -> Eq IRConfig (ir_vcg_oL Bool o (fun (b : Bool) => KR b)) (ir_vcg_oR Bool o (fun (_ : Bool) => tg)) -> Eq IRConfig K1 tg) (fun (_ : Eq (IROption Bool) (ir_vcg_cmpd fs x y) (IROption.none Bool)) (h1n : Eq IRConfig (IRConfig.halted IROutcome.fuel_out) (IRConfig.halted (IROutcome.stuck IRFault.no_frame))) (_ : Eq IRConfig (IRConfig.halted IROutcome.fuel_out) (IRConfig.halted (IROutcome.stuck IRFault.no_frame))) => ir_vcg_cfg_ne h1n (Eq IRConfig K1 tg)) (fun (b : Bool) (hl : Eq (IROption Bool) (ir_vcg_cmpd fs x y) (IROption.some Bool b)) (h1s : Eq IRConfig K1 (KR (ir_nat_eqb (ir_vcg_nden env x) (ir_vcg_nden env y)))) (h2s : Eq IRConfig (KR b) tg) => Eq.trans IRConfig K1 (KR (ir_nat_eqb (ir_vcg_nden env x) (ir_vcg_nden env y))) tg h1s (Eq.trans IRConfig (KR (ir_nat_eqb (ir_vcg_nden env x) (ir_vcg_nden env y))) (KR b) tg (ir_eq_cong Bool IRConfig KR (ir_nat_eqb (ir_vcg_nden env x) (ir_vcg_nden env y)) b (ir_vcg_cmpd_sound env mem fs hf x y b hl)) h2s)) h1 h2)

def ir_vcg_store_ok (env : QE) (mem : IRList IRMemSlot) (fs : IRList QF) (hf : ir_vcg_facts_hold env mem fs) (fresh : IRList QC) (a : QN) (v : QV) (K1 : IRConfig) (KS : IROption IRMemSlot -> IRList IRMemSlot -> IRConfig) (tg : IRConfig) (K0 : IRConfig) (hK : Eq IRConfig K0 K1) (h1 : Eq IRConfig (ir_vcg_oL QC (ir_vcg_lookup fs fresh a) (fun (_ : QC) => ir_vcg_oL (IRList QC) (ir_vcg_update fs fresh a v) (fun (_ : IRList QC) => K1))) (ir_vcg_oR QC (ir_vcg_lookup fs fresh a) (fun (_ : QC) => ir_vcg_oR (IRList QC) (ir_vcg_update fs fresh a v) (fun (_ : IRList QC) => KS (ir_mem_lookup (ir_vcg_memden env fresh mem) (ir_vcg_nden env a)) (ir_mem_update (ir_vcg_memden env fresh mem) (ir_vcg_nden env a) (ir_vcg_vden env v)))))) (h2 : Eq IRConfig (ir_vcg_oL QC (ir_vcg_lookup fs fresh a) (fun (c : QC) => ir_vcg_oL (IRList QC) (ir_vcg_update fs fresh a v) (fun (fr2 : IRList QC) => KS (IROption.some IRMemSlot (ir_vcg_cden env c)) (ir_vcg_memden env fr2 mem)))) (ir_vcg_oR QC (ir_vcg_lookup fs fresh a) (fun (_ : QC) => ir_vcg_oR (IRList QC) (ir_vcg_update fs fresh a v) (fun (_ : IRList QC) => tg)))) : Eq IRConfig K0 tg :=
  Eq.trans IRConfig K0 K1 tg hK (ir_vcg_ocase QC (ir_vcg_lookup fs fresh a)
    (fun (o : IROption QC) => Eq IRConfig (ir_vcg_oL QC o (fun (_ : QC) => ir_vcg_oL (IRList QC) (ir_vcg_update fs fresh a v) (fun (_ : IRList QC) => K1))) (ir_vcg_oR QC o (fun (_ : QC) => ir_vcg_oR (IRList QC) (ir_vcg_update fs fresh a v) (fun (_ : IRList QC) => KS (ir_mem_lookup (ir_vcg_memden env fresh mem) (ir_vcg_nden env a)) (ir_mem_update (ir_vcg_memden env fresh mem) (ir_vcg_nden env a) (ir_vcg_vden env v))))) -> Eq IRConfig (ir_vcg_oL QC o (fun (c : QC) => ir_vcg_oL (IRList QC) (ir_vcg_update fs fresh a v) (fun (fr2 : IRList QC) => KS (IROption.some IRMemSlot (ir_vcg_cden env c)) (ir_vcg_memden env fr2 mem)))) (ir_vcg_oR QC o (fun (_ : QC) => ir_vcg_oR (IRList QC) (ir_vcg_update fs fresh a v) (fun (_ : IRList QC) => tg))) -> Eq IRConfig K1 tg)
    (fun (_ : Eq (IROption QC) (ir_vcg_lookup fs fresh a) (IROption.none QC)) (h1n : Eq IRConfig (IRConfig.halted IROutcome.fuel_out) (IRConfig.halted (IROutcome.stuck IRFault.no_frame))) (_ : Eq IRConfig (IRConfig.halted IROutcome.fuel_out) (IRConfig.halted (IROutcome.stuck IRFault.no_frame))) => ir_vcg_cfg_ne h1n (Eq IRConfig K1 tg))
    (fun (c : QC) (hl : Eq (IROption QC) (ir_vcg_lookup fs fresh a) (IROption.some QC c)) =>
