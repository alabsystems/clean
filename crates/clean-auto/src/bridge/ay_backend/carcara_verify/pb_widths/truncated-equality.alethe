(assume a (not (= #b00 #b10)))
(step c0 (cl (= #b00 (@pbbterm 0 0))) :rule pbblast_pbbconst)
(step c2 (cl (= #b10 (@pbbterm 0 1))) :rule pbblast_pbbconst)
(step convert (cl (= (= #b00 #b10) (= (@pbbterm 0 0) (@pbbterm 0 1)))) :rule cong :premises (c0 c2))
(step bad (cl (= (= (@pbbterm 0 0) (@pbbterm 0 1)) (= (- 0 0) 0))) :rule pbblast_bveq)
(step eval (cl (= (= (- 0 0) 0) true)) :rule evaluate)
(step joined (cl (= (= #b00 #b10) true)) :rule trans :premises (convert bad eval))
(step simpl (cl (= (= (= #b00 #b10) true) (= #b00 #b10))) :rule equiv_simplify)
(step imp (cl (not (= (= #b00 #b10) true)) (= #b00 #b10)) :rule equiv1 :premises (simpl))
(step impossible (cl (= #b00 #b10)) :rule resolution :premises (joined imp))
(step done (cl) :rule resolution :premises (a impossible))
