set_option maxHeartbeats 1600000

/-! ## 0. Generic reusable bridges (over ℝ; the genuine values are real). -/

/-- Per-term two-sided IBP: `w·x` between the two corner products. -/
theorem term_boundR (w xlo xhi x : ℝ) (hl : xlo ≤ x) (hh : x ≤ xhi) :
    min (w*xlo) (w*xhi) ≤ w * x ∧ w * x ≤ max (w*xlo) (w*xhi) := by
  constructor
  · rcases le_or_gt 0 w with hw | hw
    · exact le_trans (min_le_left _ _) (by nlinarith)
    · exact le_trans (min_le_right _ _) (by nlinarith)
  · rcases le_or_gt 0 w with hw | hw
    · exact le_trans (by nlinarith) (le_max_right _ _)
    · exact le_trans (by nlinarith) (le_max_left _ _)

/-- **Generic dense-layer IBP** (no per-index split): `Σ_j w_j x_j` between the
    sums of per-term min/max corners — a sound bound on the REAL dense layer. -/
theorem dot_ibpR {n : ℕ} (w xlo xhi x : Fin n → ℝ)
    (hl : ∀ j, xlo j ≤ x j) (hh : ∀ j, x j ≤ xhi j) :
    (∑ j, min (w j * xlo j) (w j * xhi j)) ≤ (∑ j, w j * x j)
    ∧ (∑ j, w j * x j) ≤ (∑ j, max (w j * xlo j) (w j * xhi j)) :=
  ⟨Finset.sum_le_sum (fun j _ => (term_boundR (w j) (xlo j) (xhi j) (x j) (hl j) (hh j)).1),
   Finset.sum_le_sum (fun j _ => (term_boundR (w j) (xlo j) (xhi j) (x j) (hl j) (hh j)).2)⟩

/-- Real ReLU. -/
noncomputable def reluR (z : ℝ) : ℝ := max 0 z

/-- **ReLU interval map** (ReLU is monotone). -/
theorem reluR_box (lo hi z : ℝ) (hl : lo ≤ z) (hh : z ≤ hi) :
    max 0 lo ≤ reluR z ∧ reluR z ≤ max 0 hi := by
  unfold reluR; exact ⟨max_le_max (le_refl 0) hl, max_le_max (le_refl 0) hh⟩

/-- **rsqrt rational enclosure.**  `gl ≤ 1/√(v+eps) ≤ gh` from
    `gl^2(v+eps) ≤ 1 ≤ gh^2(v+eps)`, `gl,gh>0`, `v+eps>0`.  The BatchNorm
    normalizer bounded through the REAL `Real.sqrt`. -/
theorem rsqrt_enclose (v eps gl gh : ℝ) (hpos : 0 < v + eps) (hgl : 0 < gl)
    (hgh : 0 < gh) (hlo : gl^2 * (v+eps) ≤ 1) (hhi : 1 ≤ gh^2 * (v+eps)) :
    gl ≤ rsqrt eps v ∧ rsqrt eps v ≤ gh := by
  have hs : 0 < Real.sqrt (v + eps) := Real.sqrt_pos.mpr hpos
  have hsq : Real.sqrt (v + eps) ^ 2 = v + eps := Real.sq_sqrt (le_of_lt hpos)
  unfold rsqrt
  refine ⟨?_, ?_⟩
  · rw [le_div_iff₀ hs]; nlinarith [hlo, hsq, hs, hgl, mul_pos hgl hs]
  · rw [div_le_iff₀ hs]; nlinarith [hhi, hsq, hs, hgh, mul_pos hgh hs]

/-- **2-interval product (McCormick exact corners).**  `a·b` within the 4-corner
    min/max, by composing two `term_boundR`s. -/
theorem prod_interval_R (a b al ah bl bh : ℝ)
    (hal : al ≤ a) (hah : a ≤ ah) (hbl : bl ≤ b) (hbh : b ≤ bh) :
    min (min (al*bl) (al*bh)) (min (ah*bl) (ah*bh)) ≤ a*b ∧
    a*b ≤ max (max (al*bl) (al*bh)) (max (ah*bl) (ah*bh)) := by
  obtain ⟨l0, u0⟩ := term_boundR b al ah a hal hah
  obtain ⟨l1, u1⟩ := term_boundR al bl bh b hbl hbh
  obtain ⟨l2, u2⟩ := term_boundR ah bl bh b hbl hbh
  rw [mul_comm a b]
  refine ⟨le_trans ?_ l0, le_trans u0 ?_⟩
  · rw [mul_comm b al, mul_comm b ah]
    exact le_min (le_trans (min_le_left _ _) l1) (le_trans (min_le_right _ _) l2)
  · rw [mul_comm b al, mul_comm b ah]
    exact max_le (le_trans u1 (le_max_left _ _)) (le_trans u2 (le_max_right _ _))

/-- **BN channel box.**  `n = bias + weight·(1/√(var+eps))·(x-mean)`, bounded in
    `[nlo,nhi]`: inner product `rsqrt·(x-mean)` (`prod_interval_R` over the rsqrt
    enclosure and centred input), then outer `weight·(·)` (`term_boundR`). -/
theorem bn_channel_box (weight eps var glo ghi mean bias xlo xhi nlo nhi : ℝ) (x : ℝ)
    (hpos : 0 < var + eps) (hglo : 0 < glo) (hghi : 0 < ghi)
    (hrl : glo^2 * (var+eps) ≤ 1) (hrh : 1 ≤ ghi^2 * (var+eps))
    (hxl : xlo ≤ x) (hxh : x ≤ xhi)
    (hlo : nlo ≤ bias + min (weight * min (min (glo*(xlo-mean)) (glo*(xhi-mean))) (min (ghi*(xlo-mean)) (ghi*(xhi-mean))))
                          (weight * max (max (glo*(xlo-mean)) (glo*(xhi-mean))) (max (ghi*(xlo-mean)) (ghi*(xhi-mean)))))
    (hhi : bias + max (weight * min (min (glo*(xlo-mean)) (glo*(xhi-mean))) (min (ghi*(xlo-mean)) (ghi*(xhi-mean))))
                     (weight * max (max (glo*(xlo-mean)) (glo*(xhi-mean))) (max (ghi*(xlo-mean)) (ghi*(xhi-mean)))) ≤ nhi) :
    nlo ≤ bias + weight * (rsqrt eps var * (x - mean)) ∧
    bias + weight * (rsqrt eps var * (x - mean)) ≤ nhi := by
  obtain ⟨hgl, hgh⟩ := rsqrt_enclose var eps glo ghi hpos hglo hghi hrl hrh
  obtain ⟨il, ih⟩ := prod_interval_R (rsqrt eps var) (x-mean) glo ghi (xlo-mean) (xhi-mean)
    hgl hgh (by linarith) (by linarith)
  set inner := rsqrt eps var * (x - mean)
  set IL := min (min (glo*(xlo-mean)) (glo*(xhi-mean))) (min (ghi*(xlo-mean)) (ghi*(xhi-mean)))
  set IH := max (max (glo*(xlo-mean)) (glo*(xhi-mean))) (max (ghi*(xlo-mean)) (ghi*(xhi-mean)))
  obtain ⟨ol, ou⟩ := term_boundR weight IL IH inner il ih
  exact ⟨by linarith [hlo, ol], by linarith [hhi, ou]⟩

