(assume h0 (not (str.in_re (str.substr y 0 L) (re.* (str.to_re "a")))))
(assume nc (not (and (not (= (str.substr y 0 L) "")) (forall ((L Int)) (or (<= L 0) (< (str.len (str.substr y 0 L)) L) (not (str.in_re (str.substr (str.substr y 0 L) 0 L) (str.to_re "a"))) (not (str.in_re (str.substr (str.substr y 0 L) L (- (str.len (str.substr y 0 L)) L)) (re.* (str.to_re "a")))))))))
(step s (cl (and (not (= (str.substr y 0 L) "")) (forall ((L Int)) (or (<= L 0) (< (str.len (str.substr y 0 L)) L) (not (str.in_re (str.substr (str.substr y 0 L) 0 L) (str.to_re "a"))) (not (str.in_re (str.substr (str.substr y 0 L) L (- (str.len (str.substr y 0 L)) L)) (re.* (str.to_re "a")))))))) :rule re_unfold_neg :premises (h0))
(step done (cl) :rule resolution :premises (nc s))
