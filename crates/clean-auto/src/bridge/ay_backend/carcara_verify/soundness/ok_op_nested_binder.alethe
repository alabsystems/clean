(assume h1 (P a))
(assume h2 (not (forall ((x U)) (=> (and (= x a) (exists ((w U)) (Q w))) (P x)))))
(assume h3 (exists ((w U)) (Q w)))
(anchor :step s :args ((:= (x U) a)))
(step s.t1 (cl (= (=> (and (= x a) (exists ((w U)) (Q w))) (P x)) (=> (and (= a a) (exists ((w U)) (Q w))) (P a)))) :rule refl)
(step s (cl (= (forall ((x U)) (=> (and (= x a) (exists ((w U)) (Q w))) (P x))) (=> (and (= a a) (exists ((w U)) (Q w))) (P a)))) :rule onepoint)
(step t2 (cl (not (= (forall ((x U)) (=> (and (= x a) (exists ((w U)) (Q w))) (P x))) (=> (and (= a a) (exists ((w U)) (Q w))) (P a)))) (forall ((x U)) (=> (and (= x a) (exists ((w U)) (Q w))) (P x))) (not (=> (and (= a a) (exists ((w U)) (Q w))) (P a)))) :rule equiv_pos1)
(step t3 (cl (=> (and (= a a) (exists ((w U)) (Q w))) (P a)) (not (P a))) :rule implies_neg2)
(step t4 (cl) :rule resolution :premises (s t2 t3 h1 h2))
