(assume h1 (= x ((_ sign_extend 4) #b1011)))
(assume h2 (= x #b11111011))
(step e1 (cl (= ((_ sign_extend 4) #b1011) #b00000101)) :rule evaluate)
(step t1 (cl (= x #b00000101)) :rule trans :premises (h1 e1))
(step s2 (cl (= #b11111011 x)) :rule symm :premises (h2))
(step t2 (cl (= #b11111011 #b00000101)) :rule trans :premises (s2 t1))
(step ev (cl (= (= #b11111011 #b00000101) false)) :rule evaluate)
(step q1 (cl (not (= #b11111011 #b00000101)) false) :rule equiv1 :premises (ev))
(step q2 (cl (not false)) :rule false)
(step done (cl) :rule resolution :premises (t2 q1 q2))
