        (fun (u : IROption (IRList QC)) => Eq IRConfig (ir_vcg_oL (IRList QC) u (fun (_ : IRList QC) => K1)) (ir_vcg_oR (IRList QC) u (fun (_ : IRList QC) => KS (ir_mem_lookup (ir_vcg_memden env fresh mem) (ir_vcg_nden env a)) (ir_mem_update (ir_vcg_memden env fresh mem) (ir_vcg_nden env a) (ir_vcg_vden env v)))) -> Eq IRConfig (ir_vcg_oL (IRList QC) u (fun (fr2 : IRList QC) => KS (IROption.some IRMemSlot (ir_vcg_cden env c)) (ir_vcg_memden env fr2 mem))) (ir_vcg_oR (IRList QC) u (fun (_ : IRList QC) => tg)) -> Eq IRConfig K1 tg)
        (fun (_ : Eq (IROption (IRList QC)) (ir_vcg_update fs fresh a v) (IROption.none (IRList QC))) (h1n : Eq IRConfig (IRConfig.halted IROutcome.fuel_out) (IRConfig.halted (IROutcome.stuck IRFault.no_frame))) (_ : Eq IRConfig (IRConfig.halted IROutcome.fuel_out) (IRConfig.halted (IROutcome.stuck IRFault.no_frame))) => ir_vcg_cfg_ne h1n (Eq IRConfig K1 tg))
        (fun (fr2 : IRList QC) (hu : Eq (IROption (IRList QC)) (ir_vcg_update fs fresh a v) (IROption.some (IRList QC) fr2)) (h1s : Eq IRConfig K1 (KS (ir_mem_lookup (ir_vcg_memden env fresh mem) (ir_vcg_nden env a)) (ir_mem_update (ir_vcg_memden env fresh mem) (ir_vcg_nden env a) (ir_vcg_vden env v)))) (h2s : Eq IRConfig (KS (IROption.some IRMemSlot (ir_vcg_cden env c)) (ir_vcg_memden env fr2 mem)) tg) =>
