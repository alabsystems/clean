(assume h1 (= x b))
(assume h2 (P b))
(assume h3 (not (P a)))
(anchor :step s :args ((z U) (:= (x U) z)))
(step s.t1 (cl (= (P x) (P b))) :rule cong :premises (h1))
(step s (cl (= (forall ((x U)) (P x)) (forall ((z U)) (P b)))) :rule bind)
(step t2 (cl (= (forall ((z U)) (P b)) (P b))) :rule qnt_rm_unused)
(step t3 (cl (= (forall ((x U)) (P x)) (P b))) :rule trans :premises (s t2))
(step t4 (cl (not (= (forall ((x U)) (P x)) (P b))) (forall ((x U)) (P x)) (not (P b))) :rule equiv_pos1)
(step t5 (cl (forall ((x U)) (P x))) :rule resolution :premises (t3 t4 h2))
(step t6 (cl (or (not (forall ((x U)) (P x))) (P a))) :rule forall_inst :args (a))
(step t7 (cl (not (forall ((x U)) (P x))) (P a)) :rule or :premises (t6))
(step t8 (cl) :rule resolution :premises (t7 t5 h3))
