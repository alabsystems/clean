/-- ReLU is monotone: a <= b -> relu a <= relu b. -/
private theorem relu_mono_579_689 {a b : ℚ} (h : a ≤ b) : relu a ≤ relu b := by
  unfold relu
  exact max_le_max (le_refl 0) h

