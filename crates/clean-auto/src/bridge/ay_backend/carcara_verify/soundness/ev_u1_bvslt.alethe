(assume h1 (= x (bvslt #b1111 #b0001)))
(assume h2 (= x true))
(step e1 (cl (= (bvslt #b1111 #b0001) false)) :rule evaluate)
(step t1 (cl (= x false)) :rule trans :premises (h1 e1))
(step s2 (cl (= true x)) :rule symm :premises (h2))
(step t2 (cl (= true false)) :rule trans :premises (s2 t1))
(step ev (cl (= (= true false) false)) :rule evaluate)
(step q1 (cl (not (= true false)) false) :rule equiv1 :premises (ev))
(step q2 (cl (not false)) :rule false)
(step done (cl) :rule resolution :premises (t2 q1 q2))
