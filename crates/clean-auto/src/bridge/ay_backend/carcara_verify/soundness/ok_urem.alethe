(step e5 (cl (= (@bbterm (ite (and (= true false) (= false false)) true (ite (not (or (and false (not false)) (and (xor false (not false)) (or (and true (not true)) (and (xor true (not true)) true))))) true (ite (not (or (and (xor (xor false false) (or (and false false) (and (xor false false) (ite (= true true) true false)))) (not false)) (and (xor (xor (xor false false) (or (and false false) (and (xor false false) (ite (= true true) true false)))) (not false)) (or (and (xor (xor false false) (ite (= true true) true false)) (not true)) (and (xor (xor (xor false false) (ite (= true true) true false)) (not true)) true))))) (xor (xor false false) (ite (= true true) true false)) (xor (xor (xor (xor false false) (ite (= true true) true false)) (not true)) true)))) (ite (and (= true false) (= false false)) false (ite (not (or (and false (not false)) (and (xor false (not false)) (or (and true (not true)) (and (xor true (not true)) true))))) false (ite (not (or (and (xor (xor false false) (or (and false false) (and (xor false false) (ite (= true true) true false)))) (not false)) (and (xor (xor (xor false false) (or (and false false) (and (xor false false) (ite (= true true) true false)))) (not false)) (or (and (xor (xor false false) (ite (= true true) true false)) (not true)) (and (xor (xor (xor false false) (ite (= true true) true false)) (not true)) true))))) (xor (xor false false) (or (and false false) (and (xor false false) (ite (= true true) true false)))) (xor (xor (xor (xor false false) (or (and false false) (and (xor false false) (ite (= true true) true false)))) (not false)) (or (and (xor (xor false false) (ite (= true true) true false)) (not true)) (and (xor (xor (xor false false) (ite (= true true) true false)) (not true)) true))))))) #b00)) :rule evaluate)
