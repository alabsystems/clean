data/raw/

# Mathverse Library shards are released as GitHub Release assets, not tracked.
# Build locally with: cargo run -p clean-mathverse --release --bin mathverse_convert -- all <out>
data/mathverse-library/
data/mathverse-shards/*.mathverse
data/mathverse-shards/base/
# Large generated mathverse session artifacts (kept on disk, not tracked)
data/mathverse-lib-session/

# Graduation storage refactor (designs/2026-06-24-graduation-storage-and-distribution.md):
# the heavy graduation artifacts are NOT tracked in git — they live in the
# gitignored content-addressed store (_mathverse-artifacts/graduations/) and are
# pinned by blake3 from the COMPACT record. Git tracks only the lean, reviewable
# layer per graduation: the compact *.record.json, the *.math-project.json
# manifest, and proof/** sources. Enforced by the fail-closed test
# `no_graduation_mathverse_tracked` (crates/clean-mathverse/tests/).
#   NOT tracked — relocated to the artifact store, never destroyed:
data/graduation/**/*.mathverse
data/graduation/**/*.graduation.json
# The binary shard's declarations sidecar (`*.mathverse.json`) is Layer-2
# content too — it travels with the shard in the store, not in git.
data/graduation/**/*.mathverse.json

# Metamath import sources (.mm) and produced shards — fetched/built locally,
# not tracked (see docs/METAMATH_IMPORT_2026-06-21.md to reproduce).
data/metamath/
# Scratch/working artifacts (adversarial fixtures, ad-hoc outputs).
work/

# Legacy pre-rebrand shard outputs (clean-omega → clean-mathverse, 2026-05-30).
# `.omega` files use the same GEMO binary format as `.mathverse` and are
# byte-identical (matching blake3) to released shards — never tracked. The
# 355MB isabelle_thy.omega also exceeds GitHub's 100MB file limit. Safe to delete.
data/omega-library/
data/omega-shards/

# macOS Spotlight/QuickLook temp files (.!N!path)
.!*

# Runtime diagnostic artifacts in reports/ subdirs (logs, not source)
reports/tc_diagnostic/

# Lean / Lake build artifacts
.lake/
lakefile.olean

# Live agent worktrees (local-only) and agent CLI scratch
.claude/worktrees/
.antigravitycli/
reports/trust-check-ledger-clean-kernel-2026-06-10.json

# Downloaded math corpora (large; not committed)
data/corpora/

# Vendored crate sources (~583MB; released as vendor-sources-v*.tar.zst, NOT
# committed — mirrors the .mathverse shard convention). Regenerate with
# `cargo vendor --versioned-dirs vendor/`; see docs/SUPPLY_CHAIN_VENDORING.md.
/vendor/
/.cargo/vendor.toml
# Packaged release artifacts (vendor-sources-v*.tar.zst etc.) — published to
# GitHub releases, never committed.
/dist/
queries-*.smt2

# Publication engine scratch output (never part of a source snapshot).
/publish/.out/

