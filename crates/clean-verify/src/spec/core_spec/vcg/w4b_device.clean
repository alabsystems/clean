-- Link 4 W4 (CrystalVC M0, the second falsifier): the obligation-checked symbolic-execution device over EvalIR. Its soundness theorems are ir_vcg_run_sound and ir_vcg_check_sound; section 5, the engine, is untrusted and only ever checked. Record: reports/crystal-lane/2026-09-30-link4-m0/w4/README.md.

-- == 1. VALUES: symbolic Nats, environments, symbolic scalars and their denotations; Church-and and Bool/Option helpers ==

inductive QN : Type
| l : Nat -> QN
| v : Nat -> Nat -> QN

def ir_vcg_nth (l : IRList Nat) (i : Nat) : Nat := IRList.rec Nat (fun (_ : IRList Nat) => Nat -> Nat) (fun (_ : Nat) => Nat.zero) (fun (x : Nat) (_ : IRList Nat) (ih : Nat -> Nat) => fun (j : Nat) => Nat.rec (fun (_ : Nat) => Nat) x (fun (jp : Nat) (_ : Nat) => ih jp) j) l i

inductive QE : Type
| m : IRList Nat -> IRList IRScalar -> QE

def ir_vcg_ens (env : QE) : IRList Nat := QE.rec (fun (_ : QE) => IRList Nat) (fun (ns : IRList Nat) (_ : IRList IRScalar) => ns) env

def ir_vcg_ess (env : QE) : IRList IRScalar := QE.rec (fun (_ : QE) => IRList IRScalar) (fun (_ : IRList Nat) (ss : IRList IRScalar) => ss) env

def ir_vcg_snth (l : IRList IRScalar) (i : Nat) : IRScalar := IRList.rec IRScalar (fun (_ : IRList IRScalar) => Nat -> IRScalar) (fun (_ : Nat) => IRScalar.undef_) (fun (x : IRScalar) (_ : IRList IRScalar) (ih : Nat -> IRScalar) => fun (j : Nat) => Nat.rec (fun (_ : Nat) => IRScalar) x (fun (jp : Nat) (_ : IRScalar) => ih jp) j) l i

def ir_vcg_nden (env : QE) (n : QN) : Nat := QN.rec (fun (_ : QN) => Nat) (fun (k : Nat) => k) (fun (i : Nat) (k : Nat) => Nat.add (ir_vcg_nth (ir_vcg_ens env) i) k) n

inductive QV : Type
| u : QV
| b : Bool -> QV
| i : QN -> QV
| f : Nat -> QV
| n : QV
| p : QN -> QV
| z : QV
| t : QN -> QN -> QV
| g : Nat -> QV
| a : QV -> QV
| e : QV
| c : QV -> QV -> QV
| o : Nat -> QV

def ir_vcg_vden (env : QE) (v : QV) : IRScalar := QV.rec (fun (_ : QV) => IRScalar) IRScalar.undef_ (fun (b : Bool) => IRScalar.bool_ b) (fun (n : QN) => IRScalar.int_ (ir_vcg_nden env n)) (fun (n : Nat) => IRScalar.float_ n) IRScalar.unit_ (fun (a : QN) => IRScalar.ptr_ (ir_vcg_nden env a)) IRScalar.nullptr_ (fun (d : QN) (md : QN) => IRScalar.fat_ (ir_vcg_nden env d) (ir_vcg_nden env md)) (fun (f : Nat) => IRScalar.fnptr_ f) (fun (_ : QV) (ih : IRScalar) => IRScalar.aggv ih) IRScalar.vnil (fun (_ : QV) (_ : QV) (ihx : IRScalar) (ihr : IRScalar) => IRScalar.vcons ihx ihr) (fun (i : Nat) => ir_vcg_snth (ir_vcg_ess env) i) v

def ir_vcg_vlden (env : QE) (l : IRList QV) : IRList IRScalar := IRList.rec QV (fun (_ : IRList QV) => IRList IRScalar) (IRList.nil IRScalar) (fun (v : QV) (_ : IRList QV) (ih : IRList IRScalar) => IRList.cons IRScalar (ir_vcg_vden env v) ih) l

def ir_vcg_and (A : Prop) (B : Prop) : Prop := forall (C : Prop), (A -> B -> C) -> C

def ir_vcg_and_intro (A : Prop) (B : Prop) (a : A) (b : B) : ir_vcg_and A B := fun (C : Prop) (k : A -> B -> C) => k a b

def ir_vcg_and_fst (A : Prop) (B : Prop) (h : ir_vcg_and A B) : A := h A (fun (x : A) (_ : B) => x)

def ir_vcg_and_snd (A : Prop) (B : Prop) (h : ir_vcg_and A B) : B := h B (fun (_ : A) (y : B) => y)

def ir_vcg_band_l (a : Bool) (b : Bool) (h : Eq Bool (Bool.and a b) Bool.true) : Eq Bool a Bool.true := Bool.rec (fun (x : Bool) => Eq Bool (Bool.and x b) Bool.true -> Eq Bool x Bool.true) (fun (hf : Eq Bool Bool.false Bool.true) => hf) (fun (_ : Eq Bool b Bool.true) => Eq.refl Bool Bool.true) a h

def ir_vcg_band_r (a : Bool) (b : Bool) (h : Eq Bool (Bool.and a b) Bool.true) : Eq Bool b Bool.true := Bool.rec (fun (x : Bool) => Eq Bool (Bool.and x b) Bool.true -> Eq Bool b Bool.true) (fun (hf : Eq Bool Bool.false Bool.true) => ir_bool_false_ne_true (Eq Bool b Bool.true) hf) (fun (ht : Eq Bool b Bool.true) => ht) a h

def ir_vcg_bor_elim (a : Bool) (b : Bool) (h : Eq Bool (Bool.or a b) Bool.true) (C : Prop) (ha : Eq Bool a Bool.true -> C) (hb : Eq Bool b Bool.true -> C) : C := Bool.rec (fun (x : Bool) => Eq Bool (Bool.or x b) Bool.true -> (Eq Bool x Bool.true -> C) -> C) (fun (h0 : Eq Bool b Bool.true) (_ : Eq Bool Bool.false Bool.true -> C) => hb h0) (fun (_ : Eq Bool Bool.true Bool.true) (k : Eq Bool Bool.true Bool.true -> C) => k (Eq.refl Bool Bool.true)) a h ha

def ir_vcg_bcase (b : Bool) (P : Bool -> Prop) (hf : Eq Bool b Bool.false -> P Bool.false) (ht : Eq Bool b Bool.true -> P Bool.true) : P b := Bool.rec (fun (x : Bool) => Eq Bool b x -> P x) hf ht b (Eq.refl Bool b)

def ir_vcg_some_inj (A : Type) (x : A) (y : A) (h : Eq (IROption A) (IROption.some A x) (IROption.some A y)) : Eq A x y := Eq.subst (IROption A) (fun (o : IROption A) => Eq A x (IROption.rec A (fun (_ : IROption A) => A) x (fun (z : A) => z) o)) (IROption.some A x) (IROption.some A y) h (Eq.refl A x)

def ir_vcg_none_some (A : Type) (y : A) (h : Eq (IROption A) (IROption.none A) (IROption.some A y)) (C : Prop) : C := Eq.subst (IROption A) (fun (o : IROption A) => IROption.rec A (fun (_ : IROption A) => Prop) (Eq Bool Bool.true Bool.true) (fun (_ : A) => C) o) (IROption.none A) (IROption.some A y) h (Eq.refl Bool Bool.true)

def ir_vcg_ocase (A : Type) (o : IROption A) (P : IROption A -> Prop) (hn : Eq (IROption A) o (IROption.none A) -> P (IROption.none A)) (hs : forall (x : A), Eq (IROption A) o (IROption.some A x) -> P (IROption.some A x)) : P o := IROption.rec A (fun (o0 : IROption A) => Eq (IROption A) o o0 -> P o0) hn hs o (Eq.refl (IROption A) o)

-- == 2. MEMORY INTERFACE: cells, facts, symbolic lookup/update, the memory-step resume functions and their soundness. This section is what ByteV1 replaces. ==

inductive QC : Type
