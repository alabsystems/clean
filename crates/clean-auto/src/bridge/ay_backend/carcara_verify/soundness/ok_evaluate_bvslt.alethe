(assume h1 (= x (bvslt #b1111 #b0001)))
(assume h2 (= x false))
(step e1 (cl (= (bvslt #b1111 #b0001) true)) :rule evaluate)
(step t1 (cl (= x true)) :rule trans :premises (h1 e1))
(step s2 (cl (= false x)) :rule symm :premises (h2))
(step t2 (cl (= false true)) :rule trans :premises (s2 t1))
(step ev (cl (= (= false true) false)) :rule evaluate)
(step q1 (cl (not (= false true)) false) :rule equiv1 :premises (ev))
(step q2 (cl (not false)) :rule false)
(step done (cl) :rule resolution :premises (t2 q1 q2))
