def ir_vcg_cmpd (fs : IRList QF) (x : QN) (y : QN) : IROption Bool := Bool.rec (fun (_ : Bool) => IROption Bool) (Bool.rec (fun (_ : Bool) => IROption Bool) (IROption.none Bool) (IROption.some Bool Bool.false) (ir_vcg_distinct fs x y)) (IROption.some Bool Bool.true) (ir_vcg_nbeq x y)

