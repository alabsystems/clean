def ir_vcg_facts_hold (env : QE) (mem : IRList IRMemSlot) (fs : IRList QF) : Prop := IRList.rec QF (fun (_ : IRList QF) => Prop) (Eq Bool Bool.true Bool.true) (fun (f : QF) (_ : IRList QF) (ih : Prop) => ir_vcg_and (ir_vcg_fact_holds env mem f) ih) fs

