def ir_vcg_nsnoc (l : IRList Nat) (x : Nat) : IRList Nat := IRList.rec Nat (fun (_ : IRList Nat) => IRList Nat) (IRList.cons Nat x (IRList.nil Nat)) (fun (h : Nat) (_ : IRList Nat) (ih : IRList Nat) => IRList.cons Nat h ih) l

def ir_vcg_ssnoc (l : IRList IRScalar) (x : IRScalar) : IRList IRScalar := IRList.rec IRScalar (fun (_ : IRList IRScalar) => IRList IRScalar) (IRList.cons IRScalar x (IRList.nil IRScalar)) (fun (h : IRScalar) (_ : IRList IRScalar) (ih : IRList IRScalar) => IRList.cons IRScalar h ih) l

