def ir_vcg_bf_r1 (m : IRModule) (env : QE) (mem : IRList IRMemSlot) (sm : IRMachine) (rs : IRList Nat) (f : QF) : IRConfig := QF.rec (fun (_ : QF) => IRConfig) (fun (_ : QN) (_ : QV) (_ : Bool) => IRConfig.halted (IROutcome.stuck IRFault.no_frame)) (fun (_ : QN) (_ : QN) => IRConfig.halted (IROutcome.stuck IRFault.no_frame)) (fun (pre : IRList QC) (a : QN) => ir_bind_result sm rs (ir_borrow_eval (ir_vcg_memden env pre mem) (IRScalar.ptr_ (ir_vcg_nden env a)))) (fun (_ : Nat) (_ : Nat) (_ : Nat) => IRConfig.halted (IROutcome.stuck IRFault.no_frame)) f

