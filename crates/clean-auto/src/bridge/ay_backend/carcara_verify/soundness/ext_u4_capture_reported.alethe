(assume h (not (= (store c x v) c)))
(assume nc (not (not (= (select (store c x v) (choice ((x Int)) (or (= (store c x v) c) (not (= (select (store c x v) x) (select c x)))))) (select c (choice ((x Int)) (or (= (store c x v) c) (not (= (select (store c x v) x) (select c x))))))))))
(step s (cl (not (= (select (store c x v) (choice ((x Int)) (or (= (store c x v) c) (not (= (select (store c x v) x) (select c x)))))) (select c (choice ((x Int)) (or (= (store c x v) c) (not (= (select (store c x v) x) (select c x))))))))) :rule arrays_ext :premises (h))
(step done (cl) :rule resolution :premises (nc s))
