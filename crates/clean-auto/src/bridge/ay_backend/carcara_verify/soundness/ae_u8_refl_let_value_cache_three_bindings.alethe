(assume nc (not (= (let ((u a)) (let ((u (not u)) (w u) (k true)) (or u w))) (let ((v a)) (let ((z (not v)) (w v) (k true)) (or v w))))))
(step s (cl (= (let ((u a)) (let ((u (not u)) (w u) (k true)) (or u w))) (let ((v a)) (let ((z (not v)) (w v) (k true)) (or v w))))) :rule refl)
(step done (cl) :rule resolution :premises (nc s))
