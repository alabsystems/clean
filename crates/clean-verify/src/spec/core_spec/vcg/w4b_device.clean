def ir_vcg_bf_r2 (tg : IRConfig) (f : QF) : IRConfig := QF.rec (fun (_ : QF) => IRConfig) (fun (_ : QN) (_ : QV) (_ : Bool) => IRConfig.halted (IROutcome.stuck IRFault.no_frame)) (fun (_ : QN) (_ : QN) => IRConfig.halted (IROutcome.stuck IRFault.no_frame)) (fun (_ : IRList QC) (_ : QN) => tg) (fun (_ : Nat) (_ : Nat) (_ : Nat) => IRConfig.halted (IROutcome.stuck IRFault.no_frame)) f

def ir_vcg_look_ok (env : QE) (mem : IRList IRMemSlot) (fs : IRList QF) (hf : ir_vcg_facts_hold env mem fs) (fresh : IRList QC) (a : QN) (K1 : IRConfig) (KR : IROption IRMemSlot -> IRConfig) (tg : IRConfig) (K0 : IRConfig) (hK : Eq IRConfig K0 K1) (h1 : Eq IRConfig (ir_vcg_oL QC (ir_vcg_lookup fs fresh a) (fun (_ : QC) => K1)) (ir_vcg_oR QC (ir_vcg_lookup fs fresh a) (fun (_ : QC) => KR (ir_mem_lookup (ir_vcg_memden env fresh mem) (ir_vcg_nden env a))))) (h2 : Eq IRConfig (ir_vcg_oL QC (ir_vcg_lookup fs fresh a) (fun (c : QC) => KR (IROption.some IRMemSlot (ir_vcg_cden env c)))) (ir_vcg_oR QC (ir_vcg_lookup fs fresh a) (fun (_ : QC) => tg))) : Eq IRConfig K0 tg :=
  Eq.trans IRConfig K0 K1 tg hK (ir_vcg_ocase QC (ir_vcg_lookup fs fresh a)
    (fun (o : IROption QC) => Eq IRConfig (ir_vcg_oL QC o (fun (_ : QC) => K1)) (ir_vcg_oR QC o (fun (_ : QC) => KR (ir_mem_lookup (ir_vcg_memden env fresh mem) (ir_vcg_nden env a)))) -> Eq IRConfig (ir_vcg_oL QC o (fun (c : QC) => KR (IROption.some IRMemSlot (ir_vcg_cden env c)))) (ir_vcg_oR QC o (fun (_ : QC) => tg)) -> Eq IRConfig K1 tg)
    (fun (_ : Eq (IROption QC) (ir_vcg_lookup fs fresh a) (IROption.none QC)) (h1n : Eq IRConfig (IRConfig.halted IROutcome.fuel_out) (IRConfig.halted (IROutcome.stuck IRFault.no_frame))) (_ : Eq IRConfig (IRConfig.halted IROutcome.fuel_out) (IRConfig.halted (IROutcome.stuck IRFault.no_frame))) => ir_vcg_cfg_ne h1n (Eq IRConfig K1 tg))
    (fun (c : QC) (hl : Eq (IROption QC) (ir_vcg_lookup fs fresh a) (IROption.some QC c)) (h1s : Eq IRConfig K1 (KR (ir_mem_lookup (ir_vcg_memden env fresh mem) (ir_vcg_nden env a)))) (h2s : Eq IRConfig (KR (IROption.some IRMemSlot (ir_vcg_cden env c))) tg) =>
      Eq.trans IRConfig K1 (KR (ir_mem_lookup (ir_vcg_memden env fresh mem) (ir_vcg_nden env a))) tg h1s
        (Eq.trans IRConfig (KR (ir_mem_lookup (ir_vcg_memden env fresh mem) (ir_vcg_nden env a))) (KR (IROption.some IRMemSlot (ir_vcg_cden env c))) tg
          (ir_eq_cong (IROption IRMemSlot) IRConfig KR (ir_mem_lookup (ir_vcg_memden env fresh mem) (ir_vcg_nden env a)) (IROption.some IRMemSlot (ir_vcg_cden env c)) (ir_vcg_lookup_sound env mem fs hf fresh a c hl))
