                  "required": [
                    "type"
                  ]
                },
                "then": {
                  "anyOf": [
                    {
                      "required": [
                        "uri"
                      ]
                    },
                    {
                      "required": [
                        "url"
                      ]
                    },
                    {
                      "required": [
                        "reference"
                      ]
                    },
