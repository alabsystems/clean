(set-logic ALL)
(declare-const s String)
(assert (not (str.in_re s (re.++ (str.to_re "a") (str.to_re "b")))))
(assert (not (forall ((L Int)) (or (< L 0) (< (str.len s) L) (not (str.in_re (str.substr s 0 L) (str.to_re "a"))) (not (str.in_re (str.substr s L (- (str.len s) L)) (str.to_re "b")))))))
(check-sat)
