(assume h0 (exists ((x Bool)) (and (forall ((w Bool)) (or w (not w))) (let ((y x)) y))))
(assume nc (not (or (and (and (or false (not false)) (or true (not true))) (let ((y x)) y)) (and (and (or false (not false)) (or true (not true))) (let ((y x)) y)))))
(step s (cl (or (and (and (or false (not false)) (or true (not true))) (let ((y x)) y)) (and (and (or false (not false)) (or true (not true))) (let ((y x)) y)))) :rule bfun_elim :premises (h0))
(step done (cl) :rule resolution :premises (nc s))
