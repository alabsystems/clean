-- Link 4 W4 (CrystalVC M0, the second falsifier): the obligation-checked symbolic-execution device over EvalIR. Its soundness theorems are ir_vcg_run_sound and ir_vcg_check_sound; section 5, the engine, is untrusted and only ever checked. Record: reports/crystal-lane/2026-09-30-link4-m0/w4/README.md.

-- == 1. VALUES: symbolic Nats, environments, symbolic scalars and their denotations; Church-and and Bool/Option helpers ==

inductive VcgNat : Type
| lit : Nat -> VcgNat
| var : Nat -> Nat -> VcgNat

def ir_vcg_nth (l : IRList Nat) (i : Nat) : Nat := @IRList.rec Nat (fun (_ : IRList Nat) => Nat -> Nat) (fun (_ : Nat) => Nat.zero) (fun (x : Nat) (_ : IRList Nat) (ih : Nat -> Nat) => fun (j : Nat) => @Nat.rec (fun (_ : Nat) => Nat) x (fun (jp : Nat) (_ : Nat) => ih jp) j) l i

inductive VcgEnv : Type
| mk : IRList Nat -> IRList IRScalar -> VcgEnv

def ir_vcg_ens (env : VcgEnv) : IRList Nat := @VcgEnv.rec (fun (_ : VcgEnv) => IRList Nat) (fun (ns : IRList Nat) (_ : IRList IRScalar) => ns) env

def ir_vcg_ess (env : VcgEnv) : IRList IRScalar := @VcgEnv.rec (fun (_ : VcgEnv) => IRList IRScalar) (fun (_ : IRList Nat) (ss : IRList IRScalar) => ss) env

def ir_vcg_snth (l : IRList IRScalar) (i : Nat) : IRScalar := @IRList.rec IRScalar (fun (_ : IRList IRScalar) => Nat -> IRScalar) (fun (_ : Nat) => IRScalar.undef_) (fun (x : IRScalar) (_ : IRList IRScalar) (ih : Nat -> IRScalar) => fun (j : Nat) => @Nat.rec (fun (_ : Nat) => IRScalar) x (fun (jp : Nat) (_ : IRScalar) => ih jp) j) l i

def ir_vcg_nden (env : VcgEnv) (n : VcgNat) : Nat := @VcgNat.rec (fun (_ : VcgNat) => Nat) (fun (k : Nat) => k) (fun (i : Nat) (k : Nat) => Nat.add (ir_vcg_nth (ir_vcg_ens env) i) k) n

inductive VcgVal : Type
| undef_ : VcgVal
| bool_ : Bool -> VcgVal
| int_ : VcgNat -> VcgVal
| float_ : Nat -> VcgVal
| unit_ : VcgVal
| ptr_ : VcgNat -> VcgVal
| nullptr_ : VcgVal
| fat_ : VcgNat -> VcgNat -> VcgVal
| fnptr_ : Nat -> VcgVal
| aggv : VcgVal -> VcgVal
| vnil : VcgVal
| vcons : VcgVal -> VcgVal -> VcgVal
| opq : Nat -> VcgVal

def ir_vcg_vden (env : VcgEnv) (v : VcgVal) : IRScalar := @VcgVal.rec (fun (_ : VcgVal) => IRScalar) IRScalar.undef_ (fun (b : Bool) => IRScalar.bool_ b) (fun (n : VcgNat) => IRScalar.int_ (ir_vcg_nden env n)) (fun (n : Nat) => IRScalar.float_ n) IRScalar.unit_ (fun (a : VcgNat) => IRScalar.ptr_ (ir_vcg_nden env a)) IRScalar.nullptr_ (fun (d : VcgNat) (md : VcgNat) => IRScalar.fat_ (ir_vcg_nden env d) (ir_vcg_nden env md)) (fun (f : Nat) => IRScalar.fnptr_ f) (fun (_ : VcgVal) (ih : IRScalar) => IRScalar.aggv ih) IRScalar.vnil (fun (_ : VcgVal) (_ : VcgVal) (ihx : IRScalar) (ihr : IRScalar) => IRScalar.vcons ihx ihr) (fun (i : Nat) => ir_vcg_snth (ir_vcg_ess env) i) v

def ir_vcg_vlden (env : VcgEnv) (l : IRList VcgVal) : IRList IRScalar := @IRList.rec VcgVal (fun (_ : IRList VcgVal) => IRList IRScalar) (@IRList.nil IRScalar) (fun (v : VcgVal) (_ : IRList VcgVal) (ih : IRList IRScalar) => @IRList.cons IRScalar (ir_vcg_vden env v) ih) l

def ir_vcg_and (A : Prop) (B : Prop) : Prop := forall (C : Prop), (A -> B -> C) -> C

def ir_vcg_and_intro (A : Prop) (B : Prop) (a : A) (b : B) : ir_vcg_and A B := fun (C : Prop) (k : A -> B -> C) => k a b

def ir_vcg_and_fst (A : Prop) (B : Prop) (h : ir_vcg_and A B) : A := h A (fun (x : A) (_ : B) => x)

def ir_vcg_and_snd (A : Prop) (B : Prop) (h : ir_vcg_and A B) : B := h B (fun (_ : A) (y : B) => y)

def ir_vcg_band_l (a : Bool) (b : Bool) (h : Eq Bool (Bool.and a b) Bool.true) : Eq Bool a Bool.true := @Bool.rec (fun (x : Bool) => Eq Bool (Bool.and x b) Bool.true -> Eq Bool x Bool.true) (fun (hf : Eq Bool Bool.false Bool.true) => hf) (fun (_ : Eq Bool b Bool.true) => @Eq.refl Bool Bool.true) a h

def ir_vcg_band_r (a : Bool) (b : Bool) (h : Eq Bool (Bool.and a b) Bool.true) : Eq Bool b Bool.true := @Bool.rec (fun (x : Bool) => Eq Bool (Bool.and x b) Bool.true -> Eq Bool b Bool.true) (fun (hf : Eq Bool Bool.false Bool.true) => ir_bool_false_ne_true (Eq Bool b Bool.true) hf) (fun (ht : Eq Bool b Bool.true) => ht) a h

def ir_vcg_bor_elim (a : Bool) (b : Bool) (h : Eq Bool (Bool.or a b) Bool.true) (C : Prop) (ha : Eq Bool a Bool.true -> C) (hb : Eq Bool b Bool.true -> C) : C := @Bool.rec (fun (x : Bool) => Eq Bool (Bool.or x b) Bool.true -> (Eq Bool x Bool.true -> C) -> C) (fun (h0 : Eq Bool b Bool.true) (_ : Eq Bool Bool.false Bool.true -> C) => hb h0) (fun (_ : Eq Bool Bool.true Bool.true) (k : Eq Bool Bool.true Bool.true -> C) => k (@Eq.refl Bool Bool.true)) a h ha

def ir_vcg_bcase (b : Bool) (P : Bool -> Prop) (hf : Eq Bool b Bool.false -> P Bool.false) (ht : Eq Bool b Bool.true -> P Bool.true) : P b := @Bool.rec (fun (x : Bool) => Eq Bool b x -> P x) hf ht b (@Eq.refl Bool b)

def ir_vcg_some_inj (A : Type) (x : A) (y : A) (h : Eq (IROption A) (@IROption.some A x) (@IROption.some A y)) : Eq A x y := Eq.subst (IROption A) (fun (o : IROption A) => Eq A x (@IROption.rec A (fun (_ : IROption A) => A) x (fun (z : A) => z) o)) (@IROption.some A x) (@IROption.some A y) h (@Eq.refl A x)

def ir_vcg_none_some (A : Type) (y : A) (h : Eq (IROption A) (@IROption.none A) (@IROption.some A y)) (C : Prop) : C := Eq.subst (IROption A) (fun (o : IROption A) => @IROption.rec A (fun (_ : IROption A) => Prop) (Eq Bool Bool.true Bool.true) (fun (_ : A) => C) o) (@IROption.none A) (@IROption.some A y) h (@Eq.refl Bool Bool.true)

def ir_vcg_ocase (A : Type) (o : IROption A) (P : IROption A -> Prop) (hn : Eq (IROption A) o (@IROption.none A) -> P (@IROption.none A)) (hs : forall (x : A), Eq (IROption A) o (@IROption.some A x) -> P (@IROption.some A x)) : P o := @IROption.rec A (fun (o0 : IROption A) => Eq (IROption A) o o0 -> P o0) hn hs o (@Eq.refl (IROption A) o)

-- == 2. MEMORY INTERFACE: cells, facts, symbolic lookup/update, the memory-step resume functions and their soundness. This section is what ByteV1 replaces. ==

inductive VcgCell : Type
| mk : VcgNat -> VcgVal -> Bool -> VcgCell

def ir_vcg_cden (env : VcgEnv) (c : VcgCell) : IRMemSlot := @VcgCell.rec (fun (_ : VcgCell) => IRMemSlot) (fun (a : VcgNat) (v : VcgVal) (lv : Bool) => IRMemSlot.mk (ir_vcg_nden env a) (ir_vcg_vden env v) lv) c

def ir_vcg_memden (env : VcgEnv) (fresh : IRList VcgCell) (mem : IRList IRMemSlot) : IRList IRMemSlot := @IRList.rec VcgCell (fun (_ : IRList VcgCell) => IRList IRMemSlot) mem (fun (c : VcgCell) (_ : IRList VcgCell) (ih : IRList IRMemSlot) => @IRList.cons IRMemSlot (ir_vcg_cden env c) ih) fresh

inductive VcgFact : Type
| look : VcgNat -> VcgVal -> Bool -> VcgFact
| lt : VcgNat -> VcgNat -> VcgFact
| borrow : IRList VcgCell -> VcgNat -> VcgFact

def ir_vcg_fact_holds (env : VcgEnv) (mem : IRList IRMemSlot) (f : VcgFact) : Prop := @VcgFact.rec (fun (_ : VcgFact) => Prop) (fun (a : VcgNat) (v : VcgVal) (lv : Bool) => Eq (IROption IRMemSlot) (ir_mem_lookup mem (ir_vcg_nden env a)) (@IROption.some IRMemSlot (IRMemSlot.mk (ir_vcg_nden env a) (ir_vcg_vden env v) lv))) (fun (x : VcgNat) (y : VcgNat) => Eq Bool (ir_nat_ltb (ir_vcg_nden env x) (ir_vcg_nden env y)) Bool.true) (fun (pre : IRList VcgCell) (a : VcgNat) => Eq IRStepResult (ir_borrow_eval (ir_vcg_memden env pre mem) (IRScalar.ptr_ (ir_vcg_nden env a))) (IRStepResult.value (IRScalar.ptr_ (ir_vcg_nden env a)))) f

def ir_vcg_facts_hold (env : VcgEnv) (mem : IRList IRMemSlot) (fs : IRList VcgFact) : Prop := @IRList.rec VcgFact (fun (_ : IRList VcgFact) => Prop) (Eq Bool Bool.true Bool.true) (fun (f : VcgFact) (_ : IRList VcgFact) (ih : Prop) => ir_vcg_and (ir_vcg_fact_holds env mem f) ih) fs

def ir_vcg_nbeq (x : VcgNat) (y : VcgNat) : Bool := @VcgNat.rec (fun (_ : VcgNat) => VcgNat -> Bool) (fun (n : Nat) => fun (y0 : VcgNat) => @VcgNat.rec (fun (_ : VcgNat) => Bool) (fun (m : Nat) => ir_nat_eqb n m) (fun (_ : Nat) (_ : Nat) => Bool.false) y0) (fun (i : Nat) (k : Nat) => fun (y0 : VcgNat) => @VcgNat.rec (fun (_ : VcgNat) => Bool) (fun (_ : Nat) => Bool.false) (fun (j : Nat) (l : Nat) => Bool.and (ir_nat_eqb i j) (ir_nat_eqb k l)) y0) x y

def ir_vcg_nbeq_sound (env : VcgEnv) (x : VcgNat) (y : VcgNat) (h : Eq Bool (ir_vcg_nbeq x y) Bool.true) : Eq Nat (ir_vcg_nden env x) (ir_vcg_nden env y) := @VcgNat.rec (fun (x0 : VcgNat) => forall (y0 : VcgNat), Eq Bool (ir_vcg_nbeq x0 y0) Bool.true -> Eq Nat (ir_vcg_nden env x0) (ir_vcg_nden env y0)) (fun (n : Nat) => fun (y0 : VcgNat) => @VcgNat.rec (fun (y1 : VcgNat) => Eq Bool (ir_vcg_nbeq (VcgNat.lit n) y1) Bool.true -> Eq Nat (ir_vcg_nden env (VcgNat.lit n)) (ir_vcg_nden env y1)) (fun (m : Nat) (hm : Eq Bool (ir_nat_eqb n m) Bool.true) => ir_nat_eqb_sound n m hm) (fun (j : Nat) (l : Nat) (hb : Eq Bool Bool.false Bool.true) => ir_bool_false_ne_true (Eq Nat n (Nat.add (ir_vcg_nth (ir_vcg_ens env) j) l)) hb) y0) (fun (i : Nat) (k : Nat) => fun (y0 : VcgNat) => @VcgNat.rec (fun (y1 : VcgNat) => Eq Bool (ir_vcg_nbeq (VcgNat.var i k) y1) Bool.true -> Eq Nat (ir_vcg_nden env (VcgNat.var i k)) (ir_vcg_nden env y1)) (fun (m : Nat) (hb : Eq Bool Bool.false Bool.true) => ir_bool_false_ne_true (Eq Nat (Nat.add (ir_vcg_nth (ir_vcg_ens env) i) k) m) hb) (fun (j : Nat) (l : Nat) (hb : Eq Bool (Bool.and (ir_nat_eqb i j) (ir_nat_eqb k l)) Bool.true) => Eq.subst Nat (fun (j0 : Nat) => Eq Nat (Nat.add (ir_vcg_nth (ir_vcg_ens env) i) k) (Nat.add (ir_vcg_nth (ir_vcg_ens env) j0) l)) i j (ir_nat_eqb_sound i j (ir_vcg_band_l (ir_nat_eqb i j) (ir_nat_eqb k l) hb)) (Eq.subst Nat (fun (l0 : Nat) => Eq Nat (Nat.add (ir_vcg_nth (ir_vcg_ens env) i) k) (Nat.add (ir_vcg_nth (ir_vcg_ens env) i) l0)) k l (ir_nat_eqb_sound k l (ir_vcg_band_r (ir_nat_eqb i j) (ir_nat_eqb k l) hb)) (@Eq.refl Nat (Nat.add (ir_vcg_nth (ir_vcg_ens env) i) k)))) y0) x y h

def ir_vcg_lt_hit (f : VcgFact) (c : VcgNat) (a : VcgNat) : Bool := @VcgFact.rec (fun (_ : VcgFact) => Bool) (fun (_ : VcgNat) (_ : VcgVal) (_ : Bool) => Bool.false) (fun (x : VcgNat) (y : VcgNat) => Bool.and (ir_vcg_nbeq x a) (ir_vcg_nbeq y c)) (fun (_ : IRList VcgCell) (_ : VcgNat) => Bool.false) f

def ir_vcg_distinct (fs : IRList VcgFact) (c : VcgNat) (a : VcgNat) : Bool := @IRList.rec VcgFact (fun (_ : IRList VcgFact) => Bool) Bool.false (fun (f : VcgFact) (_ : IRList VcgFact) (ih : Bool) => Bool.or (ir_vcg_lt_hit f c a) ih) fs

def ir_vcg_lt_hit_sound (env : VcgEnv) (mem : IRList IRMemSlot) (f : VcgFact) (c : VcgNat) (a : VcgNat) (hfact : ir_vcg_fact_holds env mem f) (hh : Eq Bool (ir_vcg_lt_hit f c a) Bool.true) : Eq Bool (ir_nat_eqb (ir_vcg_nden env c) (ir_vcg_nden env a)) Bool.false := @VcgFact.rec (fun (f0 : VcgFact) => ir_vcg_fact_holds env mem f0 -> Eq Bool (ir_vcg_lt_hit f0 c a) Bool.true -> Eq Bool (ir_nat_eqb (ir_vcg_nden env c) (ir_vcg_nden env a)) Bool.false) (fun (x : VcgNat) (v : VcgVal) (lv : Bool) (_ : ir_vcg_fact_holds env mem (VcgFact.look x v lv)) (hb : Eq Bool Bool.false Bool.true) => ir_bool_false_ne_true (Eq Bool (ir_nat_eqb (ir_vcg_nden env c) (ir_vcg_nden env a)) Bool.false) hb) (fun (x : VcgNat) (y : VcgNat) (hl : Eq Bool (ir_nat_ltb (ir_vcg_nden env x) (ir_vcg_nden env y)) Bool.true) (hb : Eq Bool (Bool.and (ir_vcg_nbeq x a) (ir_vcg_nbeq y c)) Bool.true) => ir_nat_ltb_ne (ir_vcg_nden env a) (ir_vcg_nden env c) (Eq.subst Nat (fun (z : Nat) => Eq Bool (ir_nat_ltb (ir_vcg_nden env a) z) Bool.true) (ir_vcg_nden env y) (ir_vcg_nden env c) (ir_vcg_nbeq_sound env y c (ir_vcg_band_r (ir_vcg_nbeq x a) (ir_vcg_nbeq y c) hb)) (Eq.subst Nat (fun (z : Nat) => Eq Bool (ir_nat_ltb z (ir_vcg_nden env y)) Bool.true) (ir_vcg_nden env x) (ir_vcg_nden env a) (ir_vcg_nbeq_sound env x a (ir_vcg_band_l (ir_vcg_nbeq x a) (ir_vcg_nbeq y c) hb)) hl))) (fun (pre : IRList VcgCell) (x : VcgNat) (_ : ir_vcg_fact_holds env mem (VcgFact.borrow pre x)) (hb : Eq Bool Bool.false Bool.true) => ir_bool_false_ne_true (Eq Bool (ir_nat_eqb (ir_vcg_nden env c) (ir_vcg_nden env a)) Bool.false) hb) f hfact hh

def ir_vcg_distinct_sound (env : VcgEnv) (mem : IRList IRMemSlot) (fs : IRList VcgFact) (hf : ir_vcg_facts_hold env mem fs) (c : VcgNat) (a : VcgNat) (h : Eq Bool (ir_vcg_distinct fs c a) Bool.true) : Eq Bool (ir_nat_eqb (ir_vcg_nden env c) (ir_vcg_nden env a)) Bool.false := @IRList.rec VcgFact (fun (fs0 : IRList VcgFact) => ir_vcg_facts_hold env mem fs0 -> Eq Bool (ir_vcg_distinct fs0 c a) Bool.true -> Eq Bool (ir_nat_eqb (ir_vcg_nden env c) (ir_vcg_nden env a)) Bool.false) (fun (_ : Eq Bool Bool.true Bool.true) (hb : Eq Bool Bool.false Bool.true) => ir_bool_false_ne_true (Eq Bool (ir_nat_eqb (ir_vcg_nden env c) (ir_vcg_nden env a)) Bool.false) hb) (fun (f : VcgFact) (rest : IRList VcgFact) (ih : ir_vcg_facts_hold env mem rest -> Eq Bool (ir_vcg_distinct rest c a) Bool.true -> Eq Bool (ir_nat_eqb (ir_vcg_nden env c) (ir_vcg_nden env a)) Bool.false) (hf0 : ir_vcg_and (ir_vcg_fact_holds env mem f) (ir_vcg_facts_hold env mem rest)) (hd : Eq Bool (Bool.or (ir_vcg_lt_hit f c a) (ir_vcg_distinct rest c a)) Bool.true) => ir_vcg_bor_elim (ir_vcg_lt_hit f c a) (ir_vcg_distinct rest c a) hd (Eq Bool (ir_nat_eqb (ir_vcg_nden env c) (ir_vcg_nden env a)) Bool.false) (fun (hh : Eq Bool (ir_vcg_lt_hit f c a) Bool.true) => ir_vcg_lt_hit_sound env mem f c a (ir_vcg_and_fst (ir_vcg_fact_holds env mem f) (ir_vcg_facts_hold env mem rest) hf0) hh) (fun (ht : Eq Bool (ir_vcg_distinct rest c a) Bool.true) => ih (ir_vcg_and_snd (ir_vcg_fact_holds env mem f) (ir_vcg_facts_hold env mem rest) hf0) ht)) fs hf h

def ir_vcg_look_hit (f : VcgFact) (a : VcgNat) (ih : IROption VcgCell) : IROption VcgCell := @VcgFact.rec (fun (_ : VcgFact) => IROption VcgCell) (fun (fa : VcgNat) (fv : VcgVal) (flv : Bool) => @Bool.rec (fun (_ : Bool) => IROption VcgCell) ih (@IROption.some VcgCell (VcgCell.mk fa fv flv)) (ir_vcg_nbeq fa a)) (fun (_ : VcgNat) (_ : VcgNat) => ih) (fun (_ : IRList VcgCell) (_ : VcgNat) => ih) f

def ir_vcg_lookup_base (fs : IRList VcgFact) (a : VcgNat) : IROption VcgCell := @IRList.rec VcgFact (fun (_ : IRList VcgFact) => IROption VcgCell) (@IROption.none VcgCell) (fun (f : VcgFact) (_ : IRList VcgFact) (ih : IROption VcgCell) => ir_vcg_look_hit f a ih) fs

def ir_vcg_lookup_base_sound (env : VcgEnv) (mem : IRList IRMemSlot) (fs : IRList VcgFact) (hf : ir_vcg_facts_hold env mem fs) (a : VcgNat) (c : VcgCell) (h : Eq (IROption VcgCell) (ir_vcg_lookup_base fs a) (@IROption.some VcgCell c)) : Eq (IROption IRMemSlot) (ir_mem_lookup mem (ir_vcg_nden env a)) (@IROption.some IRMemSlot (ir_vcg_cden env c)) := @IRList.rec VcgFact (fun (fs0 : IRList VcgFact) => ir_vcg_facts_hold env mem fs0 -> forall (c0 : VcgCell), Eq (IROption VcgCell) (ir_vcg_lookup_base fs0 a) (@IROption.some VcgCell c0) -> Eq (IROption IRMemSlot) (ir_mem_lookup mem (ir_vcg_nden env a)) (@IROption.some IRMemSlot (ir_vcg_cden env c0))) (fun (_ : Eq Bool Bool.true Bool.true) (c0 : VcgCell) (hn : Eq (IROption VcgCell) (@IROption.none VcgCell) (@IROption.some VcgCell c0)) => ir_vcg_none_some VcgCell c0 hn (Eq (IROption IRMemSlot) (ir_mem_lookup mem (ir_vcg_nden env a)) (@IROption.some IRMemSlot (ir_vcg_cden env c0)))) (fun (f : VcgFact) (rest : IRList VcgFact) (ih : ir_vcg_facts_hold env mem rest -> forall (c0 : VcgCell), Eq (IROption VcgCell) (ir_vcg_lookup_base rest a) (@IROption.some VcgCell c0) -> Eq (IROption IRMemSlot) (ir_mem_lookup mem (ir_vcg_nden env a)) (@IROption.some IRMemSlot (ir_vcg_cden env c0))) (hf0 : ir_vcg_and (ir_vcg_fact_holds env mem f) (ir_vcg_facts_hold env mem rest)) => @VcgFact.rec (fun (f0 : VcgFact) => ir_vcg_fact_holds env mem f0 -> forall (c0 : VcgCell), Eq (IROption VcgCell) (ir_vcg_look_hit f0 a (ir_vcg_lookup_base rest a)) (@IROption.some VcgCell c0) -> Eq (IROption IRMemSlot) (ir_mem_lookup mem (ir_vcg_nden env a)) (@IROption.some IRMemSlot (ir_vcg_cden env c0))) (fun (fa : VcgNat) (fv : VcgVal) (flv : Bool) (hfa : Eq (IROption IRMemSlot) (ir_mem_lookup mem (ir_vcg_nden env fa)) (@IROption.some IRMemSlot (IRMemSlot.mk (ir_vcg_nden env fa) (ir_vcg_vden env fv) flv))) (c0 : VcgCell) => ir_vcg_bcase (ir_vcg_nbeq fa a) (fun (b : Bool) => Eq (IROption VcgCell) (@Bool.rec (fun (_ : Bool) => IROption VcgCell) (ir_vcg_lookup_base rest a) (@IROption.some VcgCell (VcgCell.mk fa fv flv)) b) (@IROption.some VcgCell c0) -> Eq (IROption IRMemSlot) (ir_mem_lookup mem (ir_vcg_nden env a)) (@IROption.some IRMemSlot (ir_vcg_cden env c0))) (fun (_ : Eq Bool (ir_vcg_nbeq fa a) Bool.false) (hl : Eq (IROption VcgCell) (ir_vcg_lookup_base rest a) (@IROption.some VcgCell c0)) => ih (ir_vcg_and_snd (ir_vcg_fact_holds env mem f) (ir_vcg_facts_hold env mem rest) hf0) c0 hl) (fun (hbeq : Eq Bool (ir_vcg_nbeq fa a) Bool.true) (hl : Eq (IROption VcgCell) (@IROption.some VcgCell (VcgCell.mk fa fv flv)) (@IROption.some VcgCell c0)) => Eq.subst VcgCell (fun (c1 : VcgCell) => Eq (IROption IRMemSlot) (ir_mem_lookup mem (ir_vcg_nden env a)) (@IROption.some IRMemSlot (ir_vcg_cden env c1))) (VcgCell.mk fa fv flv) c0 (ir_vcg_some_inj VcgCell (VcgCell.mk fa fv flv) c0 hl) (Eq.subst Nat (fun (z : Nat) => Eq (IROption IRMemSlot) (ir_mem_lookup mem z) (@IROption.some IRMemSlot (IRMemSlot.mk (ir_vcg_nden env fa) (ir_vcg_vden env fv) flv))) (ir_vcg_nden env fa) (ir_vcg_nden env a) (ir_vcg_nbeq_sound env fa a hbeq) hfa))) (fun (x : VcgNat) (y : VcgNat) (_ : ir_vcg_fact_holds env mem (VcgFact.lt x y)) (c0 : VcgCell) (hl : Eq (IROption VcgCell) (ir_vcg_lookup_base rest a) (@IROption.some VcgCell c0)) => ih (ir_vcg_and_snd (ir_vcg_fact_holds env mem f) (ir_vcg_facts_hold env mem rest) hf0) c0 hl) (fun (pre : IRList VcgCell) (x : VcgNat) (_ : ir_vcg_fact_holds env mem (VcgFact.borrow pre x)) (c0 : VcgCell) (hl : Eq (IROption VcgCell) (ir_vcg_lookup_base rest a) (@IROption.some VcgCell c0)) => ih (ir_vcg_and_snd (ir_vcg_fact_holds env mem f) (ir_vcg_facts_hold env mem rest) hf0) c0 hl) f (ir_vcg_and_fst (ir_vcg_fact_holds env mem f) (ir_vcg_facts_hold env mem rest) hf0)) fs hf c h

def ir_vcg_cell_step (fs : IRList VcgFact) (c : VcgCell) (a : VcgNat) (ih : IROption VcgCell) : IROption VcgCell := @VcgCell.rec (fun (_ : VcgCell) => IROption VcgCell) (fun (ca : VcgNat) (_ : VcgVal) (_ : Bool) => @Bool.rec (fun (_ : Bool) => IROption VcgCell) (@Bool.rec (fun (_ : Bool) => IROption VcgCell) (@IROption.none VcgCell) ih (ir_vcg_distinct fs ca a)) (@IROption.some VcgCell c) (ir_vcg_nbeq ca a)) c

def ir_vcg_lookup (fs : IRList VcgFact) (fresh : IRList VcgCell) (a : VcgNat) : IROption VcgCell := @IRList.rec VcgCell (fun (_ : IRList VcgCell) => IROption VcgCell) (ir_vcg_lookup_base fs a) (fun (c : VcgCell) (_ : IRList VcgCell) (ih : IROption VcgCell) => ir_vcg_cell_step fs c a ih) fresh

