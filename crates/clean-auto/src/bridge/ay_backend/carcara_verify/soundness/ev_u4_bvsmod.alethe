(assume h1 (= x (bvsmod #b1011 #b0100)))
(assume h2 (= x #b0011))
(step e1 (cl (= (bvsmod #b1011 #b0100) #b0001)) :rule evaluate)
(step t1 (cl (= x #b0001)) :rule trans :premises (h1 e1))
(step s2 (cl (= #b0011 x)) :rule symm :premises (h2))
(step t2 (cl (= #b0011 #b0001)) :rule trans :premises (s2 t1))
(step ev (cl (= (= #b0011 #b0001) false)) :rule evaluate)
(step q1 (cl (not (= #b0011 #b0001)) false) :rule equiv1 :premises (ev))
(step q2 (cl (not false)) :rule false)
(step done (cl) :rule resolution :premises (t2 q1 q2))
