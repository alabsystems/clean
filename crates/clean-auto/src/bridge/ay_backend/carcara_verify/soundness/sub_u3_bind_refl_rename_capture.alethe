(assume nc (not (= (forall ((x Bool)) (exists ((y Bool)) (xor y y_renamed))) (forall ((y Bool)) (exists ((z Bool)) (xor z z))))))
(anchor :step s :args ((y Bool) (:= (x Bool) y)))
(step s.t1 (cl (= (exists ((y Bool)) (xor y y_renamed)) (exists ((z Bool)) (xor z z)))) :rule refl)
(step s (cl (= (forall ((x Bool)) (exists ((y Bool)) (xor y y_renamed))) (forall ((y Bool)) (exists ((z Bool)) (xor z z))))) :rule bind)
(step done (cl) :rule resolution :premises (nc s))
