def ir_vcg_ucell (fs : IRList VcgFact) (c : VcgCell) (a : VcgNat) (v : VcgVal) (rest : IRList VcgCell) (ih : IROption (IRList VcgCell)) : IROption (IRList VcgCell) := @VcgCell.rec (fun (_ : VcgCell) => IROption (IRList VcgCell)) (fun (ca : VcgNat) (_ : VcgVal) (clv : Bool) => @Bool.rec (fun (_ : Bool) => IROption (IRList VcgCell)) (@Bool.rec (fun (_ : Bool) => IROption (IRList VcgCell)) (@IROption.none (IRList VcgCell)) (@IROption.rec (IRList VcgCell) (fun (_ : IROption (IRList VcgCell)) => IROption (IRList VcgCell)) (@IROption.none (IRList VcgCell)) (fun (l : IRList VcgCell) => @IROption.some (IRList VcgCell) (@IRList.cons VcgCell c l)) ih) (ir_vcg_distinct fs ca a)) (@IROption.some (IRList VcgCell) (@IRList.cons VcgCell (VcgCell.mk ca v clv) rest)) (ir_vcg_nbeq ca a)) c

def ir_vcg_update (fs : IRList VcgFact) (fresh : IRList VcgCell) (a : VcgNat) (v : VcgVal) : IROption (IRList VcgCell) := @IRList.rec VcgCell (fun (_ : IRList VcgCell) => IROption (IRList VcgCell)) (@IROption.none (IRList VcgCell)) (fun (c : VcgCell) (rest : IRList VcgCell) (ih : IROption (IRList VcgCell)) => ir_vcg_ucell fs c a v rest ih) fresh

def ir_vcg_mupd_goal (env : VcgEnv) (mem : IRList IRMemSlot) (fr : IRList VcgCell) (a : VcgNat) (v : VcgVal) (f2 : IRList VcgCell) : Prop := Eq (IRList IRMemSlot) (ir_mem_update (ir_vcg_memden env fr mem) (ir_vcg_nden env a) (ir_vcg_vden env v)) (ir_vcg_memden env f2 mem)

def ir_vcg_update_hit (env : VcgEnv) (mem : IRList IRMemSlot) (ca : VcgNat) (cv : VcgVal) (clv : Bool) (rest : IRList VcgCell) (a : VcgNat) (v : VcgVal) (hb : Eq Bool (ir_vcg_nbeq ca a) Bool.true) : ir_vcg_mupd_goal env mem (@IRList.cons VcgCell (VcgCell.mk ca cv clv) rest) a v (@IRList.cons VcgCell (VcgCell.mk ca v clv) rest) :=
  Eq.subst Bool
    (fun (b3 : Bool) => Eq (IRList IRMemSlot)
      (@Bool.rec (fun (_ : Bool) => IRList IRMemSlot)
        (@IRList.cons IRMemSlot (IRMemSlot.mk (ir_vcg_nden env ca) (ir_vcg_vden env cv) clv) (ir_mem_update (ir_vcg_memden env rest mem) (ir_vcg_nden env a) (ir_vcg_vden env v)))
        (@IRList.cons IRMemSlot (IRMemSlot.mk (ir_vcg_nden env ca) (ir_vcg_vden env v) clv) (ir_vcg_memden env rest mem)) b3)
      (@IRList.cons IRMemSlot (IRMemSlot.mk (ir_vcg_nden env ca) (ir_vcg_vden env v) clv) (ir_vcg_memden env rest mem)))
    Bool.true (ir_nat_eqb (ir_vcg_nden env ca) (ir_vcg_nden env a))
    (Eq.symm Bool (ir_nat_eqb (ir_vcg_nden env ca) (ir_vcg_nden env a)) Bool.true (ir_vcg_eqb_of_beq env ca a hb))
    (@Eq.refl (IRList IRMemSlot) (@IRList.cons IRMemSlot (IRMemSlot.mk (ir_vcg_nden env ca) (ir_vcg_vden env v) clv) (ir_vcg_memden env rest mem)))

def ir_vcg_update_skip (env : VcgEnv) (mem : IRList IRMemSlot) (fs : IRList VcgFact) (hf : ir_vcg_facts_hold env mem fs) (ca : VcgNat) (cv : VcgVal) (clv : Bool) (rest : IRList VcgCell) (a : VcgNat) (v : VcgVal) (hd : Eq Bool (ir_vcg_distinct fs ca a) Bool.true) (l : IRList VcgCell) (hl : ir_vcg_mupd_goal env mem rest a v l) : ir_vcg_mupd_goal env mem (@IRList.cons VcgCell (VcgCell.mk ca cv clv) rest) a v (@IRList.cons VcgCell (VcgCell.mk ca cv clv) l) :=
  Eq.subst Bool
    (fun (b3 : Bool) => Eq (IRList IRMemSlot)
      (@Bool.rec (fun (_ : Bool) => IRList IRMemSlot)
        (@IRList.cons IRMemSlot (IRMemSlot.mk (ir_vcg_nden env ca) (ir_vcg_vden env cv) clv) (ir_mem_update (ir_vcg_memden env rest mem) (ir_vcg_nden env a) (ir_vcg_vden env v)))
        (@IRList.cons IRMemSlot (IRMemSlot.mk (ir_vcg_nden env ca) (ir_vcg_vden env v) clv) (ir_vcg_memden env rest mem)) b3)
      (@IRList.cons IRMemSlot (IRMemSlot.mk (ir_vcg_nden env ca) (ir_vcg_vden env cv) clv) (ir_vcg_memden env l mem)))
    Bool.false (ir_nat_eqb (ir_vcg_nden env ca) (ir_vcg_nden env a))
    (Eq.symm Bool (ir_nat_eqb (ir_vcg_nden env ca) (ir_vcg_nden env a)) Bool.false (ir_vcg_distinct_sound env mem fs hf ca a hd))
    (ir_eq_cong (IRList IRMemSlot) (IRList IRMemSlot) (fun (t : IRList IRMemSlot) => @IRList.cons IRMemSlot (IRMemSlot.mk (ir_vcg_nden env ca) (ir_vcg_vden env cv) clv) t)
      (ir_mem_update (ir_vcg_memden env rest mem) (ir_vcg_nden env a) (ir_vcg_vden env v)) (ir_vcg_memden env l mem) hl)

def ir_vcg_update_cell (env : VcgEnv) (mem : IRList IRMemSlot) (fs : IRList VcgFact) (hf : ir_vcg_facts_hold env mem fs) (ca : VcgNat) (cv : VcgVal) (clv : Bool) (rest : IRList VcgCell) (a : VcgNat) (v : VcgVal) (ih : forall (f2 : IRList VcgCell), Eq (IROption (IRList VcgCell)) (ir_vcg_update fs rest a v) (@IROption.some (IRList VcgCell) f2) -> ir_vcg_mupd_goal env mem rest a v f2) (f2 : IRList VcgCell) (h : Eq (IROption (IRList VcgCell)) (ir_vcg_ucell fs (VcgCell.mk ca cv clv) a v rest (ir_vcg_update fs rest a v)) (@IROption.some (IRList VcgCell) f2)) : ir_vcg_mupd_goal env mem (@IRList.cons VcgCell (VcgCell.mk ca cv clv) rest) a v f2 :=
  ir_vcg_bcase (ir_vcg_nbeq ca a)
    (fun (b : Bool) => Eq (IROption (IRList VcgCell))
       (@Bool.rec (fun (_ : Bool) => IROption (IRList VcgCell))
         (@Bool.rec (fun (_ : Bool) => IROption (IRList VcgCell)) (@IROption.none (IRList VcgCell))
           (@IROption.rec (IRList VcgCell) (fun (_ : IROption (IRList VcgCell)) => IROption (IRList VcgCell)) (@IROption.none (IRList VcgCell)) (fun (l : IRList VcgCell) => @IROption.some (IRList VcgCell) (@IRList.cons VcgCell (VcgCell.mk ca cv clv) l)) (ir_vcg_update fs rest a v))
           (ir_vcg_distinct fs ca a))
         (@IROption.some (IRList VcgCell) (@IRList.cons VcgCell (VcgCell.mk ca v clv) rest)) b)
       (@IROption.some (IRList VcgCell) f2) -> ir_vcg_mupd_goal env mem (@IRList.cons VcgCell (VcgCell.mk ca cv clv) rest) a v f2)
    (fun (_ : Eq Bool (ir_vcg_nbeq ca a) Bool.false) =>
      ir_vcg_bcase (ir_vcg_distinct fs ca a)
        (fun (b2 : Bool) => Eq (IROption (IRList VcgCell))
           (@Bool.rec (fun (_ : Bool) => IROption (IRList VcgCell)) (@IROption.none (IRList VcgCell))
             (@IROption.rec (IRList VcgCell) (fun (_ : IROption (IRList VcgCell)) => IROption (IRList VcgCell)) (@IROption.none (IRList VcgCell)) (fun (l : IRList VcgCell) => @IROption.some (IRList VcgCell) (@IRList.cons VcgCell (VcgCell.mk ca cv clv) l)) (ir_vcg_update fs rest a v)) b2)
           (@IROption.some (IRList VcgCell) f2) -> ir_vcg_mupd_goal env mem (@IRList.cons VcgCell (VcgCell.mk ca cv clv) rest) a v f2)
        (fun (_ : Eq Bool (ir_vcg_distinct fs ca a) Bool.false) (hn : Eq (IROption (IRList VcgCell)) (@IROption.none (IRList VcgCell)) (@IROption.some (IRList VcgCell) f2)) =>
          ir_vcg_none_some (IRList VcgCell) f2 hn (ir_vcg_mupd_goal env mem (@IRList.cons VcgCell (VcgCell.mk ca cv clv) rest) a v f2))
        (fun (hd : Eq Bool (ir_vcg_distinct fs ca a) Bool.true) =>
          ir_vcg_ocase (IRList VcgCell) (ir_vcg_update fs rest a v)
            (fun (o : IROption (IRList VcgCell)) => Eq (IROption (IRList VcgCell))
               (@IROption.rec (IRList VcgCell) (fun (_ : IROption (IRList VcgCell)) => IROption (IRList VcgCell)) (@IROption.none (IRList VcgCell)) (fun (l : IRList VcgCell) => @IROption.some (IRList VcgCell) (@IRList.cons VcgCell (VcgCell.mk ca cv clv) l)) o)
               (@IROption.some (IRList VcgCell) f2) -> ir_vcg_mupd_goal env mem (@IRList.cons VcgCell (VcgCell.mk ca cv clv) rest) a v f2)
            (fun (_ : Eq (IROption (IRList VcgCell)) (ir_vcg_update fs rest a v) (@IROption.none (IRList VcgCell))) (hn : Eq (IROption (IRList VcgCell)) (@IROption.none (IRList VcgCell)) (@IROption.some (IRList VcgCell) f2)) =>
              ir_vcg_none_some (IRList VcgCell) f2 hn (ir_vcg_mupd_goal env mem (@IRList.cons VcgCell (VcgCell.mk ca cv clv) rest) a v f2))
            (fun (l : IRList VcgCell) (hu : Eq (IROption (IRList VcgCell)) (ir_vcg_update fs rest a v) (@IROption.some (IRList VcgCell) l)) (hs : Eq (IROption (IRList VcgCell)) (@IROption.some (IRList VcgCell) (@IRList.cons VcgCell (VcgCell.mk ca cv clv) l)) (@IROption.some (IRList VcgCell) f2)) =>
              Eq.subst (IRList VcgCell) (fun (f3 : IRList VcgCell) => ir_vcg_mupd_goal env mem (@IRList.cons VcgCell (VcgCell.mk ca cv clv) rest) a v f3)
                (@IRList.cons VcgCell (VcgCell.mk ca cv clv) l) f2 (ir_vcg_some_inj (IRList VcgCell) (@IRList.cons VcgCell (VcgCell.mk ca cv clv) l) f2 hs)
                (ir_vcg_update_skip env mem fs hf ca cv clv rest a v hd l (ih l hu)))))
    (fun (hb : Eq Bool (ir_vcg_nbeq ca a) Bool.true) (hs : Eq (IROption (IRList VcgCell)) (@IROption.some (IRList VcgCell) (@IRList.cons VcgCell (VcgCell.mk ca v clv) rest)) (@IROption.some (IRList VcgCell) f2)) =>
      Eq.subst (IRList VcgCell) (fun (f3 : IRList VcgCell) => ir_vcg_mupd_goal env mem (@IRList.cons VcgCell (VcgCell.mk ca cv clv) rest) a v f3)
        (@IRList.cons VcgCell (VcgCell.mk ca v clv) rest) f2 (ir_vcg_some_inj (IRList VcgCell) (@IRList.cons VcgCell (VcgCell.mk ca v clv) rest) f2 hs)
        (ir_vcg_update_hit env mem ca cv clv rest a v hb))
    h

def ir_vcg_update_sound (env : VcgEnv) (mem : IRList IRMemSlot) (fs : IRList VcgFact) (hf : ir_vcg_facts_hold env mem fs) (fresh : IRList VcgCell) (a : VcgNat) (v : VcgVal) (fr2 : IRList VcgCell) (h : Eq (IROption (IRList VcgCell)) (ir_vcg_update fs fresh a v) (@IROption.some (IRList VcgCell) fr2)) : ir_vcg_mupd_goal env mem fresh a v fr2 :=
  @IRList.rec VcgCell
    (fun (fr : IRList VcgCell) => forall (f2 : IRList VcgCell), Eq (IROption (IRList VcgCell)) (ir_vcg_update fs fr a v) (@IROption.some (IRList VcgCell) f2) -> ir_vcg_mupd_goal env mem fr a v f2)
    (fun (f2 : IRList VcgCell) (hn : Eq (IROption (IRList VcgCell)) (@IROption.none (IRList VcgCell)) (@IROption.some (IRList VcgCell) f2)) =>
      ir_vcg_none_some (IRList VcgCell) f2 hn (ir_vcg_mupd_goal env mem (@IRList.nil VcgCell) a v f2))
    (fun (cell : VcgCell) (rest : IRList VcgCell) (ih : forall (f2 : IRList VcgCell), Eq (IROption (IRList VcgCell)) (ir_vcg_update fs rest a v) (@IROption.some (IRList VcgCell) f2) -> ir_vcg_mupd_goal env mem rest a v f2) =>
      @VcgCell.rec
        (fun (cell0 : VcgCell) => forall (f2 : IRList VcgCell), Eq (IROption (IRList VcgCell)) (ir_vcg_ucell fs cell0 a v rest (ir_vcg_update fs rest a v)) (@IROption.some (IRList VcgCell) f2) -> ir_vcg_mupd_goal env mem (@IRList.cons VcgCell cell0 rest) a v f2)
        (fun (ca : VcgNat) (cv : VcgVal) (clv : Bool) => ir_vcg_update_cell env mem fs hf ca cv clv rest a v ih)
        cell)
    fresh fr2 h

def ir_vcg_r_load (m : IRModule) (s : IRMachine) (rs : IRList Nat) (t : IRTy) (o : IROption IRMemSlot) : IRConfig := ir_bind_result s rs (ir_load_view (ir_mod_encs m) t (ir_load_slot o))

def ir_vcg_r_borrow (s : IRMachine) (rs : IRList Nat) (a : Nat) (o : IROption IRMemSlot) : IRConfig := ir_bind_result s rs (ir_borrow_slot a o)

def ir_vcg_r_store (s : IRMachine) (o : IROption IRMemSlot) (u : IRList IRMemSlot) : IRConfig := @IROption.rec IRMemSlot (fun (_ : IROption IRMemSlot) => IRConfig) (IRConfig.halted (IROutcome.ub IRFault.bad_addr)) (fun (cl : IRMemSlot) => @Bool.rec (fun (_ : Bool) => IRConfig) (IRConfig.halted (IROutcome.ub IRFault.bad_addr)) (ir_advance (ir_set_mem s u)) (ir_slot_live cl)) o

def ir_vcg_oL (A : Type) (o : IROption A) (k : A -> IRConfig) : IRConfig := @IROption.rec A (fun (_ : IROption A) => IRConfig) (IRConfig.halted IROutcome.fuel_out) k o

def ir_vcg_oR (A : Type) (o : IROption A) (k : A -> IRConfig) : IRConfig := @IROption.rec A (fun (_ : IROption A) => IRConfig) (IRConfig.halted (IROutcome.stuck IRFault.no_frame)) k o

def ir_vcg_cfg_ne (h : Eq IRConfig (IRConfig.halted IROutcome.fuel_out) (IRConfig.halted (IROutcome.stuck IRFault.no_frame))) (C : Prop) : C := Eq.subst IRConfig (fun (c : IRConfig) => @IRConfig.rec (fun (_ : IRConfig) => Prop) (fun (_ : IRMachine) => C) (fun (o : IROutcome) => @IROutcome.rec (fun (_ : IROutcome) => Prop) (fun (_ : IRList IRScalar) => C) (fun (_ : IRFault) => C) (fun (_ : IRFault) => C) (fun (_ : IRFault) => C) (fun (_ : IRFault) => C) (Eq Bool Bool.true Bool.true) o) c) (IRConfig.halted IROutcome.fuel_out) (IRConfig.halted (IROutcome.stuck IRFault.no_frame)) h (@Eq.refl Bool Bool.true)

def ir_vcg_fact_at (fs : IRList VcgFact) (j : Nat) : VcgFact := @IRList.rec VcgFact (fun (_ : IRList VcgFact) => Nat -> VcgFact) (fun (_ : Nat) => VcgFact.lt (VcgNat.lit Nat.zero) (VcgNat.lit (Nat.succ Nat.zero))) (fun (f : VcgFact) (_ : IRList VcgFact) (ih : Nat -> VcgFact) => fun (k : Nat) => @Nat.rec (fun (_ : Nat) => VcgFact) f (fun (kp : Nat) (_ : VcgFact) => ih kp) k) fs j

def ir_vcg_fact_at_holds (env : VcgEnv) (mem : IRList IRMemSlot) (fs : IRList VcgFact) (hf : ir_vcg_facts_hold env mem fs) (j : Nat) : ir_vcg_fact_holds env mem (ir_vcg_fact_at fs j) :=
  @IRList.rec VcgFact (fun (fs0 : IRList VcgFact) => ir_vcg_facts_hold env mem fs0 -> forall (k : Nat), ir_vcg_fact_holds env mem (ir_vcg_fact_at fs0 k))
    (fun (_ : Eq Bool Bool.true Bool.true) (k : Nat) => @Eq.refl Bool Bool.true)
    (fun (f : VcgFact) (rest : IRList VcgFact) (ih : ir_vcg_facts_hold env mem rest -> forall (k : Nat), ir_vcg_fact_holds env mem (ir_vcg_fact_at rest k)) (hf0 : ir_vcg_and (ir_vcg_fact_holds env mem f) (ir_vcg_facts_hold env mem rest)) (k : Nat) =>
      @Nat.rec (fun (k0 : Nat) => ir_vcg_fact_holds env mem (ir_vcg_fact_at (@IRList.cons VcgFact f rest) k0))
        (ir_vcg_and_fst (ir_vcg_fact_holds env mem f) (ir_vcg_facts_hold env mem rest) hf0)
        (fun (kp : Nat) (_ : ir_vcg_fact_holds env mem (ir_vcg_fact_at (@IRList.cons VcgFact f rest) kp)) => ih (ir_vcg_and_snd (ir_vcg_fact_holds env mem f) (ir_vcg_facts_hold env mem rest) hf0) kp) k)
    fs hf j

def ir_vcg_bf_l1 (m : IRModule) (env : VcgEnv) (mem : IRList IRMemSlot) (sm : IRMachine) (rs : IRList Nat) (f : VcgFact) : IRConfig := @VcgFact.rec (fun (_ : VcgFact) => IRConfig) (fun (_ : VcgNat) (_ : VcgVal) (_ : Bool) => IRConfig.halted IROutcome.fuel_out) (fun (_ : VcgNat) (_ : VcgNat) => IRConfig.halted IROutcome.fuel_out) (fun (_ : IRList VcgCell) (_ : VcgNat) => ir_step m sm) f

def ir_vcg_bf_r1 (m : IRModule) (env : VcgEnv) (mem : IRList IRMemSlot) (sm : IRMachine) (rs : IRList Nat) (f : VcgFact) : IRConfig := @VcgFact.rec (fun (_ : VcgFact) => IRConfig) (fun (_ : VcgNat) (_ : VcgVal) (_ : Bool) => IRConfig.halted (IROutcome.stuck IRFault.no_frame)) (fun (_ : VcgNat) (_ : VcgNat) => IRConfig.halted (IROutcome.stuck IRFault.no_frame)) (fun (pre : IRList VcgCell) (a : VcgNat) => ir_bind_result sm rs (ir_borrow_eval (ir_vcg_memden env pre mem) (IRScalar.ptr_ (ir_vcg_nden env a)))) f

def ir_vcg_bf_l2 (env : VcgEnv) (sm : IRMachine) (rs : IRList Nat) (f : VcgFact) : IRConfig := @VcgFact.rec (fun (_ : VcgFact) => IRConfig) (fun (_ : VcgNat) (_ : VcgVal) (_ : Bool) => IRConfig.halted IROutcome.fuel_out) (fun (_ : VcgNat) (_ : VcgNat) => IRConfig.halted IROutcome.fuel_out) (fun (_ : IRList VcgCell) (a : VcgNat) => ir_bind_result sm rs (IRStepResult.value (IRScalar.ptr_ (ir_vcg_nden env a)))) f

def ir_vcg_bf_r2 (tg : IRConfig) (f : VcgFact) : IRConfig := @VcgFact.rec (fun (_ : VcgFact) => IRConfig) (fun (_ : VcgNat) (_ : VcgVal) (_ : Bool) => IRConfig.halted (IROutcome.stuck IRFault.no_frame)) (fun (_ : VcgNat) (_ : VcgNat) => IRConfig.halted (IROutcome.stuck IRFault.no_frame)) (fun (_ : IRList VcgCell) (_ : VcgNat) => tg) f

def ir_vcg_look_ok (env : VcgEnv) (mem : IRList IRMemSlot) (fs : IRList VcgFact) (hf : ir_vcg_facts_hold env mem fs) (fresh : IRList VcgCell) (a : VcgNat) (K1 : IRConfig) (KR : IROption IRMemSlot -> IRConfig) (tg : IRConfig) (h1 : Eq IRConfig (ir_vcg_oL VcgCell (ir_vcg_lookup fs fresh a) (fun (_ : VcgCell) => K1)) (ir_vcg_oR VcgCell (ir_vcg_lookup fs fresh a) (fun (_ : VcgCell) => KR (ir_mem_lookup (ir_vcg_memden env fresh mem) (ir_vcg_nden env a))))) (h2 : Eq IRConfig (ir_vcg_oL VcgCell (ir_vcg_lookup fs fresh a) (fun (c : VcgCell) => KR (@IROption.some IRMemSlot (ir_vcg_cden env c)))) (ir_vcg_oR VcgCell (ir_vcg_lookup fs fresh a) (fun (_ : VcgCell) => tg))) : Eq IRConfig K1 tg :=
  ir_vcg_ocase VcgCell (ir_vcg_lookup fs fresh a)
    (fun (o : IROption VcgCell) => Eq IRConfig (ir_vcg_oL VcgCell o (fun (_ : VcgCell) => K1)) (ir_vcg_oR VcgCell o (fun (_ : VcgCell) => KR (ir_mem_lookup (ir_vcg_memden env fresh mem) (ir_vcg_nden env a)))) -> Eq IRConfig (ir_vcg_oL VcgCell o (fun (c : VcgCell) => KR (@IROption.some IRMemSlot (ir_vcg_cden env c)))) (ir_vcg_oR VcgCell o (fun (_ : VcgCell) => tg)) -> Eq IRConfig K1 tg)
    (fun (_ : Eq (IROption VcgCell) (ir_vcg_lookup fs fresh a) (@IROption.none VcgCell)) (h1n : Eq IRConfig (IRConfig.halted IROutcome.fuel_out) (IRConfig.halted (IROutcome.stuck IRFault.no_frame))) (_ : Eq IRConfig (IRConfig.halted IROutcome.fuel_out) (IRConfig.halted (IROutcome.stuck IRFault.no_frame))) => ir_vcg_cfg_ne h1n (Eq IRConfig K1 tg))
    (fun (c : VcgCell) (hl : Eq (IROption VcgCell) (ir_vcg_lookup fs fresh a) (@IROption.some VcgCell c)) (h1s : Eq IRConfig K1 (KR (ir_mem_lookup (ir_vcg_memden env fresh mem) (ir_vcg_nden env a)))) (h2s : Eq IRConfig (KR (@IROption.some IRMemSlot (ir_vcg_cden env c))) tg) =>
      Eq.trans IRConfig K1 (KR (ir_mem_lookup (ir_vcg_memden env fresh mem) (ir_vcg_nden env a))) tg h1s
        (Eq.trans IRConfig (KR (ir_mem_lookup (ir_vcg_memden env fresh mem) (ir_vcg_nden env a))) (KR (@IROption.some IRMemSlot (ir_vcg_cden env c))) tg
          (ir_eq_cong (IROption IRMemSlot) IRConfig KR (ir_mem_lookup (ir_vcg_memden env fresh mem) (ir_vcg_nden env a)) (@IROption.some IRMemSlot (ir_vcg_cden env c)) (ir_vcg_lookup_sound env mem fs hf fresh a c hl))
          h2s))
    h1 h2

def ir_vcg_store_ok (env : VcgEnv) (mem : IRList IRMemSlot) (fs : IRList VcgFact) (hf : ir_vcg_facts_hold env mem fs) (fresh : IRList VcgCell) (a : VcgNat) (v : VcgVal) (K1 : IRConfig) (KS : IROption IRMemSlot -> IRList IRMemSlot -> IRConfig) (tg : IRConfig) (h1 : Eq IRConfig (ir_vcg_oL VcgCell (ir_vcg_lookup fs fresh a) (fun (_ : VcgCell) => ir_vcg_oL (IRList VcgCell) (ir_vcg_update fs fresh a v) (fun (_ : IRList VcgCell) => K1))) (ir_vcg_oR VcgCell (ir_vcg_lookup fs fresh a) (fun (_ : VcgCell) => ir_vcg_oR (IRList VcgCell) (ir_vcg_update fs fresh a v) (fun (_ : IRList VcgCell) => KS (ir_mem_lookup (ir_vcg_memden env fresh mem) (ir_vcg_nden env a)) (ir_mem_update (ir_vcg_memden env fresh mem) (ir_vcg_nden env a) (ir_vcg_vden env v)))))) (h2 : Eq IRConfig (ir_vcg_oL VcgCell (ir_vcg_lookup fs fresh a) (fun (c : VcgCell) => ir_vcg_oL (IRList VcgCell) (ir_vcg_update fs fresh a v) (fun (fr2 : IRList VcgCell) => KS (@IROption.some IRMemSlot (ir_vcg_cden env c)) (ir_vcg_memden env fr2 mem)))) (ir_vcg_oR VcgCell (ir_vcg_lookup fs fresh a) (fun (_ : VcgCell) => ir_vcg_oR (IRList VcgCell) (ir_vcg_update fs fresh a v) (fun (_ : IRList VcgCell) => tg)))) : Eq IRConfig K1 tg :=
  ir_vcg_ocase VcgCell (ir_vcg_lookup fs fresh a)
    (fun (o : IROption VcgCell) => Eq IRConfig (ir_vcg_oL VcgCell o (fun (_ : VcgCell) => ir_vcg_oL (IRList VcgCell) (ir_vcg_update fs fresh a v) (fun (_ : IRList VcgCell) => K1))) (ir_vcg_oR VcgCell o (fun (_ : VcgCell) => ir_vcg_oR (IRList VcgCell) (ir_vcg_update fs fresh a v) (fun (_ : IRList VcgCell) => KS (ir_mem_lookup (ir_vcg_memden env fresh mem) (ir_vcg_nden env a)) (ir_mem_update (ir_vcg_memden env fresh mem) (ir_vcg_nden env a) (ir_vcg_vden env v))))) -> Eq IRConfig (ir_vcg_oL VcgCell o (fun (c : VcgCell) => ir_vcg_oL (IRList VcgCell) (ir_vcg_update fs fresh a v) (fun (fr2 : IRList VcgCell) => KS (@IROption.some IRMemSlot (ir_vcg_cden env c)) (ir_vcg_memden env fr2 mem)))) (ir_vcg_oR VcgCell o (fun (_ : VcgCell) => ir_vcg_oR (IRList VcgCell) (ir_vcg_update fs fresh a v) (fun (_ : IRList VcgCell) => tg))) -> Eq IRConfig K1 tg)
    (fun (_ : Eq (IROption VcgCell) (ir_vcg_lookup fs fresh a) (@IROption.none VcgCell)) (h1n : Eq IRConfig (IRConfig.halted IROutcome.fuel_out) (IRConfig.halted (IROutcome.stuck IRFault.no_frame))) (_ : Eq IRConfig (IRConfig.halted IROutcome.fuel_out) (IRConfig.halted (IROutcome.stuck IRFault.no_frame))) => ir_vcg_cfg_ne h1n (Eq IRConfig K1 tg))
    (fun (c : VcgCell) (hl : Eq (IROption VcgCell) (ir_vcg_lookup fs fresh a) (@IROption.some VcgCell c)) =>
      ir_vcg_ocase (IRList VcgCell) (ir_vcg_update fs fresh a v)
        (fun (u : IROption (IRList VcgCell)) => Eq IRConfig (ir_vcg_oL (IRList VcgCell) u (fun (_ : IRList VcgCell) => K1)) (ir_vcg_oR (IRList VcgCell) u (fun (_ : IRList VcgCell) => KS (ir_mem_lookup (ir_vcg_memden env fresh mem) (ir_vcg_nden env a)) (ir_mem_update (ir_vcg_memden env fresh mem) (ir_vcg_nden env a) (ir_vcg_vden env v)))) -> Eq IRConfig (ir_vcg_oL (IRList VcgCell) u (fun (fr2 : IRList VcgCell) => KS (@IROption.some IRMemSlot (ir_vcg_cden env c)) (ir_vcg_memden env fr2 mem))) (ir_vcg_oR (IRList VcgCell) u (fun (_ : IRList VcgCell) => tg)) -> Eq IRConfig K1 tg)
        (fun (_ : Eq (IROption (IRList VcgCell)) (ir_vcg_update fs fresh a v) (@IROption.none (IRList VcgCell))) (h1n : Eq IRConfig (IRConfig.halted IROutcome.fuel_out) (IRConfig.halted (IROutcome.stuck IRFault.no_frame))) (_ : Eq IRConfig (IRConfig.halted IROutcome.fuel_out) (IRConfig.halted (IROutcome.stuck IRFault.no_frame))) => ir_vcg_cfg_ne h1n (Eq IRConfig K1 tg))
        (fun (fr2 : IRList VcgCell) (hu : Eq (IROption (IRList VcgCell)) (ir_vcg_update fs fresh a v) (@IROption.some (IRList VcgCell) fr2)) (h1s : Eq IRConfig K1 (KS (ir_mem_lookup (ir_vcg_memden env fresh mem) (ir_vcg_nden env a)) (ir_mem_update (ir_vcg_memden env fresh mem) (ir_vcg_nden env a) (ir_vcg_vden env v)))) (h2s : Eq IRConfig (KS (@IROption.some IRMemSlot (ir_vcg_cden env c)) (ir_vcg_memden env fr2 mem)) tg) =>
          Eq.trans IRConfig K1 (KS (ir_mem_lookup (ir_vcg_memden env fresh mem) (ir_vcg_nden env a)) (ir_mem_update (ir_vcg_memden env fresh mem) (ir_vcg_nden env a) (ir_vcg_vden env v))) tg h1s
            (Eq.subst (IROption IRMemSlot) (fun (o : IROption IRMemSlot) => Eq IRConfig (KS o (ir_mem_update (ir_vcg_memden env fresh mem) (ir_vcg_nden env a) (ir_vcg_vden env v))) tg)
              (@IROption.some IRMemSlot (ir_vcg_cden env c)) (ir_mem_lookup (ir_vcg_memden env fresh mem) (ir_vcg_nden env a))
              (Eq.symm (IROption IRMemSlot) (ir_mem_lookup (ir_vcg_memden env fresh mem) (ir_vcg_nden env a)) (@IROption.some IRMemSlot (ir_vcg_cden env c)) (ir_vcg_lookup_sound env mem fs hf fresh a c hl))
              (Eq.subst (IRList IRMemSlot) (fun (u2 : IRList IRMemSlot) => Eq IRConfig (KS (@IROption.some IRMemSlot (ir_vcg_cden env c)) u2) tg)
                (ir_vcg_memden env fr2 mem) (ir_mem_update (ir_vcg_memden env fresh mem) (ir_vcg_nden env a) (ir_vcg_vden env v))
                (Eq.symm (IRList IRMemSlot) (ir_mem_update (ir_vcg_memden env fresh mem) (ir_vcg_nden env a) (ir_vcg_vden env v)) (ir_vcg_memden env fr2 mem) (ir_vcg_update_sound env mem fs hf fresh a v fr2 hu))
                h2s))))
    h1 h2

def ir_vcg_borrowf_ok (m : IRModule) (env : VcgEnv) (mem : IRList IRMemSlot) (sm : IRMachine) (rs : IRList Nat) (tg : IRConfig) (f : VcgFact) (hfa : ir_vcg_fact_holds env mem f) (h1 : Eq IRConfig (ir_vcg_bf_l1 m env mem sm rs f) (ir_vcg_bf_r1 m env mem sm rs f)) (h2 : Eq IRConfig (ir_vcg_bf_l2 env sm rs f) (ir_vcg_bf_r2 tg f)) : Eq IRConfig (ir_step m sm) tg :=
  @VcgFact.rec
    (fun (f0 : VcgFact) => ir_vcg_fact_holds env mem f0 -> Eq IRConfig (ir_vcg_bf_l1 m env mem sm rs f0) (ir_vcg_bf_r1 m env mem sm rs f0) -> Eq IRConfig (ir_vcg_bf_l2 env sm rs f0) (ir_vcg_bf_r2 tg f0) -> Eq IRConfig (ir_step m sm) tg)
    (fun (x : VcgNat) (v : VcgVal) (lv : Bool) (_ : ir_vcg_fact_holds env mem (VcgFact.look x v lv)) (h1n : Eq IRConfig (IRConfig.halted IROutcome.fuel_out) (IRConfig.halted (IROutcome.stuck IRFault.no_frame))) (_ : Eq IRConfig (IRConfig.halted IROutcome.fuel_out) (IRConfig.halted (IROutcome.stuck IRFault.no_frame))) => ir_vcg_cfg_ne h1n (Eq IRConfig (ir_step m sm) tg))
    (fun (x : VcgNat) (y : VcgNat) (_ : ir_vcg_fact_holds env mem (VcgFact.lt x y)) (h1n : Eq IRConfig (IRConfig.halted IROutcome.fuel_out) (IRConfig.halted (IROutcome.stuck IRFault.no_frame))) (_ : Eq IRConfig (IRConfig.halted IROutcome.fuel_out) (IRConfig.halted (IROutcome.stuck IRFault.no_frame))) => ir_vcg_cfg_ne h1n (Eq IRConfig (ir_step m sm) tg))
    (fun (pre : IRList VcgCell) (a : VcgNat) (hb : Eq IRStepResult (ir_borrow_eval (ir_vcg_memden env pre mem) (IRScalar.ptr_ (ir_vcg_nden env a))) (IRStepResult.value (IRScalar.ptr_ (ir_vcg_nden env a)))) (h1s : Eq IRConfig (ir_step m sm) (ir_bind_result sm rs (ir_borrow_eval (ir_vcg_memden env pre mem) (IRScalar.ptr_ (ir_vcg_nden env a))))) (h2s : Eq IRConfig (ir_bind_result sm rs (IRStepResult.value (IRScalar.ptr_ (ir_vcg_nden env a)))) tg) =>
      Eq.trans IRConfig (ir_step m sm) (ir_bind_result sm rs (ir_borrow_eval (ir_vcg_memden env pre mem) (IRScalar.ptr_ (ir_vcg_nden env a)))) tg h1s
        (Eq.trans IRConfig (ir_bind_result sm rs (ir_borrow_eval (ir_vcg_memden env pre mem) (IRScalar.ptr_ (ir_vcg_nden env a)))) (ir_bind_result sm rs (IRStepResult.value (IRScalar.ptr_ (ir_vcg_nden env a)))) tg
          (ir_eq_cong IRStepResult IRConfig (fun (x : IRStepResult) => ir_bind_result sm rs x) (ir_borrow_eval (ir_vcg_memden env pre mem) (IRScalar.ptr_ (ir_vcg_nden env a))) (IRStepResult.value (IRScalar.ptr_ (ir_vcg_nden env a))) hb)
          h2s))
    f hfa h1 h2

-- == 3. MACHINE AND STEPS: symbolic frames/machines, the step kinds, the per-step obligations, and the run's soundness ==

inductive VcgBind : Type
| mk : Nat -> VcgVal -> VcgBind

def ir_vcg_locden (env : VcgEnv) (l : IRList VcgBind) : IRList IRBinding := @IRList.rec VcgBind (fun (_ : IRList VcgBind) => IRList IRBinding) (@IRList.nil IRBinding) (fun (b : VcgBind) (_ : IRList VcgBind) (ih : IRList IRBinding) => @IRList.cons IRBinding (@VcgBind.rec (fun (_ : VcgBind) => IRBinding) (fun (i : Nat) (v : VcgVal) => IRBinding.mk i (ir_vcg_vden env v)) b) ih) l

inductive VcgFrame : Type
| mk : Nat -> Nat -> Nat -> IRList VcgBind -> IROption (IRList Nat) -> VcgFrame

def ir_vcg_fden (env : VcgEnv) (d : IRList Nat) (f : VcgFrame) : IRFrame := @VcgFrame.rec (fun (_ : VcgFrame) => IRFrame) (fun (fn : Nat) (bl : Nat) (pc : Nat) (loc : IRList VcgBind) (ds : IROption (IRList Nat)) => IRFrame.mk fn bl pc (ir_vcg_locden env loc) (@IROption.rec (IRList Nat) (fun (_ : IROption (IRList Nat)) => IRList Nat) d (fun (x : IRList Nat) => x) ds)) f

def ir_vcg_framesden (env : VcgEnv) (d : IRList Nat) (r : IRList IRFrame) (fs : IRList VcgFrame) : IRList IRFrame := @IRList.rec VcgFrame (fun (_ : IRList VcgFrame) => IRList IRFrame) r (fun (f : VcgFrame) (_ : IRList VcgFrame) (ih : IRList IRFrame) => @IRList.cons IRFrame (ir_vcg_fden env d f) ih) fs

inductive VcgMach : Type
| mk : IRList VcgFrame -> IRList VcgCell -> VcgNat -> VcgMach

def ir_vcg_mden (env : VcgEnv) (mem : IRList IRMemSlot) (d : IRList Nat) (r : IRList IRFrame) (s : VcgMach) : IRMachine := @VcgMach.rec (fun (_ : VcgMach) => IRMachine) (fun (fs : IRList VcgFrame) (fresh : IRList VcgCell) (na : VcgNat) => IRMachine.mk (ir_vcg_framesden env d r fs) (ir_vcg_memden env fresh mem) (ir_vcg_nden env na)) s

def ir_vcg_mfresh (s : VcgMach) : IRList VcgCell := @VcgMach.rec (fun (_ : VcgMach) => IRList VcgCell) (fun (_ : IRList VcgFrame) (fresh : IRList VcgCell) (_ : VcgNat) => fresh) s

inductive VcgStep : Type
| pure : VcgMach -> VcgStep
| load : VcgMach -> IRList Nat -> IRTy -> VcgNat -> VcgStep
| borrowl : VcgMach -> IRList Nat -> VcgNat -> VcgStep
| borrowf : VcgMach -> IRList Nat -> Nat -> VcgStep
| store : VcgMach -> VcgNat -> VcgVal -> VcgStep
| fin : VcgMach -> IRList VcgCell -> VcgNat -> IRList VcgVal -> VcgStep
| stop : VcgMach -> VcgStep

def ir_vcg_start (st : VcgStep) : VcgMach := @VcgStep.rec (fun (_ : VcgStep) => VcgMach) (fun (s : VcgMach) => s) (fun (s : VcgMach) (_ : IRList Nat) (_ : IRTy) (_ : VcgNat) => s) (fun (s : VcgMach) (_ : IRList Nat) (_ : VcgNat) => s) (fun (s : VcgMach) (_ : IRList Nat) (_ : Nat) => s) (fun (s : VcgMach) (_ : VcgNat) (_ : VcgVal) => s) (fun (s : VcgMach) (_ : IRList VcgCell) (_ : VcgNat) (_ : IRList VcgVal) => s) (fun (s : VcgMach) => s) st

def ir_vcg_end_cfg (env : VcgEnv) (mem : IRList IRMemSlot) (d : IRList Nat) (r : IRList IRFrame) (st : VcgStep) : IRConfig := @VcgStep.rec (fun (_ : VcgStep) => IRConfig) (fun (_ : VcgMach) => IRConfig.halted IROutcome.fuel_out) (fun (_ : VcgMach) (_ : IRList Nat) (_ : IRTy) (_ : VcgNat) => IRConfig.halted IROutcome.fuel_out) (fun (_ : VcgMach) (_ : IRList Nat) (_ : VcgNat) => IRConfig.halted IROutcome.fuel_out) (fun (_ : VcgMach) (_ : IRList Nat) (_ : Nat) => IRConfig.halted IROutcome.fuel_out) (fun (_ : VcgMach) (_ : VcgNat) (_ : VcgVal) => IRConfig.halted IROutcome.fuel_out) (fun (_ : VcgMach) (fr : IRList VcgCell) (na : VcgNat) (vals : IRList VcgVal) => ir_ret_to d r (ir_vcg_memden env fr mem) (ir_vcg_nden env na) (ir_vcg_vlden env vals)) (fun (s : VcgMach) => IRConfig.running (ir_vcg_mden env mem d r s)) st

def ir_vcg_target (env : VcgEnv) (mem : IRList IRMemSlot) (d : IRList Nat) (r : IRList IRFrame) (st : VcgStep) (rest : IRList VcgStep) : IRConfig := @IRList.rec VcgStep (fun (_ : IRList VcgStep) => IRConfig) (ir_vcg_end_cfg env mem d r st) (fun (st2 : VcgStep) (_ : IRList VcgStep) (_ : IRConfig) => IRConfig.running (ir_vcg_mden env mem d r (ir_vcg_start st2))) rest

def ir_vcg_l1 (m : IRModule) (env : VcgEnv) (mem : IRList IRMemSlot) (d : IRList Nat) (r : IRList IRFrame) (fs : IRList VcgFact) (st : VcgStep) : IRConfig := @VcgStep.rec (fun (_ : VcgStep) => IRConfig)
  (fun (s : VcgMach) => ir_step m (ir_vcg_mden env mem d r s))
  (fun (s : VcgMach) (rs : IRList Nat) (t : IRTy) (a : VcgNat) => ir_vcg_oL VcgCell (ir_vcg_lookup fs (ir_vcg_mfresh s) a) (fun (_ : VcgCell) => ir_step m (ir_vcg_mden env mem d r s)))
  (fun (s : VcgMach) (rs : IRList Nat) (a : VcgNat) => ir_vcg_oL VcgCell (ir_vcg_lookup fs (ir_vcg_mfresh s) a) (fun (_ : VcgCell) => ir_step m (ir_vcg_mden env mem d r s)))
  (fun (s : VcgMach) (rs : IRList Nat) (j : Nat) => ir_vcg_bf_l1 m env mem (ir_vcg_mden env mem d r s) rs (ir_vcg_fact_at fs j))
  (fun (s : VcgMach) (a : VcgNat) (v : VcgVal) => ir_vcg_oL VcgCell (ir_vcg_lookup fs (ir_vcg_mfresh s) a) (fun (_ : VcgCell) => ir_vcg_oL (IRList VcgCell) (ir_vcg_update fs (ir_vcg_mfresh s) a v) (fun (_ : IRList VcgCell) => ir_step m (ir_vcg_mden env mem d r s))))
  (fun (s : VcgMach) (_ : IRList VcgCell) (_ : VcgNat) (_ : IRList VcgVal) => ir_step m (ir_vcg_mden env mem d r s))
  (fun (s : VcgMach) => IRConfig.running (ir_vcg_mden env mem d r s)) st

def ir_vcg_r1 (m : IRModule) (env : VcgEnv) (mem : IRList IRMemSlot) (d : IRList Nat) (r : IRList IRFrame) (fs : IRList VcgFact) (st : VcgStep) (tg : IRConfig) : IRConfig := @VcgStep.rec (fun (_ : VcgStep) => IRConfig)
  (fun (_ : VcgMach) => tg)
  (fun (s : VcgMach) (rs : IRList Nat) (t : IRTy) (a : VcgNat) => ir_vcg_oR VcgCell (ir_vcg_lookup fs (ir_vcg_mfresh s) a) (fun (_ : VcgCell) => ir_vcg_r_load m (ir_vcg_mden env mem d r s) rs t (ir_mem_lookup (ir_vcg_memden env (ir_vcg_mfresh s) mem) (ir_vcg_nden env a))))
  (fun (s : VcgMach) (rs : IRList Nat) (a : VcgNat) => ir_vcg_oR VcgCell (ir_vcg_lookup fs (ir_vcg_mfresh s) a) (fun (_ : VcgCell) => ir_vcg_r_borrow (ir_vcg_mden env mem d r s) rs (ir_vcg_nden env a) (ir_mem_lookup (ir_vcg_memden env (ir_vcg_mfresh s) mem) (ir_vcg_nden env a))))
  (fun (s : VcgMach) (rs : IRList Nat) (j : Nat) => ir_vcg_bf_r1 m env mem (ir_vcg_mden env mem d r s) rs (ir_vcg_fact_at fs j))
  (fun (s : VcgMach) (a : VcgNat) (v : VcgVal) => ir_vcg_oR VcgCell (ir_vcg_lookup fs (ir_vcg_mfresh s) a) (fun (_ : VcgCell) => ir_vcg_oR (IRList VcgCell) (ir_vcg_update fs (ir_vcg_mfresh s) a v) (fun (_ : IRList VcgCell) => ir_vcg_r_store (ir_vcg_mden env mem d r s) (ir_mem_lookup (ir_vcg_memden env (ir_vcg_mfresh s) mem) (ir_vcg_nden env a)) (ir_mem_update (ir_vcg_memden env (ir_vcg_mfresh s) mem) (ir_vcg_nden env a) (ir_vcg_vden env v)))))
  (fun (_ : VcgMach) (_ : IRList VcgCell) (_ : VcgNat) (_ : IRList VcgVal) => tg)
  (fun (_ : VcgMach) => tg) st

def ir_vcg_l2 (m : IRModule) (env : VcgEnv) (mem : IRList IRMemSlot) (d : IRList Nat) (r : IRList IRFrame) (fs : IRList VcgFact) (st : VcgStep) : IRConfig := @VcgStep.rec (fun (_ : VcgStep) => IRConfig)
  (fun (_ : VcgMach) => IRConfig.halted IROutcome.fuel_out)
  (fun (s : VcgMach) (rs : IRList Nat) (t : IRTy) (a : VcgNat) => ir_vcg_oL VcgCell (ir_vcg_lookup fs (ir_vcg_mfresh s) a) (fun (c : VcgCell) => ir_vcg_r_load m (ir_vcg_mden env mem d r s) rs t (@IROption.some IRMemSlot (ir_vcg_cden env c))))
  (fun (s : VcgMach) (rs : IRList Nat) (a : VcgNat) => ir_vcg_oL VcgCell (ir_vcg_lookup fs (ir_vcg_mfresh s) a) (fun (c : VcgCell) => ir_vcg_r_borrow (ir_vcg_mden env mem d r s) rs (ir_vcg_nden env a) (@IROption.some IRMemSlot (ir_vcg_cden env c))))
  (fun (s : VcgMach) (rs : IRList Nat) (j : Nat) => ir_vcg_bf_l2 env (ir_vcg_mden env mem d r s) rs (ir_vcg_fact_at fs j))
  (fun (s : VcgMach) (a : VcgNat) (v : VcgVal) => ir_vcg_oL VcgCell (ir_vcg_lookup fs (ir_vcg_mfresh s) a) (fun (c : VcgCell) => ir_vcg_oL (IRList VcgCell) (ir_vcg_update fs (ir_vcg_mfresh s) a v) (fun (fr2 : IRList VcgCell) => ir_vcg_r_store (ir_vcg_mden env mem d r s) (@IROption.some IRMemSlot (ir_vcg_cden env c)) (ir_vcg_memden env fr2 mem))))
  (fun (_ : VcgMach) (_ : IRList VcgCell) (_ : VcgNat) (_ : IRList VcgVal) => IRConfig.halted IROutcome.fuel_out)
  (fun (_ : VcgMach) => IRConfig.halted IROutcome.fuel_out) st

def ir_vcg_r2 (fs : IRList VcgFact) (st : VcgStep) (tg : IRConfig) : IRConfig := @VcgStep.rec (fun (_ : VcgStep) => IRConfig)
  (fun (_ : VcgMach) => IRConfig.halted IROutcome.fuel_out)
  (fun (s : VcgMach) (_ : IRList Nat) (_ : IRTy) (a : VcgNat) => ir_vcg_oR VcgCell (ir_vcg_lookup fs (ir_vcg_mfresh s) a) (fun (_ : VcgCell) => tg))
  (fun (s : VcgMach) (_ : IRList Nat) (a : VcgNat) => ir_vcg_oR VcgCell (ir_vcg_lookup fs (ir_vcg_mfresh s) a) (fun (_ : VcgCell) => tg))
  (fun (_ : VcgMach) (_ : IRList Nat) (j : Nat) => ir_vcg_bf_r2 tg (ir_vcg_fact_at fs j))
  (fun (s : VcgMach) (a : VcgNat) (v : VcgVal) => ir_vcg_oR VcgCell (ir_vcg_lookup fs (ir_vcg_mfresh s) a) (fun (_ : VcgCell) => ir_vcg_oR (IRList VcgCell) (ir_vcg_update fs (ir_vcg_mfresh s) a v) (fun (_ : IRList VcgCell) => tg)))
  (fun (_ : VcgMach) (_ : IRList VcgCell) (_ : VcgNat) (_ : IRList VcgVal) => IRConfig.halted IROutcome.fuel_out)
  (fun (_ : VcgMach) => IRConfig.halted IROutcome.fuel_out) st

def ir_vcg_lhs (m : IRModule) (env : VcgEnv) (mem : IRList IRMemSlot) (d : IRList Nat) (r : IRList IRFrame) (fs : IRList VcgFact) (T : IRList VcgStep) : IRList IRConfig := @IRList.rec VcgStep (fun (_ : IRList VcgStep) => IRList IRConfig) (@IRList.nil IRConfig) (fun (st : VcgStep) (_ : IRList VcgStep) (ih : IRList IRConfig) => @IRList.cons IRConfig (ir_vcg_l1 m env mem d r fs st) (@IRList.cons IRConfig (ir_vcg_l2 m env mem d r fs st) ih)) T

def ir_vcg_rhs (m : IRModule) (env : VcgEnv) (mem : IRList IRMemSlot) (d : IRList Nat) (r : IRList IRFrame) (fs : IRList VcgFact) (T : IRList VcgStep) : IRList IRConfig := @IRList.rec VcgStep (fun (_ : IRList VcgStep) => IRList IRConfig) (@IRList.nil IRConfig) (fun (st : VcgStep) (rest : IRList VcgStep) (ih : IRList IRConfig) => @IRList.cons IRConfig (ir_vcg_r1 m env mem d r fs st (ir_vcg_target env mem d r st rest)) (@IRList.cons IRConfig (ir_vcg_r2 fs st (ir_vcg_target env mem d r st rest)) ih)) T

def ir_vcg_adv (m : IRModule) (env : VcgEnv) (mem : IRList IRMemSlot) (d : IRList Nat) (r : IRList IRFrame) (st : VcgStep) : IRConfig := @VcgStep.rec (fun (_ : VcgStep) => IRConfig) (fun (s : VcgMach) => ir_step m (ir_vcg_mden env mem d r s)) (fun (s : VcgMach) (_ : IRList Nat) (_ : IRTy) (_ : VcgNat) => ir_step m (ir_vcg_mden env mem d r s)) (fun (s : VcgMach) (_ : IRList Nat) (_ : VcgNat) => ir_step m (ir_vcg_mden env mem d r s)) (fun (s : VcgMach) (_ : IRList Nat) (_ : Nat) => ir_step m (ir_vcg_mden env mem d r s)) (fun (s : VcgMach) (_ : VcgNat) (_ : VcgVal) => ir_step m (ir_vcg_mden env mem d r s)) (fun (s : VcgMach) (_ : IRList VcgCell) (_ : VcgNat) (_ : IRList VcgVal) => ir_step m (ir_vcg_mden env mem d r s)) (fun (s : VcgMach) => IRConfig.running (ir_vcg_mden env mem d r s)) st

def ir_vcg_step_ok (m : IRModule) (env : VcgEnv) (mem : IRList IRMemSlot) (d : IRList Nat) (r : IRList IRFrame) (fs : IRList VcgFact) (hf : ir_vcg_facts_hold env mem fs) (st : VcgStep) (tg : IRConfig) (h1 : Eq IRConfig (ir_vcg_l1 m env mem d r fs st) (ir_vcg_r1 m env mem d r fs st tg)) (h2 : Eq IRConfig (ir_vcg_l2 m env mem d r fs st) (ir_vcg_r2 fs st tg)) : Eq IRConfig (ir_vcg_adv m env mem d r st) tg :=
  @VcgStep.rec
    (fun (st0 : VcgStep) => Eq IRConfig (ir_vcg_l1 m env mem d r fs st0) (ir_vcg_r1 m env mem d r fs st0 tg) -> Eq IRConfig (ir_vcg_l2 m env mem d r fs st0) (ir_vcg_r2 fs st0 tg) -> Eq IRConfig (ir_vcg_adv m env mem d r st0) tg)
    (fun (s : VcgMach) (h1s : Eq IRConfig (ir_step m (ir_vcg_mden env mem d r s)) tg) (_ : Eq IRConfig (IRConfig.halted IROutcome.fuel_out) (IRConfig.halted IROutcome.fuel_out)) => h1s)
    (fun (s : VcgMach) (rs : IRList Nat) (t : IRTy) (a : VcgNat) => ir_vcg_look_ok env mem fs hf (ir_vcg_mfresh s) a (ir_step m (ir_vcg_mden env mem d r s)) (fun (o : IROption IRMemSlot) => ir_vcg_r_load m (ir_vcg_mden env mem d r s) rs t o) tg)
    (fun (s : VcgMach) (rs : IRList Nat) (a : VcgNat) => ir_vcg_look_ok env mem fs hf (ir_vcg_mfresh s) a (ir_step m (ir_vcg_mden env mem d r s)) (fun (o : IROption IRMemSlot) => ir_vcg_r_borrow (ir_vcg_mden env mem d r s) rs (ir_vcg_nden env a) o) tg)
    (fun (s : VcgMach) (rs : IRList Nat) (j : Nat) => ir_vcg_borrowf_ok m env mem (ir_vcg_mden env mem d r s) rs tg (ir_vcg_fact_at fs j) (ir_vcg_fact_at_holds env mem fs hf j))
    (fun (s : VcgMach) (a : VcgNat) (v : VcgVal) => ir_vcg_store_ok env mem fs hf (ir_vcg_mfresh s) a v (ir_step m (ir_vcg_mden env mem d r s)) (fun (o : IROption IRMemSlot) (u : IRList IRMemSlot) => ir_vcg_r_store (ir_vcg_mden env mem d r s) o u) tg)
    (fun (s : VcgMach) (fr : IRList VcgCell) (na : VcgNat) (vals : IRList VcgVal) (h1s : Eq IRConfig (ir_step m (ir_vcg_mden env mem d r s)) tg) (_ : Eq IRConfig (IRConfig.halted IROutcome.fuel_out) (IRConfig.halted IROutcome.fuel_out)) => h1s)
    (fun (s : VcgMach) (h1s : Eq IRConfig (IRConfig.running (ir_vcg_mden env mem d r s)) tg) (_ : Eq IRConfig (IRConfig.halted IROutcome.fuel_out) (IRConfig.halted IROutcome.fuel_out)) => h1s)
    st h1 h2

def ir_vcg_slen (st : VcgStep) (k : Nat) : Nat := @VcgStep.rec (fun (_ : VcgStep) => Nat) (fun (_ : VcgMach) => Nat.succ k) (fun (_ : VcgMach) (_ : IRList Nat) (_ : IRTy) (_ : VcgNat) => Nat.succ k) (fun (_ : VcgMach) (_ : IRList Nat) (_ : VcgNat) => Nat.succ k) (fun (_ : VcgMach) (_ : IRList Nat) (_ : Nat) => Nat.succ k) (fun (_ : VcgMach) (_ : VcgNat) (_ : VcgVal) => Nat.succ k) (fun (_ : VcgMach) (_ : IRList VcgCell) (_ : VcgNat) (_ : IRList VcgVal) => Nat.succ k) (fun (_ : VcgMach) => k) st

def ir_vcg_len (T : IRList VcgStep) : Nat := @IRList.rec VcgStep (fun (_ : IRList VcgStep) => Nat) Nat.zero (fun (st : VcgStep) (_ : IRList VcgStep) (ih : Nat) => ir_vcg_slen st ih) T

def ir_vcg_adv_steps (m : IRModule) (env : VcgEnv) (mem : IRList IRMemSlot) (d : IRList Nat) (r : IRList IRFrame) (st : VcgStep) (k : Nat) : Eq IRConfig (ir_steps (ir_vcg_slen st k) m (IRConfig.running (ir_vcg_mden env mem d r (ir_vcg_start st)))) (ir_steps k m (ir_vcg_adv m env mem d r st)) := @VcgStep.rec (fun (st0 : VcgStep) => Eq IRConfig (ir_steps (ir_vcg_slen st0 k) m (IRConfig.running (ir_vcg_mden env mem d r (ir_vcg_start st0)))) (ir_steps k m (ir_vcg_adv m env mem d r st0))) (fun (s : VcgMach) => @Eq.refl IRConfig (ir_steps k m (ir_step m (ir_vcg_mden env mem d r s)))) (fun (s : VcgMach) (_ : IRList Nat) (_ : IRTy) (_ : VcgNat) => @Eq.refl IRConfig (ir_steps k m (ir_step m (ir_vcg_mden env mem d r s)))) (fun (s : VcgMach) (_ : IRList Nat) (_ : VcgNat) => @Eq.refl IRConfig (ir_steps k m (ir_step m (ir_vcg_mden env mem d r s)))) (fun (s : VcgMach) (_ : IRList Nat) (_ : Nat) => @Eq.refl IRConfig (ir_steps k m (ir_step m (ir_vcg_mden env mem d r s)))) (fun (s : VcgMach) (_ : VcgNat) (_ : VcgVal) => @Eq.refl IRConfig (ir_steps k m (ir_step m (ir_vcg_mden env mem d r s)))) (fun (s : VcgMach) (_ : IRList VcgCell) (_ : VcgNat) (_ : IRList VcgVal) => @Eq.refl IRConfig (ir_steps k m (ir_step m (ir_vcg_mden env mem d r s)))) (fun (s : VcgMach) => @Eq.refl IRConfig (ir_steps k m (IRConfig.running (ir_vcg_mden env mem d r s)))) st

def ir_vcg_start_cfg (env : VcgEnv) (mem : IRList IRMemSlot) (d : IRList Nat) (r : IRList IRFrame) (T : IRList VcgStep) : IRConfig := @IRList.rec VcgStep (fun (_ : IRList VcgStep) => IRConfig) (IRConfig.halted IROutcome.fuel_out) (fun (st : VcgStep) (_ : IRList VcgStep) (_ : IRConfig) => IRConfig.running (ir_vcg_mden env mem d r (ir_vcg_start st))) T

def ir_vcg_final (env : VcgEnv) (mem : IRList IRMemSlot) (d : IRList Nat) (r : IRList IRFrame) (T : IRList VcgStep) : IRConfig := @IRList.rec VcgStep (fun (_ : IRList VcgStep) => IRConfig) (IRConfig.halted IROutcome.fuel_out) (fun (st : VcgStep) (rest : IRList VcgStep) (ih : IRConfig) => @IRList.rec VcgStep (fun (_ : IRList VcgStep) => IRConfig) (ir_vcg_end_cfg env mem d r st) (fun (_ : VcgStep) (_ : IRList VcgStep) (_ : IRConfig) => ih) rest) T

def ir_vcg_claim (m : IRModule) (env : VcgEnv) (mem : IRList IRMemSlot) (d : IRList Nat) (r : IRList IRFrame) (T : IRList VcgStep) : Prop := Eq IRConfig (ir_steps (ir_vcg_len T) m (ir_vcg_start_cfg env mem d r T)) (ir_vcg_final env mem d r T)

def ir_vcg_tail (m : IRModule) (env : VcgEnv) (mem : IRList IRMemSlot) (d : IRList Nat) (r : IRList IRFrame) (st : VcgStep) (rest : IRList VcgStep) (hc : ir_vcg_claim m env mem d r rest) : Eq IRConfig (ir_steps (ir_vcg_len rest) m (ir_vcg_target env mem d r st rest)) (ir_vcg_final env mem d r (@IRList.cons VcgStep st rest)) :=
  @IRList.rec VcgStep
    (fun (rest0 : IRList VcgStep) => ir_vcg_claim m env mem d r rest0 -> Eq IRConfig (ir_steps (ir_vcg_len rest0) m (ir_vcg_target env mem d r st rest0)) (ir_vcg_final env mem d r (@IRList.cons VcgStep st rest0)))
    (fun (_ : ir_vcg_claim m env mem d r (@IRList.nil VcgStep)) => @Eq.refl IRConfig (ir_vcg_end_cfg env mem d r st))
    (fun (st2 : VcgStep) (rest2 : IRList VcgStep) (_ : ir_vcg_claim m env mem d r rest2 -> Eq IRConfig (ir_steps (ir_vcg_len rest2) m (ir_vcg_target env mem d r st rest2)) (ir_vcg_final env mem d r (@IRList.cons VcgStep st rest2))) (hc2 : ir_vcg_claim m env mem d r (@IRList.cons VcgStep st2 rest2)) => hc2)
    rest hc

def ir_vcg_chd (l : IRList IRConfig) : IRConfig := @IRList.rec IRConfig (fun (_ : IRList IRConfig) => IRConfig) (IRConfig.halted IROutcome.fuel_out) (fun (x : IRConfig) (_ : IRList IRConfig) (_ : IRConfig) => x) l

def ir_vcg_ctl (l : IRList IRConfig) : IRList IRConfig := @IRList.rec IRConfig (fun (_ : IRList IRConfig) => IRList IRConfig) (@IRList.nil IRConfig) (fun (_ : IRConfig) (rest : IRList IRConfig) (_ : IRList IRConfig) => rest) l

def ir_vcg_run_sound (m : IRModule) (env : VcgEnv) (mem : IRList IRMemSlot) (d : IRList Nat) (r : IRList IRFrame) (fs : IRList VcgFact) (hf : ir_vcg_facts_hold env mem fs) (T : IRList VcgStep) (hob : Eq (IRList IRConfig) (ir_vcg_lhs m env mem d r fs T) (ir_vcg_rhs m env mem d r fs T)) : ir_vcg_claim m env mem d r T :=
  @IRList.rec VcgStep
    (fun (T0 : IRList VcgStep) => Eq (IRList IRConfig) (ir_vcg_lhs m env mem d r fs T0) (ir_vcg_rhs m env mem d r fs T0) -> ir_vcg_claim m env mem d r T0)
    (fun (_ : Eq (IRList IRConfig) (@IRList.nil IRConfig) (@IRList.nil IRConfig)) => @Eq.refl IRConfig (IRConfig.halted IROutcome.fuel_out))
    (fun (st : VcgStep) (rest : IRList VcgStep) (ih : Eq (IRList IRConfig) (ir_vcg_lhs m env mem d r fs rest) (ir_vcg_rhs m env mem d r fs rest) -> ir_vcg_claim m env mem d r rest) (hob0 : Eq (IRList IRConfig) (ir_vcg_lhs m env mem d r fs (@IRList.cons VcgStep st rest)) (ir_vcg_rhs m env mem d r fs (@IRList.cons VcgStep st rest))) =>
      Eq.trans IRConfig (ir_steps (ir_vcg_slen st (ir_vcg_len rest)) m (IRConfig.running (ir_vcg_mden env mem d r (ir_vcg_start st)))) (ir_steps (ir_vcg_len rest) m (ir_vcg_adv m env mem d r st)) (ir_vcg_final env mem d r (@IRList.cons VcgStep st rest)) (ir_vcg_adv_steps m env mem d r st (ir_vcg_len rest))
      (Eq.subst IRConfig (fun (c : IRConfig) => Eq IRConfig (ir_steps (ir_vcg_len rest) m c) (ir_vcg_final env mem d r (@IRList.cons VcgStep st rest)))
        (ir_vcg_target env mem d r st rest) (ir_vcg_adv m env mem d r st)
        (Eq.symm IRConfig (ir_vcg_adv m env mem d r st) (ir_vcg_target env mem d r st rest)
          (ir_vcg_step_ok m env mem d r fs hf st (ir_vcg_target env mem d r st rest)
            (ir_eq_cong (IRList IRConfig) IRConfig ir_vcg_chd (ir_vcg_lhs m env mem d r fs (@IRList.cons VcgStep st rest)) (ir_vcg_rhs m env mem d r fs (@IRList.cons VcgStep st rest)) hob0)
            (ir_eq_cong (IRList IRConfig) IRConfig (fun (x : IRList IRConfig) => ir_vcg_chd (ir_vcg_ctl x)) (ir_vcg_lhs m env mem d r fs (@IRList.cons VcgStep st rest)) (ir_vcg_rhs m env mem d r fs (@IRList.cons VcgStep st rest)) hob0)))
        (ir_vcg_tail m env mem d r st rest (ih (ir_eq_cong (IRList IRConfig) (IRList IRConfig) (fun (x : IRList IRConfig) => ir_vcg_ctl (ir_vcg_ctl x)) (ir_vcg_lhs m env mem d r fs (@IRList.cons VcgStep st rest)) (ir_vcg_rhs m env mem d r fs (@IRList.cons VcgStep st rest)) hob0)))))
    T hob

-- == 4. CHECK AND CONTRACT GLUE: ir_vcg_check, ir_vcg_check_sound, and the call/return composition with the step-indexed contract device ==

def ir_vcg_safe_run (G : IROutcome -> Prop) (m : IRModule) (n : Nat) (k : Nat) (c0 : IRConfig) (c1 : IRConfig) (hrun : Eq IRConfig (ir_steps k m c0) c1) (hs : ir_safe G m n c1) : ir_safe G m n c0 := ir_safe_pad G m n k c0 (Eq.subst IRConfig (fun (x : IRConfig) => ir_safe G m n x) c1 (ir_steps k m c0) (Eq.symm IRConfig (ir_steps k m c0) c1 hrun) hs)

def ir_vcg_safe_call (m : IRModule) (E : IRList Nat -> IRList IRFrame -> IRMachine) (Q : IRList IRMemSlot -> Nat -> IRList IRScalar -> Prop) (n : Nat) (s : IRMachine) (d2 : IRList Nat) (r2 : IRList IRFrame) (hstep : Eq IRConfig (ir_step m s) (IRConfig.running (E d2 r2))) (hc : ir_ctr_at m E Q n) (G : IROutcome -> Prop) (hK : forall (mem2 : IRList IRMemSlot) (na2 : Nat) (vs : IRList IRScalar), Q mem2 na2 vs -> ir_safe G m n (ir_ret_to d2 r2 mem2 na2 vs)) : ir_safe G m n (IRConfig.running s) :=
  @Nat.rec (fun (k : Nat) => ir_ctr_at m E Q k -> (forall (mem2 : IRList IRMemSlot) (na2 : Nat) (vs : IRList IRScalar), Q mem2 na2 vs -> ir_safe G m k (ir_ret_to d2 r2 mem2 na2 vs)) -> ir_safe G m k (IRConfig.running s))
    (fun (_ : ir_ctr_at m E Q Nat.zero) (_ : forall (mem2 : IRList IRMemSlot) (na2 : Nat) (vs : IRList IRScalar), Q mem2 na2 vs -> ir_safe G m Nat.zero (ir_ret_to d2 r2 mem2 na2 vs)) => ir_safe_zero_running G m s)
    (fun (k : Nat) (_ : ir_ctr_at m E Q k -> (forall (mem2 : IRList IRMemSlot) (na2 : Nat) (vs : IRList IRScalar), Q mem2 na2 vs -> ir_safe G m k (ir_ret_to d2 r2 mem2 na2 vs)) -> ir_safe G m k (IRConfig.running s)) (hck : ir_ctr_at m E Q (Nat.succ k)) (hKk : forall (mem2 : IRList IRMemSlot) (na2 : Nat) (vs : IRList IRScalar), Q mem2 na2 vs -> ir_safe G m (Nat.succ k) (ir_ret_to d2 r2 mem2 na2 vs)) =>
      ir_safe_succ_running G m k s (Eq.subst IRConfig (fun (x : IRConfig) => ir_safe G m k x) (IRConfig.running (E d2 r2)) (ir_step m s) (Eq.symm IRConfig (ir_step m s) (IRConfig.running (E d2 r2)) hstep) (ir_safe_down G m k (IRConfig.running (E d2 r2)) (hck G d2 r2 hKk))))
    n hc hK

def ir_vcg_safe_call1 (m : IRModule) (E : IRList Nat -> IRList IRFrame -> IRMachine) (Q : IRList IRMemSlot -> Nat -> IRList IRScalar -> Prop) (n : Nat) (s : IRMachine) (d2 : IRList Nat) (r2 : IRList IRFrame) (hstep : Eq IRConfig (ir_step m s) (IRConfig.running (E d2 r2))) (hc : ir_ctr_at m E Q n) (G : IROutcome -> Prop) (hK : forall (mem2 : IRList IRMemSlot) (na2 : Nat) (vs : IRList IRScalar), Q mem2 na2 vs -> ir_safe G m n (ir_ret_to d2 r2 mem2 na2 vs)) : ir_safe G m (Nat.succ n) (IRConfig.running s) := ir_safe_succ_running G m n s (Eq.subst IRConfig (fun (x : IRConfig) => ir_safe G m n x) (IRConfig.running (E d2 r2)) (ir_step m s) (Eq.symm IRConfig (ir_step m s) (IRConfig.running (E d2 r2)) hstep) (hc G d2 r2 hK))

def ir_vcg_bindp (ps : IRList Nat) (vs : IRList VcgVal) (loc : IRList VcgBind) : IRList VcgBind := @IRList.rec Nat (fun (_ : IRList Nat) => IRList VcgVal -> IRList VcgBind) (fun (_ : IRList VcgVal) => loc) (fun (p : Nat) (_ : IRList Nat) (ih : IRList VcgVal -> IRList VcgBind) => fun (ws : IRList VcgVal) => @IRList.rec VcgVal (fun (_ : IRList VcgVal) => IRList VcgBind) loc (fun (w : VcgVal) (wrest : IRList VcgVal) (_ : IRList VcgBind) => @IRList.cons VcgBind (VcgBind.mk p w) (ih wrest)) ws) ps vs

def ir_vcg_resume (s : VcgMach) (rs : IRList Nat) (vals : IRList VcgVal) (na2 : VcgNat) : VcgMach := @VcgMach.rec (fun (_ : VcgMach) => VcgMach) (fun (fs : IRList VcgFrame) (_ : IRList VcgCell) (_ : VcgNat) => VcgMach.mk (@IRList.rec VcgFrame (fun (_ : IRList VcgFrame) => IRList VcgFrame) (@IRList.nil VcgFrame) (fun (f : VcgFrame) (rest : IRList VcgFrame) (_ : IRList VcgFrame) => @IRList.cons VcgFrame (@VcgFrame.rec (fun (_ : VcgFrame) => VcgFrame) (fun (fn : Nat) (bl : Nat) (pc : Nat) (loc : IRList VcgBind) (ds : IROption (IRList Nat)) => VcgFrame.mk fn bl (Nat.succ pc) (ir_vcg_bindp rs vals loc) ds) f) rest) fs) (@IRList.nil VcgCell) na2) s

def ir_vcg_last_start (T : IRList VcgStep) : VcgMach := @IRList.rec VcgStep (fun (_ : IRList VcgStep) => VcgMach) (VcgMach.mk (@IRList.nil VcgFrame) (@IRList.nil VcgCell) (VcgNat.lit Nat.zero)) (fun (st : VcgStep) (rest : IRList VcgStep) (ih : VcgMach) => @IRList.rec VcgStep (fun (_ : IRList VcgStep) => VcgMach) (ir_vcg_start st) (fun (_ : VcgStep) (_ : IRList VcgStep) (_ : VcgMach) => ih) rest) T

def ir_vcg_lastden (env : VcgEnv) (mem : IRList IRMemSlot) (d : IRList Nat) (r : IRList IRFrame) (T : IRList VcgStep) : IRMachine := ir_vcg_mden env mem d r (ir_vcg_last_start T)

def ir_vcg_obl_x (m : IRModule) (env : VcgEnv) (mem : IRList IRMemSlot) (d : IRList Nat) (r : IRList IRFrame) (fs : IRList VcgFact) (T : IRList VcgStep) : IRList IRConfig := @IRList.cons IRConfig (ir_vcg_start_cfg env mem d r T) (@IRList.cons IRConfig (ir_vcg_final env mem d r T) (ir_vcg_lhs m env mem d r fs T))

def ir_vcg_obl_c (m : IRModule) (env : VcgEnv) (mem : IRList IRMemSlot) (d : IRList Nat) (r : IRList IRFrame) (fs : IRList VcgFact) (T : IRList VcgStep) : IRList IRConfig := @IRList.cons IRConfig (ir_vcg_start_cfg env mem d r T) (@IRList.cons IRConfig (ir_vcg_final env mem d r T) (@IRList.cons IRConfig (ir_step m (ir_vcg_lastden env mem d r T)) (ir_vcg_lhs m env mem d r fs T)))

def ir_vcg_seg_exact (m : IRModule) (env : VcgEnv) (mem : IRList IRMemSlot) (d : IRList Nat) (r : IRList IRFrame) (fs : IRList VcgFact) (hf : ir_vcg_facts_hold env mem fs) (T : IRList VcgStep) (c0 : IRConfig) (c1 : IRConfig) (hob : Eq (IRList IRConfig) (ir_vcg_obl_x m env mem d r fs T) (@IRList.cons IRConfig c0 (@IRList.cons IRConfig c1 (ir_vcg_rhs m env mem d r fs T)))) : Eq IRConfig (ir_steps (ir_vcg_len T) m c0) c1 :=
  Eq.subst IRConfig (fun (x : IRConfig) => Eq IRConfig (ir_steps (ir_vcg_len T) m x) c1) (ir_vcg_start_cfg env mem d r T) c0
