def ir_vcg_fladder : IRList Nat := (IRList.cons Nat 32768 (IRList.cons Nat 16384 (IRList.cons Nat 8192 (IRList.cons Nat 4096 (IRList.cons Nat 2048 (IRList.cons Nat 1024 (IRList.cons Nat 512 (IRList.cons Nat 256 (IRList.cons Nat 128 (IRList.cons Nat 64 (IRList.cons Nat 32 (IRList.cons Nat 16 (IRList.cons Nat 8 (IRList.cons Nat 4 (IRList.cons Nat 2 (IRList.cons Nat 1 (IRList.nil Nat)))))))))))))))))

def ir_vcg_ftrie (l : IRList IRFunc) : IRBmTrie IRFunc := IRList.rec IRFunc (fun (_ : IRList IRFunc) => IRBmTrie IRFunc) (IRBmTrie.leaf IRFunc) (fun (f : IRFunc) (_ : IRList IRFunc) (ih : IRBmTrie IRFunc) => IRFunc.rec (fun (_ : IRFunc) => IRBmTrie IRFunc) (fun (i : Nat) (_ : IRList Nat) (_ : Nat) (_ : IRList IRBlock) => ir_bt_set IRFunc ir_vcg_fladder ih i i f) f) l

def ir_vcg_ftrie_find (l : IRList IRFunc) (k : Nat) : Eq (IROption IRFunc) (ir_bt_get IRFunc ir_vcg_fladder (ir_vcg_ftrie l) k k) (ir_func_find l k) := IRList.rec IRFunc (fun (l0 : IRList IRFunc) => Eq (IROption IRFunc) (ir_bt_get IRFunc ir_vcg_fladder (ir_vcg_ftrie l0) k k) (ir_func_find l0 k)) (ir_bt_get_leaf IRFunc ir_vcg_fladder k k) (fun (f : IRFunc) (rest : IRList IRFunc) (ih : Eq (IROption IRFunc) (ir_bt_get IRFunc ir_vcg_fladder (ir_vcg_ftrie rest) k k) (ir_func_find rest k)) => IRFunc.rec (fun (f0 : IRFunc) => Eq (IROption IRFunc) (ir_bt_get IRFunc ir_vcg_fladder (ir_vcg_ftrie (IRList.cons IRFunc f0 rest)) k k) (ir_func_find (IRList.cons IRFunc f0 rest) k)) (fun (i : Nat) (ps : IRList Nat) (e : Nat) (bs : IRList IRBlock) => Eq.trans (IROption IRFunc) (ir_bt_get IRFunc ir_vcg_fladder (ir_bt_set IRFunc ir_vcg_fladder (ir_vcg_ftrie rest) i i (IRFunc.mk i ps e bs)) k k) (Bool.rec (fun (_ : Bool) => IROption IRFunc) (ir_bt_get IRFunc ir_vcg_fladder (ir_vcg_ftrie rest) k k) (IROption.some IRFunc (IRFunc.mk i ps e bs)) (ir_nat_eqb i k)) (Bool.rec (fun (_ : Bool) => IROption IRFunc) (ir_func_find rest k) (IROption.some IRFunc (IRFunc.mk i ps e bs)) (ir_nat_eqb i k)) (ir_bt_get_set IRFunc ir_vcg_fladder (ir_vcg_ftrie rest) i k (IRFunc.mk i ps e bs)) (ir_eq_cong (IROption IRFunc) (IROption IRFunc) (fun (x : IROption IRFunc) => Bool.rec (fun (_ : Bool) => IROption IRFunc) x (IROption.some IRFunc (IRFunc.mk i ps e bs)) (ir_nat_eqb i k)) (ir_bt_get IRFunc ir_vcg_fladder (ir_vcg_ftrie rest) k k) (ir_func_find rest k) ih)) f) l

def ir_vcg_ffact (m : IRModule) (T : IRBmTrie IRFunc) (hT : Eq (IRBmTrie IRFunc) T (ir_vcg_ftrie (ir_mod_funcs m))) (k : Nat) (F : IRFunc) (hg : Eq (IROption IRFunc) (ir_bt_get IRFunc ir_vcg_fladder T k k) (IROption.some IRFunc F)) : Eq (IROption IRFunc) (ir_func_find (ir_mod_funcs m) k) (IROption.some IRFunc F) := Eq.trans (IROption IRFunc) (ir_func_find (ir_mod_funcs m) k) (ir_bt_get IRFunc ir_vcg_fladder (ir_vcg_ftrie (ir_mod_funcs m)) k k) (IROption.some IRFunc F) (Eq.symm (IROption IRFunc) (ir_bt_get IRFunc ir_vcg_fladder (ir_vcg_ftrie (ir_mod_funcs m)) k k) (ir_func_find (ir_mod_funcs m) k) (ir_vcg_ftrie_find (ir_mod_funcs m) k)) (Eq.subst (IRBmTrie IRFunc) (fun (t : IRBmTrie IRFunc) => Eq (IROption IRFunc) (ir_bt_get IRFunc ir_vcg_fladder t k k) (IROption.some IRFunc F)) T (ir_vcg_ftrie (ir_mod_funcs m)) hT hg)


def ir_vcg_safe_run (G : IROutcome -> Prop) (m : IRModule) (n : Nat) (k : Nat) (c0 : IRConfig) (c1 : IRConfig) (hrun : Eq IRConfig (ir_steps k m c0) c1) (hs : ir_safe G m n c1) : ir_safe G m n c0 := ir_safe_pad G m n k c0 (Eq.subst IRConfig (fun (x : IRConfig) => ir_safe G m n x) c1 (ir_steps k m c0) (Eq.symm IRConfig (ir_steps k m c0) c1 hrun) hs)

def ir_vcg_safe_call (m : IRModule) (E : IRList Nat -> IRList IRFrame -> IRMachine) (Q : IRList IRMemSlot -> Nat -> IRList IRScalar -> Prop) (n : Nat) (s : IRMachine) (d2 : IRList Nat) (r2 : IRList IRFrame) (hstep : Eq IRConfig (ir_step m s) (IRConfig.running (E d2 r2))) (hc : ir_ctr_at m E Q n) (G : IROutcome -> Prop) (hK : forall (mem2 : IRList IRMemSlot) (na2 : Nat) (vs : IRList IRScalar), Q mem2 na2 vs -> ir_safe G m n (ir_ret_to d2 r2 mem2 na2 vs)) : ir_safe G m n (IRConfig.running s) :=
  Nat.rec (fun (k : Nat) => ir_ctr_at m E Q k -> (forall (mem2 : IRList IRMemSlot) (na2 : Nat) (vs : IRList IRScalar), Q mem2 na2 vs -> ir_safe G m k (ir_ret_to d2 r2 mem2 na2 vs)) -> ir_safe G m k (IRConfig.running s))
    (fun (_ : ir_ctr_at m E Q Nat.zero) (_ : forall (mem2 : IRList IRMemSlot) (na2 : Nat) (vs : IRList IRScalar), Q mem2 na2 vs -> ir_safe G m Nat.zero (ir_ret_to d2 r2 mem2 na2 vs)) => ir_safe_zero_running G m s)
    (fun (k : Nat) (_ : ir_ctr_at m E Q k -> (forall (mem2 : IRList IRMemSlot) (na2 : Nat) (vs : IRList IRScalar), Q mem2 na2 vs -> ir_safe G m k (ir_ret_to d2 r2 mem2 na2 vs)) -> ir_safe G m k (IRConfig.running s)) (hck : ir_ctr_at m E Q (Nat.succ k)) (hKk : forall (mem2 : IRList IRMemSlot) (na2 : Nat) (vs : IRList IRScalar), Q mem2 na2 vs -> ir_safe G m (Nat.succ k) (ir_ret_to d2 r2 mem2 na2 vs)) =>
      ir_safe_succ_running G m k s (Eq.subst IRConfig (fun (x : IRConfig) => ir_safe G m k x) (IRConfig.running (E d2 r2)) (ir_step m s) (Eq.symm IRConfig (ir_step m s) (IRConfig.running (E d2 r2)) hstep) (ir_safe_down G m k (IRConfig.running (E d2 r2)) (hck G d2 r2 hKk))))
    n hc hK

def ir_vcg_safe_call1 (m : IRModule) (E : IRList Nat -> IRList IRFrame -> IRMachine) (Q : IRList IRMemSlot -> Nat -> IRList IRScalar -> Prop) (n : Nat) (s : IRMachine) (d2 : IRList Nat) (r2 : IRList IRFrame) (hstep : Eq IRConfig (ir_step m s) (IRConfig.running (E d2 r2))) (hc : ir_ctr_at m E Q n) (G : IROutcome -> Prop) (hK : forall (mem2 : IRList IRMemSlot) (na2 : Nat) (vs : IRList IRScalar), Q mem2 na2 vs -> ir_safe G m n (ir_ret_to d2 r2 mem2 na2 vs)) : ir_safe G m (Nat.succ n) (IRConfig.running s) := ir_safe_succ_running G m n s (Eq.subst IRConfig (fun (x : IRConfig) => ir_safe G m n x) (IRConfig.running (E d2 r2)) (ir_step m s) (Eq.symm IRConfig (ir_step m s) (IRConfig.running (E d2 r2)) hstep) (hc G d2 r2 hK))

def ir_vcg_bindp (ps : IRList Nat) (vs : IRList QV) (loc : IRList QB) : IRList QB := IRList.rec Nat (fun (_ : IRList Nat) => IRList QV -> IRList QB) (fun (_ : IRList QV) => loc) (fun (p : Nat) (_ : IRList Nat) (ih : IRList QV -> IRList QB) => fun (ws : IRList QV) => IRList.rec QV (fun (_ : IRList QV) => IRList QB) loc (fun (w : QV) (wrest : IRList QV) (_ : IRList QB) => IRList.cons QB (QB.m p w) (ih wrest)) ws) ps vs

def ir_vcg_last_start (T : IRList QS) : QM := IRList.rec QS (fun (_ : IRList QS) => QM) (QM.m (IRList.nil QR) (IRList.nil QC) (QN.l Nat.zero)) (fun (st : QS) (rest : IRList QS) (ih : QM) => IRList.rec QS (fun (_ : IRList QS) => QM) (ir_vcg_start st) (fun (_ : QS) (_ : IRList QS) (_ : QM) => ih) rest) T

def ir_vcg_lastden (env : QE) (mem : IRList IRMemSlot) (d : IRList Nat) (r : IRList IRFrame) (T : IRList QS) : IRMachine := ir_vcg_mden env mem d r (ir_vcg_last_start T)

def ir_vcg_ext1_k (mem : IRList IRMemSlot) (na : Nat) (x : IRScalar) (K : IRList IRMemSlot -> Nat -> IRList IRScalar -> Prop) (h : forall (mem2 : IRList IRMemSlot) (na2 : Nat), MemExt mem na mem2 na2 -> K mem2 na2 (ir_vl1 x)) (mem2 : IRList IRMemSlot) (na2 : Nat) (vs : IRList IRScalar) (hq : forall (C : Prop), (MemExt mem na mem2 na2 -> Eq (IRList IRScalar) vs (ir_vl1 x) -> C) -> C) : K mem2 na2 vs := hq (K mem2 na2 vs) (fun (e : MemExt mem na mem2 na2) (hv : Eq (IRList IRScalar) vs (ir_vl1 x)) => Eq.subst (IRList IRScalar) (fun (y : IRList IRScalar) => K mem2 na2 y) (ir_vl1 x) vs (Eq.symm (IRList IRScalar) vs (ir_vl1 x) hv) (h mem2 na2 e))

def ir_vcg_fhd (fs : IRList QF) : QF := IRList.rec QF (fun (_ : IRList QF) => QF) (QF.t (QN.l Nat.zero) (QN.l Nat.zero)) (fun (f : QF) (_ : IRList QF) (_ : QF) => f) fs

def ir_vcg_ftl (fs : IRList QF) : IRList QF := IRList.rec QF (fun (_ : IRList QF) => IRList QF) (IRList.nil QF) (fun (_ : QF) (t : IRList QF) (_ : IRList QF) => t) fs

def ir_vcg_facts_intro (env : QE) (mem : IRList IRMemSlot) (fs : IRList QF) : ir_vcg_fact_holds env mem (ir_vcg_fhd fs) -> ir_vcg_facts_hold env mem (ir_vcg_ftl fs) -> ir_vcg_facts_hold env mem fs := IRList.rec QF (fun (x : IRList QF) => ir_vcg_fact_holds env mem (ir_vcg_fhd x) -> ir_vcg_facts_hold env mem (ir_vcg_ftl x) -> ir_vcg_facts_hold env mem x) (fun (_ : ir_vcg_fact_holds env mem (ir_vcg_fhd (IRList.nil QF))) (_ : ir_vcg_facts_hold env mem (ir_vcg_ftl (IRList.nil QF))) => Eq.refl Bool Bool.true) (fun (f : QF) (t : IRList QF) (_ : ir_vcg_fact_holds env mem (ir_vcg_fhd t) -> ir_vcg_facts_hold env mem (ir_vcg_ftl t) -> ir_vcg_facts_hold env mem t) (h : ir_vcg_fact_holds env mem f) (tl : ir_vcg_facts_hold env mem t) => fun (C : Prop) (k : ir_vcg_fact_holds env mem f -> ir_vcg_facts_hold env mem t -> C) => k h tl) fs

def ir_vcg_look (mem : IRList IRMemSlot) (a : Nat) (v : IRScalar) : Prop := Eq (IROption IRMemSlot) (ir_mem_lookup mem a) (IROption.some IRMemSlot (IRMemSlot.mk a v Bool.true))

def ir_vcg_ltt (a : Nat) (na : Nat) : Prop := Eq Bool (ir_nat_ltb a na) Bool.true

def ir_vcg_exact_k (mX : IRList IRMemSlot) (nX : Nat) (vX : IRList IRScalar) (K : IRList IRMemSlot -> Nat -> IRList IRScalar -> Prop) (h : K mX nX vX) (mem2 : IRList IRMemSlot) (na2 : Nat) (vs : IRList IRScalar) (hq : ir_post_exact mX nX vX mem2 na2 vs) : K mem2 na2 vs := hq K h

def ir_vcg_live (mem : IRList IRMemSlot) (na : Nat) (s : IRScalar) : Prop := forall (mx : IRList IRMemSlot) (nx : Nat), MemExt mem na mx nx -> Eq IRStepResult (ir_borrow_eval mx s) (IRStepResult.value s)

