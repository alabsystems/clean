(assume h (not (forall ((snd (-> P Int))) (= (snd (mk a b)) b))))
(anchor :step s :args ((snd (-> P Int))))
(step s.t1 (cl (= (snd (mk a b)) b)) :rule dt_project)
(step s.t2 (cl (= (= (snd (mk a b)) b) (= b b))) :rule cong :premises (s.t1))
(step s (cl (= (forall ((snd (-> P Int))) (= (snd (mk a b)) b)) (forall ((snd (-> P Int))) (= b b)))) :rule bind)
(step t1 (cl (= (forall ((snd (-> P Int))) (= b b)) (= b b))) :rule qnt_rm_unused)
(step t2 (cl (= (forall ((snd (-> P Int))) (= (snd (mk a b)) b)) (= b b))) :rule trans :premises (s t1))
(step t3 (cl (= b b)) :rule eq_reflexive)
(step t4 (cl (not (= (forall ((snd (-> P Int))) (= (snd (mk a b)) b)) (= b b))) (forall ((snd (-> P Int))) (= (snd (mk a b)) b)) (not (= b b))) :rule equiv_pos1)
(step t5 (cl) :rule resolution :premises (h t2 t3 t4))
