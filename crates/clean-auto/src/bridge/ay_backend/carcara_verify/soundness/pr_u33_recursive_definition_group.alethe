(assume a0 (forall ((n Int)) (= (f n) (+ (g n) 1))))
(assume a1 (forall ((n Int)) (= (g n) (f n))))
(step t1 (cl (or (not (forall ((n Int)) (= (f n) (+ (g n) 1)))) (= (f 0) (+ (g 0) 1)))) :rule forall_inst :args (0))
(step t2 (cl (not (forall ((n Int)) (= (f n) (+ (g n) 1)))) (= (f 0) (+ (g 0) 1))) :rule or :premises (t1))
(step t3 (cl (= (f 0) (+ (g 0) 1))) :rule resolution :premises (t2 a0))
(step t4 (cl (or (not (forall ((n Int)) (= (g n) (f n)))) (= (g 0) (f 0)))) :rule forall_inst :args (0))
(step t5 (cl (not (forall ((n Int)) (= (g n) (f n)))) (= (g 0) (f 0))) :rule or :premises (t4))
(step t6 (cl (= (g 0) (f 0))) :rule resolution :premises (t5 a1))
(step t7 (cl (not (= (f 0) (+ (g 0) 1))) (not (= (g 0) (f 0)))) :rule la_generic :args (1 1))
(step t8 (cl) :rule resolution :premises (t3 t6 t7))
