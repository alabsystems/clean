(assume a0 (let ((|false| true)) |false|))
(step t1 (cl (= (let ((|false| true)) |false|) false)) :rule evaluate)
(step t2 (cl (not (= (let ((|false| true)) |false|) false)) (not (let ((|false| true)) |false|)) false) :rule equiv_pos2)
(step t3 (cl (not false)) :rule false)
(step t4 (cl) :rule resolution :premises (t2 t1 a0 t3))
