leg_paragon_ratchet()                   { scripts/paragon_ratchet.sh; }
leg_isabelle_ops_portability()          { "$PY" scripts/test_isabelle_ops_portability.py; }
leg_aristotle_corpus_static()           { "$PY" scripts/aristotle_corpus_gate.py --fast; }
leg_trust_ir_axes_selftest()            { "$PY" scripts/trust_ir_axes.py selftest; }

# Declared leg order. check_hook_coverage.py reads this block by its markers,
# so keep the two `# HOOK-LEGS` lines exactly as they are.
# HOOK-LEGS BEGIN
HOOK_LEGS="
gate-registry
cargo-test-selectors
doc-claims
suite-journal
dep-boundary
lint-coverage
fmt-changed
no-ignored-tests
ratchet-surfaces
extend-constants-ratchet
add-decl-ratchet
env-bypass-census
spine-scoreboard-ratchet
trust-verdict-emitters
tcb-target-ratchet
prelude-collision-ratchet
prelude-instance-priority-ratchet
source-elab-ratchet-artifact
silent-tactic-ratchet
g-auto-static
g-simp-static
trustcore-evidence-staleness
crystal-revalidation-scope
crystal-enum-tag-pin
a0a6-probe-transcription
paragon-ratchet
isabelle-ops-portability
aristotle-corpus-static
trust-ir-axes-selftest
"
# HOOK-LEGS END

# ------------------------------------------------------- leg 0: the anti-drift
# First, and fail-closed, because everything below is only as trustworthy as the
# claim that it still covers what it says it covers. A missing checker is a
# state in which the subset could silently shrink to nothing, so it is a refusal
# and not a shrug.
COVERAGE_CHECKER="scripts/check_hook_coverage.py"
echo "=== clean pre-push (narrow gate; no cargo, no build) ==="
if [ -f "$COVERAGE_CHECKER" ]; then
  cov_out="$("$PY" "$COVERAGE_CHECKER" 2>&1)"; cov_rc=$?
else
  cov_out="clean pre-push: $COVERAGE_CHECKER is missing -- the hook can no longer prove it covers the gate"
  cov_rc=1
fi
if [ "$cov_rc" -ne 0 ]; then
  printf '%s\n' "$cov_out" >&2
  echo >&2
  echo "PRE-PUSH: RED (hook coverage)." >&2
  exit 1
fi
printf '%s\n' "$cov_out"

# ------------------------------------------------------------ waiver table read
TODAY="$(date -u +%Y-%m-%d)"
POLICY="scripts/githooks/gate-legs.txt"
waived_status_of() {  # id -> "expires|owner|reason" for a WAIVED row, else empty
  # Six fields since 2026-08-25: <status> | <mode> | <leg-id> | <owner> |
  # <expires> | <reason>. MODE (both|full) is the local_gate.sh axis and is
  # re-derived by check_hook_coverage.py; this hook only needs STATUS and the
  # waiver fields, but it must count columns correctly or every WAIVED row
  # silently stops being found -- which would turn a printed, owned, expiring
  # red back into an invisible one.
  awk -F'|' -v want="$1" '
    { line=$0; sub(/^[ \t]+/,"",line) }
    line ~ /^#/ || line == "" { next }
    NF < 6 { next }
    { s=$1; id=$3; o=$4; e=$5; r=$6
      gsub(/^[ \t]+|[ \t]+$/,"",s); gsub(/^[ \t]+|[ \t]+$/,"",id)
      gsub(/^[ \t]+|[ \t]+$/,"",o); gsub(/^[ \t]+|[ \t]+$/,"",e)
      gsub(/^[ \t]+|[ \t]+$/,"",r)
      if (s == "WAIVED" && id == want) { print e "|" o "|" r; exit } }
  ' "$POLICY" 2>/dev/null
}

# ------------------------------------------------------------------- run them
BLOCKING=""
WAIVED_RED=""
STALE_WAIVERS=""
T0="$("$PY" -c 'import time;print(time.time())')"
ls0="$T0"
for leg in $HOOK_LEGS; do
  fn="leg_${leg//-/_}"
  if ! type "$fn" >/dev/null 2>&1; then
    BLOCKING="${BLOCKING}
  x ${leg}: declared in HOOK_LEGS but no ${fn}() exists"
    continue
  fi
  # ls0 is the previous leg's end stamp, so each leg costs ONE `python -c`
  # rather than two. Twenty legs, twenty interpreter starts saved -- about a
  # second of the hook's own budget, which a gate has no business spending on
  # measuring itself.
  out="$("$fn" 2>&1)"; rc=$?
  ls1="$("$PY" -c 'import time;print(time.time())')"
  secs="$("$PY" -c "print(f'{$ls1-$ls0:.2f}')")"
  ls0="$ls1"
  wrow="$(waived_status_of "$leg")"
  if [ "$rc" -eq 0 ]; then
    printf '  ok   %-34s %6ss\n' "$leg" "$secs"
    if [ -n "$wrow" ]; then
      exp="${wrow%%|*}"
      if [ -n "$exp" ] && [[ ! "$exp" < "$TODAY" ]]; then
        STALE_WAIVERS="${STALE_WAIVERS}
  x ${leg} passes again -- delete its WAIVED row from ${POLICY}"
      fi
    fi
    continue
  fi
  if [ -n "$wrow" ]; then
    exp="${wrow%%|*}"; rest="${wrow#*|}"; own="${rest%%|*}"; rea="${rest#*|}"
    if [ -n "$exp" ] && [[ ! "$exp" < "$TODAY" ]]; then
      printf '  ~    %-34s %6ss  WAIVED until %s by %s\n' "$leg" "$secs" "$exp" "$own"
      WAIVED_RED="${WAIVED_RED}
  ~ ${leg} (until ${exp}, ${own}): ${rea}
$(printf '%s\n' "$out" | sed 's/^/      | /')"
      continue
    fi
    printf '  FAIL %-34s %6ss  waiver EXPIRED %s\n' "$leg" "$secs" "${exp:-<no date>}"
    BLOCKING="${BLOCKING}
  x ${leg}: its waiver EXPIRED on ${exp:-<no date>} (owner ${own}) and no longer applies
$(printf '%s\n' "$out" | sed 's/^/      | /')"
    continue
  fi
  printf '  FAIL %-34s %6ss\n' "$leg" "$secs"
  BLOCKING="${BLOCKING}
  x ${leg}
$(printf '%s\n' "$out" | sed 's/^/      | /')"
done
T1="$("$PY" -c 'import time;print(time.time())')"
TOTAL="$("$PY" -c "print(f'{$T1-$T0:.2f}')")"

if [ -n "$WAIVED_RED" ]; then
  echo
  echo "WAIVED -- red, but owned and expiring, and this push did not cause it:"
  printf '%s\n' "$WAIVED_RED"
fi
if [ -n "$STALE_WAIVERS" ]; then
  echo
  echo "FAIL: a waiver is no longer needed."
  printf '%s\n' "$STALE_WAIVERS"
fi
if [ -n "$BLOCKING" ]; then
  echo
  echo "FAIL: a fail-closed gate leg refused this tree."
  printf '%s\n' "$BLOCKING"
fi

if [ -z "$BLOCKING" ] && [ -z "$STALE_WAIVERS" ]; then
  echo
  echo "PRE-PUSH: GREEN in ${TOTAL}s (${PY}). Legs excluded on cost still run in"
  echo "  scripts/local_gate.sh -- four of them in --fast too; each row's MODE"
  echo "  column says which. See ${POLICY}."
  exit 0
fi
echo
echo "PRE-PUSH: RED in ${TOTAL}s."
echo "'git push --no-verify' skips this hook and leaves no record of why."
exit 1
