def ir_vcg_borrowf_ok (m : IRModule) (sf : IRMachine -> IRConfig) (env : QE) (mem : IRList IRMemSlot) (sm : IRMachine) (rs : IRList Nat) (tg : IRConfig) (f : QF) (hfa : ir_vcg_fact_holds env mem f) (K0 : IRConfig) (hK : Eq IRConfig K0 (sf sm)) (h1 : Eq IRConfig (ir_vcg_bf_l1 m sf env mem sm rs f) (ir_vcg_bf_r1 m env mem sm rs f)) (h2 : Eq IRConfig (ir_vcg_bf_l2 env sm rs f) (ir_vcg_bf_r2 tg f)) : Eq IRConfig K0 tg :=
  Eq.trans IRConfig K0 (sf sm) tg hK (QF.rec
    (fun (f0 : QF) => ir_vcg_fact_holds env mem f0 -> Eq IRConfig (ir_vcg_bf_l1 m sf env mem sm rs f0) (ir_vcg_bf_r1 m env mem sm rs f0) -> Eq IRConfig (ir_vcg_bf_l2 env sm rs f0) (ir_vcg_bf_r2 tg f0) -> Eq IRConfig (sf sm) tg)
    (fun (x : QN) (v : QV) (lv : Bool) (_ : ir_vcg_fact_holds env mem (QF.k x v lv)) (h1n : Eq IRConfig (IRConfig.halted IROutcome.fuel_out) (IRConfig.halted (IROutcome.stuck IRFault.no_frame))) (_ : Eq IRConfig (IRConfig.halted IROutcome.fuel_out) (IRConfig.halted (IROutcome.stuck IRFault.no_frame))) => ir_vcg_cfg_ne h1n (Eq IRConfig (sf sm) tg))
    (fun (x : QN) (y : QN) (_ : ir_vcg_fact_holds env mem (QF.t x y)) (h1n : Eq IRConfig (IRConfig.halted IROutcome.fuel_out) (IRConfig.halted (IROutcome.stuck IRFault.no_frame))) (_ : Eq IRConfig (IRConfig.halted IROutcome.fuel_out) (IRConfig.halted (IROutcome.stuck IRFault.no_frame))) => ir_vcg_cfg_ne h1n (Eq IRConfig (sf sm) tg))
    (fun (pre : IRList QC) (a : QN) (hb : Eq IRStepResult (ir_borrow_eval (ir_vcg_memden env pre mem) (IRScalar.ptr_ (ir_vcg_nden env a))) (IRStepResult.value (IRScalar.ptr_ (ir_vcg_nden env a)))) (h1s : Eq IRConfig (sf sm) (ir_bind_result sm rs (ir_borrow_eval (ir_vcg_memden env pre mem) (IRScalar.ptr_ (ir_vcg_nden env a))))) (h2s : Eq IRConfig (ir_bind_result sm rs (IRStepResult.value (IRScalar.ptr_ (ir_vcg_nden env a)))) tg) =>
      Eq.trans IRConfig (sf sm) (ir_bind_result sm rs (ir_borrow_eval (ir_vcg_memden env pre mem) (IRScalar.ptr_ (ir_vcg_nden env a)))) tg h1s
        (Eq.trans IRConfig (ir_bind_result sm rs (ir_borrow_eval (ir_vcg_memden env pre mem) (IRScalar.ptr_ (ir_vcg_nden env a)))) (ir_bind_result sm rs (IRStepResult.value (IRScalar.ptr_ (ir_vcg_nden env a)))) tg
          (ir_eq_cong IRStepResult IRConfig (fun (x : IRStepResult) => ir_bind_result sm rs x) (ir_borrow_eval (ir_vcg_memden env pre mem) (IRScalar.ptr_ (ir_vcg_nden env a))) (IRStepResult.value (IRScalar.ptr_ (ir_vcg_nden env a))) hb)
          h2s)) (fun (i : Nat) (j : Nat) (M : Nat) (_ : ir_vcg_fact_holds env mem (QF.s i j M)) (h1n : Eq IRConfig (IRConfig.halted IROutcome.fuel_out) (IRConfig.halted (IROutcome.stuck IRFault.no_frame))) (_ : Eq IRConfig (IRConfig.halted IROutcome.fuel_out) (IRConfig.halted (IROutcome.stuck IRFault.no_frame))) => ir_vcg_cfg_ne h1n (Eq IRConfig (sf sm) tg))
    f hfa h1 h2)

-- == 3. MACHINE AND STEPS: symbolic frames/machines, the step kinds, the per-step obligations, and the run's soundness ==

inductive QB : Type
| m : Nat -> QV -> QB

def ir_vcg_locden (env : QE) (l : IRList QB) : IRList IRBinding := IRList.rec QB (fun (_ : IRList QB) => IRList IRBinding) (IRList.nil IRBinding) (fun (b : QB) (_ : IRList QB) (ih : IRList IRBinding) => IRList.cons IRBinding (QB.rec (fun (_ : QB) => IRBinding) (fun (i : Nat) (v : QV) => IRBinding.mk i (ir_vcg_vden env v)) b) ih) l

inductive QR : Type
| m : Nat -> Nat -> Nat -> IRList QB -> IROption (IRList Nat) -> QR

def ir_vcg_fden (env : QE) (d : IRList Nat) (f : QR) : IRFrame := QR.rec (fun (_ : QR) => IRFrame) (fun (fn : Nat) (bl : Nat) (pc : Nat) (loc : IRList QB) (ds : IROption (IRList Nat)) => IRFrame.mk fn bl pc (ir_vcg_locden env loc) (IROption.rec (IRList Nat) (fun (_ : IROption (IRList Nat)) => IRList Nat) d (fun (x : IRList Nat) => x) ds)) f

def ir_vcg_framesden (env : QE) (d : IRList Nat) (r : IRList IRFrame) (fs : IRList QR) : IRList IRFrame := IRList.rec QR (fun (_ : IRList QR) => IRList IRFrame) r (fun (f : QR) (_ : IRList QR) (ih : IRList IRFrame) => IRList.cons IRFrame (ir_vcg_fden env d f) ih) fs

inductive QM : Type
| m : IRList QR -> IRList QC -> QN -> QM

def ir_vcg_mden (env : QE) (mem : IRList IRMemSlot) (d : IRList Nat) (r : IRList IRFrame) (s : QM) : IRMachine := QM.rec (fun (_ : QM) => IRMachine) (fun (fs : IRList QR) (fresh : IRList QC) (na : QN) => IRMachine.mk (ir_vcg_framesden env d r fs) (ir_vcg_memden env fresh mem) (ir_vcg_nden env na)) s

def ir_vcg_mfresh (s : QM) : IRList QC := QM.rec (fun (_ : QM) => IRList QC) (fun (_ : IRList QR) (fresh : IRList QC) (_ : QN) => fresh) s

inductive QS : Type
| p : QM -> QS
| l : QM -> IRList Nat -> IRTy -> QN -> QS
| bl : QM -> IRList Nat -> QN -> QS
| bf : QM -> IRList Nat -> Nat -> QS
| s : QM -> QN -> QV -> QS
| x : QM -> IRList QC -> QN -> IRList QV -> QS
| t : QM -> QS
| c : QM -> IRList Nat -> QN -> QN -> QS

def ir_vcg_start (st : QS) : QM := QS.rec (fun (_ : QS) => QM) (fun (s : QM) => s) (fun (s : QM) (_ : IRList Nat) (_ : IRTy) (_ : QN) => s) (fun (s : QM) (_ : IRList Nat) (_ : QN) => s) (fun (s : QM) (_ : IRList Nat) (_ : Nat) => s) (fun (s : QM) (_ : QN) (_ : QV) => s) (fun (s : QM) (_ : IRList QC) (_ : QN) (_ : IRList QV) => s) (fun (s : QM) => s) (fun (s : QM) (_ : IRList Nat) (_ : QN) (_ : QN) => s) st

def ir_vcg_end_cfg (env : QE) (mem : IRList IRMemSlot) (d : IRList Nat) (r : IRList IRFrame) (st : QS) : IRConfig := QS.rec (fun (_ : QS) => IRConfig) (fun (_ : QM) => IRConfig.halted IROutcome.fuel_out) (fun (_ : QM) (_ : IRList Nat) (_ : IRTy) (_ : QN) => IRConfig.halted IROutcome.fuel_out) (fun (_ : QM) (_ : IRList Nat) (_ : QN) => IRConfig.halted IROutcome.fuel_out) (fun (_ : QM) (_ : IRList Nat) (_ : Nat) => IRConfig.halted IROutcome.fuel_out) (fun (_ : QM) (_ : QN) (_ : QV) => IRConfig.halted IROutcome.fuel_out) (fun (_ : QM) (fr : IRList QC) (na : QN) (vals : IRList QV) => ir_ret_to d r (ir_vcg_memden env fr mem) (ir_vcg_nden env na) (ir_vcg_vlden env vals)) (fun (s : QM) => IRConfig.running (ir_vcg_mden env mem d r s)) (fun (_ : QM) (_ : IRList Nat) (_ : QN) (_ : QN) => IRConfig.halted IROutcome.fuel_out) st

def ir_vcg_target (env : QE) (mem : IRList IRMemSlot) (d : IRList Nat) (r : IRList IRFrame) (st : QS) (rest : IRList QS) : IRConfig := IRList.rec QS (fun (_ : IRList QS) => IRConfig) (ir_vcg_end_cfg env mem d r st) (fun (st2 : QS) (_ : IRList QS) (_ : IRConfig) => IRConfig.running (ir_vcg_mden env mem d r (ir_vcg_start st2))) rest

def ir_vcg_l1 (m : IRModule) (sf : IRMachine -> IRConfig) (env : QE) (mem : IRList IRMemSlot) (d : IRList Nat) (r : IRList IRFrame) (fs : IRList QF) (st : QS) : IRConfig := QS.rec (fun (_ : QS) => IRConfig)
  (fun (s : QM) => sf (ir_vcg_mden env mem d r s))
  (fun (s : QM) (rs : IRList Nat) (t : IRTy) (a : QN) => ir_vcg_oL QC (ir_vcg_lookup fs (ir_vcg_mfresh s) a) (fun (_ : QC) => sf (ir_vcg_mden env mem d r s)))
  (fun (s : QM) (rs : IRList Nat) (a : QN) => ir_vcg_oL QC (ir_vcg_lookup fs (ir_vcg_mfresh s) a) (fun (_ : QC) => sf (ir_vcg_mden env mem d r s)))
  (fun (s : QM) (rs : IRList Nat) (j : Nat) => ir_vcg_bf_l1 m sf env mem (ir_vcg_mden env mem d r s) rs (ir_vcg_fact_at fs j))
  (fun (s : QM) (a : QN) (v : QV) => ir_vcg_oL QC (ir_vcg_lookup fs (ir_vcg_mfresh s) a) (fun (_ : QC) => ir_vcg_oL (IRList QC) (ir_vcg_update fs (ir_vcg_mfresh s) a v) (fun (_ : IRList QC) => sf (ir_vcg_mden env mem d r s))))
  (fun (s : QM) (_ : IRList QC) (_ : QN) (_ : IRList QV) => sf (ir_vcg_mden env mem d r s))
  (fun (s : QM) => IRConfig.running (ir_vcg_mden env mem d r s)) (fun (s : QM) (rs : IRList Nat) (x : QN) (y : QN) => ir_vcg_oL Bool (ir_vcg_cmpd fs x y) (fun (_ : Bool) => sf (ir_vcg_mden env mem d r s))) st

def ir_vcg_r1 (m : IRModule) (env : QE) (mem : IRList IRMemSlot) (d : IRList Nat) (r : IRList IRFrame) (fs : IRList QF) (st : QS) (tg : IRConfig) : IRConfig := QS.rec (fun (_ : QS) => IRConfig)
  (fun (_ : QM) => tg)
  (fun (s : QM) (rs : IRList Nat) (t : IRTy) (a : QN) => ir_vcg_oR QC (ir_vcg_lookup fs (ir_vcg_mfresh s) a) (fun (_ : QC) => ir_vcg_r_load m (ir_vcg_mden env mem d r s) rs t (ir_mem_lookup (ir_vcg_memden env (ir_vcg_mfresh s) mem) (ir_vcg_nden env a))))
  (fun (s : QM) (rs : IRList Nat) (a : QN) => ir_vcg_oR QC (ir_vcg_lookup fs (ir_vcg_mfresh s) a) (fun (_ : QC) => ir_vcg_r_borrow (ir_vcg_mden env mem d r s) rs (ir_vcg_nden env a) (ir_mem_lookup (ir_vcg_memden env (ir_vcg_mfresh s) mem) (ir_vcg_nden env a))))
  (fun (s : QM) (rs : IRList Nat) (j : Nat) => ir_vcg_bf_r1 m env mem (ir_vcg_mden env mem d r s) rs (ir_vcg_fact_at fs j))
  (fun (s : QM) (a : QN) (v : QV) => ir_vcg_oR QC (ir_vcg_lookup fs (ir_vcg_mfresh s) a) (fun (_ : QC) => ir_vcg_oR (IRList QC) (ir_vcg_update fs (ir_vcg_mfresh s) a v) (fun (_ : IRList QC) => ir_vcg_r_store (ir_vcg_mden env mem d r s) (ir_mem_lookup (ir_vcg_memden env (ir_vcg_mfresh s) mem) (ir_vcg_nden env a)) (ir_mem_update (ir_vcg_memden env (ir_vcg_mfresh s) mem) (ir_vcg_nden env a) (ir_vcg_vden env v)))))
  (fun (_ : QM) (_ : IRList QC) (_ : QN) (_ : IRList QV) => tg)
  (fun (_ : QM) => tg) (fun (s : QM) (rs : IRList Nat) (x : QN) (y : QN) => ir_vcg_oR Bool (ir_vcg_cmpd fs x y) (fun (_ : Bool) => ir_vcg_r_cmp (ir_vcg_mden env mem d r s) rs (ir_nat_eqb (ir_vcg_nden env x) (ir_vcg_nden env y)))) st

def ir_vcg_l2 (m : IRModule) (env : QE) (mem : IRList IRMemSlot) (d : IRList Nat) (r : IRList IRFrame) (fs : IRList QF) (st : QS) : IRConfig := QS.rec (fun (_ : QS) => IRConfig)
  (fun (_ : QM) => IRConfig.halted IROutcome.fuel_out)
  (fun (s : QM) (rs : IRList Nat) (t : IRTy) (a : QN) => ir_vcg_oL QC (ir_vcg_lookup fs (ir_vcg_mfresh s) a) (fun (c : QC) => ir_vcg_r_load m (ir_vcg_mden env mem d r s) rs t (IROption.some IRMemSlot (ir_vcg_cden env c))))
  (fun (s : QM) (rs : IRList Nat) (a : QN) => ir_vcg_oL QC (ir_vcg_lookup fs (ir_vcg_mfresh s) a) (fun (c : QC) => ir_vcg_r_borrow (ir_vcg_mden env mem d r s) rs (ir_vcg_nden env a) (IROption.some IRMemSlot (ir_vcg_cden env c))))
  (fun (s : QM) (rs : IRList Nat) (j : Nat) => ir_vcg_bf_l2 env (ir_vcg_mden env mem d r s) rs (ir_vcg_fact_at fs j))
  (fun (s : QM) (a : QN) (v : QV) => ir_vcg_oL QC (ir_vcg_lookup fs (ir_vcg_mfresh s) a) (fun (c : QC) => ir_vcg_oL (IRList QC) (ir_vcg_update fs (ir_vcg_mfresh s) a v) (fun (fr2 : IRList QC) => ir_vcg_r_store (ir_vcg_mden env mem d r s) (IROption.some IRMemSlot (ir_vcg_cden env c)) (ir_vcg_memden env fr2 mem))))
  (fun (_ : QM) (_ : IRList QC) (_ : QN) (_ : IRList QV) => IRConfig.halted IROutcome.fuel_out)
  (fun (_ : QM) => IRConfig.halted IROutcome.fuel_out) (fun (s : QM) (rs : IRList Nat) (x : QN) (y : QN) => ir_vcg_oL Bool (ir_vcg_cmpd fs x y) (fun (b : Bool) => ir_vcg_r_cmp (ir_vcg_mden env mem d r s) rs b)) st

def ir_vcg_r2 (fs : IRList QF) (st : QS) (tg : IRConfig) : IRConfig := QS.rec (fun (_ : QS) => IRConfig)
  (fun (_ : QM) => IRConfig.halted IROutcome.fuel_out)
  (fun (s : QM) (_ : IRList Nat) (_ : IRTy) (a : QN) => ir_vcg_oR QC (ir_vcg_lookup fs (ir_vcg_mfresh s) a) (fun (_ : QC) => tg))
  (fun (s : QM) (_ : IRList Nat) (a : QN) => ir_vcg_oR QC (ir_vcg_lookup fs (ir_vcg_mfresh s) a) (fun (_ : QC) => tg))
  (fun (_ : QM) (_ : IRList Nat) (j : Nat) => ir_vcg_bf_r2 tg (ir_vcg_fact_at fs j))
  (fun (s : QM) (a : QN) (v : QV) => ir_vcg_oR QC (ir_vcg_lookup fs (ir_vcg_mfresh s) a) (fun (_ : QC) => ir_vcg_oR (IRList QC) (ir_vcg_update fs (ir_vcg_mfresh s) a v) (fun (_ : IRList QC) => tg)))
  (fun (_ : QM) (_ : IRList QC) (_ : QN) (_ : IRList QV) => IRConfig.halted IROutcome.fuel_out)
  (fun (_ : QM) => IRConfig.halted IROutcome.fuel_out) (fun (s : QM) (_ : IRList Nat) (x : QN) (y : QN) => ir_vcg_oR Bool (ir_vcg_cmpd fs x y) (fun (_ : Bool) => tg)) st

def ir_vcg_lhs (m : IRModule) (sf : IRMachine -> IRConfig) (env : QE) (mem : IRList IRMemSlot) (d : IRList Nat) (r : IRList IRFrame) (fs : IRList QF) (T : IRList QS) : IRList IRConfig := IRList.rec QS (fun (_ : IRList QS) => IRList IRConfig) (IRList.nil IRConfig) (fun (st : QS) (_ : IRList QS) (ih : IRList IRConfig) => IRList.cons IRConfig (ir_vcg_l1 m sf env mem d r fs st) (IRList.cons IRConfig (ir_vcg_l2 m env mem d r fs st) ih)) T

def ir_vcg_rhs (m : IRModule) (env : QE) (mem : IRList IRMemSlot) (d : IRList Nat) (r : IRList IRFrame) (fs : IRList QF) (T : IRList QS) : IRList IRConfig := IRList.rec QS (fun (_ : IRList QS) => IRList IRConfig) (IRList.nil IRConfig) (fun (st : QS) (rest : IRList QS) (ih : IRList IRConfig) => IRList.cons IRConfig (ir_vcg_r1 m env mem d r fs st (ir_vcg_target env mem d r st rest)) (IRList.cons IRConfig (ir_vcg_r2 fs st (ir_vcg_target env mem d r st rest)) ih)) T

def ir_vcg_adv (m : IRModule) (env : QE) (mem : IRList IRMemSlot) (d : IRList Nat) (r : IRList IRFrame) (st : QS) : IRConfig := QS.rec (fun (_ : QS) => IRConfig) (fun (s : QM) => ir_step m (ir_vcg_mden env mem d r s)) (fun (s : QM) (_ : IRList Nat) (_ : IRTy) (_ : QN) => ir_step m (ir_vcg_mden env mem d r s)) (fun (s : QM) (_ : IRList Nat) (_ : QN) => ir_step m (ir_vcg_mden env mem d r s)) (fun (s : QM) (_ : IRList Nat) (_ : Nat) => ir_step m (ir_vcg_mden env mem d r s)) (fun (s : QM) (_ : QN) (_ : QV) => ir_step m (ir_vcg_mden env mem d r s)) (fun (s : QM) (_ : IRList QC) (_ : QN) (_ : IRList QV) => ir_step m (ir_vcg_mden env mem d r s)) (fun (s : QM) => IRConfig.running (ir_vcg_mden env mem d r s)) (fun (s : QM) (_ : IRList Nat) (_ : QN) (_ : QN) => ir_step m (ir_vcg_mden env mem d r s)) st

def ir_vcg_step_ok (m : IRModule) (sf : IRMachine -> IRConfig) (hsf : forall (x : IRMachine), Eq IRConfig (ir_step m x) (sf x)) (env : QE) (mem : IRList IRMemSlot) (d : IRList Nat) (r : IRList IRFrame) (fs : IRList QF) (hf : ir_vcg_facts_hold env mem fs) (st : QS) (tg : IRConfig) (h1 : Eq IRConfig (ir_vcg_l1 m sf env mem d r fs st) (ir_vcg_r1 m env mem d r fs st tg)) (h2 : Eq IRConfig (ir_vcg_l2 m env mem d r fs st) (ir_vcg_r2 fs st tg)) : Eq IRConfig (ir_vcg_adv m env mem d r st) tg :=
  QS.rec
    (fun (st0 : QS) => Eq IRConfig (ir_vcg_l1 m sf env mem d r fs st0) (ir_vcg_r1 m env mem d r fs st0 tg) -> Eq IRConfig (ir_vcg_l2 m env mem d r fs st0) (ir_vcg_r2 fs st0 tg) -> Eq IRConfig (ir_vcg_adv m env mem d r st0) tg)
    (fun (s : QM) (h1s : Eq IRConfig (sf (ir_vcg_mden env mem d r s)) tg) (_ : Eq IRConfig (IRConfig.halted IROutcome.fuel_out) (IRConfig.halted IROutcome.fuel_out)) => Eq.trans IRConfig (ir_step m (ir_vcg_mden env mem d r s)) (sf (ir_vcg_mden env mem d r s)) tg (hsf (ir_vcg_mden env mem d r s)) h1s)
    (fun (s : QM) (rs : IRList Nat) (t : IRTy) (a : QN) => ir_vcg_look_ok env mem fs hf (ir_vcg_mfresh s) a (sf (ir_vcg_mden env mem d r s)) (fun (o : IROption IRMemSlot) => ir_vcg_r_load m (ir_vcg_mden env mem d r s) rs t o) tg (ir_step m (ir_vcg_mden env mem d r s)) (hsf (ir_vcg_mden env mem d r s)))
    (fun (s : QM) (rs : IRList Nat) (a : QN) => ir_vcg_look_ok env mem fs hf (ir_vcg_mfresh s) a (sf (ir_vcg_mden env mem d r s)) (fun (o : IROption IRMemSlot) => ir_vcg_r_borrow (ir_vcg_mden env mem d r s) rs (ir_vcg_nden env a) o) tg (ir_step m (ir_vcg_mden env mem d r s)) (hsf (ir_vcg_mden env mem d r s)))
    (fun (s : QM) (rs : IRList Nat) (j : Nat) => ir_vcg_borrowf_ok m sf env mem (ir_vcg_mden env mem d r s) rs tg (ir_vcg_fact_at fs j) (ir_vcg_fact_at_holds env mem fs hf j) (ir_step m (ir_vcg_mden env mem d r s)) (hsf (ir_vcg_mden env mem d r s)))
    (fun (s : QM) (a : QN) (v : QV) => ir_vcg_store_ok env mem fs hf (ir_vcg_mfresh s) a v (sf (ir_vcg_mden env mem d r s)) (fun (o : IROption IRMemSlot) (u : IRList IRMemSlot) => ir_vcg_r_store (ir_vcg_mden env mem d r s) o u) tg (ir_step m (ir_vcg_mden env mem d r s)) (hsf (ir_vcg_mden env mem d r s)))
    (fun (s : QM) (fr : IRList QC) (na : QN) (vals : IRList QV) (h1s : Eq IRConfig (sf (ir_vcg_mden env mem d r s)) tg) (_ : Eq IRConfig (IRConfig.halted IROutcome.fuel_out) (IRConfig.halted IROutcome.fuel_out)) => Eq.trans IRConfig (ir_step m (ir_vcg_mden env mem d r s)) (sf (ir_vcg_mden env mem d r s)) tg (hsf (ir_vcg_mden env mem d r s)) h1s)
    (fun (s : QM) (h1s : Eq IRConfig (IRConfig.running (ir_vcg_mden env mem d r s)) tg) (_ : Eq IRConfig (IRConfig.halted IROutcome.fuel_out) (IRConfig.halted IROutcome.fuel_out)) => h1s) (fun (s : QM) (rs : IRList Nat) (x : QN) (y : QN) => ir_vcg_cmp_ok env mem fs hf x y (sf (ir_vcg_mden env mem d r s)) (fun (b : Bool) => ir_vcg_r_cmp (ir_vcg_mden env mem d r s) rs b) tg (ir_step m (ir_vcg_mden env mem d r s)) (hsf (ir_vcg_mden env mem d r s)))
    st h1 h2

def ir_vcg_slen (st : QS) (k : Nat) : Nat := QS.rec (fun (_ : QS) => Nat) (fun (_ : QM) => Nat.succ k) (fun (_ : QM) (_ : IRList Nat) (_ : IRTy) (_ : QN) => Nat.succ k) (fun (_ : QM) (_ : IRList Nat) (_ : QN) => Nat.succ k) (fun (_ : QM) (_ : IRList Nat) (_ : Nat) => Nat.succ k) (fun (_ : QM) (_ : QN) (_ : QV) => Nat.succ k) (fun (_ : QM) (_ : IRList QC) (_ : QN) (_ : IRList QV) => Nat.succ k) (fun (_ : QM) => k) (fun (_ : QM) (_ : IRList Nat) (_ : QN) (_ : QN) => Nat.succ k) st

def ir_vcg_len (T : IRList QS) : Nat := IRList.rec QS (fun (_ : IRList QS) => Nat) Nat.zero (fun (st : QS) (_ : IRList QS) (ih : Nat) => ir_vcg_slen st ih) T

def ir_vcg_adv_steps (m : IRModule) (env : QE) (mem : IRList IRMemSlot) (d : IRList Nat) (r : IRList IRFrame) (st : QS) (k : Nat) : Eq IRConfig (ir_steps (ir_vcg_slen st k) m (IRConfig.running (ir_vcg_mden env mem d r (ir_vcg_start st)))) (ir_steps k m (ir_vcg_adv m env mem d r st)) := QS.rec (fun (st0 : QS) => Eq IRConfig (ir_steps (ir_vcg_slen st0 k) m (IRConfig.running (ir_vcg_mden env mem d r (ir_vcg_start st0)))) (ir_steps k m (ir_vcg_adv m env mem d r st0))) (fun (s : QM) => Eq.refl IRConfig (ir_steps k m (ir_step m (ir_vcg_mden env mem d r s)))) (fun (s : QM) (_ : IRList Nat) (_ : IRTy) (_ : QN) => Eq.refl IRConfig (ir_steps k m (ir_step m (ir_vcg_mden env mem d r s)))) (fun (s : QM) (_ : IRList Nat) (_ : QN) => Eq.refl IRConfig (ir_steps k m (ir_step m (ir_vcg_mden env mem d r s)))) (fun (s : QM) (_ : IRList Nat) (_ : Nat) => Eq.refl IRConfig (ir_steps k m (ir_step m (ir_vcg_mden env mem d r s)))) (fun (s : QM) (_ : QN) (_ : QV) => Eq.refl IRConfig (ir_steps k m (ir_step m (ir_vcg_mden env mem d r s)))) (fun (s : QM) (_ : IRList QC) (_ : QN) (_ : IRList QV) => Eq.refl IRConfig (ir_steps k m (ir_step m (ir_vcg_mden env mem d r s)))) (fun (s : QM) => Eq.refl IRConfig (ir_steps k m (IRConfig.running (ir_vcg_mden env mem d r s)))) (fun (s : QM) (_ : IRList Nat) (_ : QN) (_ : QN) => Eq.refl IRConfig (ir_steps k m (ir_step m (ir_vcg_mden env mem d r s)))) st

def ir_vcg_start_cfg (env : QE) (mem : IRList IRMemSlot) (d : IRList Nat) (r : IRList IRFrame) (T : IRList QS) : IRConfig := IRList.rec QS (fun (_ : IRList QS) => IRConfig) (IRConfig.halted IROutcome.fuel_out) (fun (st : QS) (_ : IRList QS) (_ : IRConfig) => IRConfig.running (ir_vcg_mden env mem d r (ir_vcg_start st))) T

def ir_vcg_final (env : QE) (mem : IRList IRMemSlot) (d : IRList Nat) (r : IRList IRFrame) (T : IRList QS) : IRConfig := IRList.rec QS (fun (_ : IRList QS) => IRConfig) (IRConfig.halted IROutcome.fuel_out) (fun (st : QS) (rest : IRList QS) (ih : IRConfig) => IRList.rec QS (fun (_ : IRList QS) => IRConfig) (ir_vcg_end_cfg env mem d r st) (fun (_ : QS) (_ : IRList QS) (_ : IRConfig) => ih) rest) T

def ir_vcg_claim (m : IRModule) (env : QE) (mem : IRList IRMemSlot) (d : IRList Nat) (r : IRList IRFrame) (T : IRList QS) : Prop := Eq IRConfig (ir_steps (ir_vcg_len T) m (ir_vcg_start_cfg env mem d r T)) (ir_vcg_final env mem d r T)

def ir_vcg_tail (m : IRModule) (env : QE) (mem : IRList IRMemSlot) (d : IRList Nat) (r : IRList IRFrame) (st : QS) (rest : IRList QS) (hc : ir_vcg_claim m env mem d r rest) : Eq IRConfig (ir_steps (ir_vcg_len rest) m (ir_vcg_target env mem d r st rest)) (ir_vcg_final env mem d r (IRList.cons QS st rest)) :=
  IRList.rec QS
    (fun (rest0 : IRList QS) => ir_vcg_claim m env mem d r rest0 -> Eq IRConfig (ir_steps (ir_vcg_len rest0) m (ir_vcg_target env mem d r st rest0)) (ir_vcg_final env mem d r (IRList.cons QS st rest0)))
    (fun (_ : ir_vcg_claim m env mem d r (IRList.nil QS)) => Eq.refl IRConfig (ir_vcg_end_cfg env mem d r st))
    (fun (st2 : QS) (rest2 : IRList QS) (_ : ir_vcg_claim m env mem d r rest2 -> Eq IRConfig (ir_steps (ir_vcg_len rest2) m (ir_vcg_target env mem d r st rest2)) (ir_vcg_final env mem d r (IRList.cons QS st rest2))) (hc2 : ir_vcg_claim m env mem d r (IRList.cons QS st2 rest2)) => hc2)
    rest hc

def ir_vcg_chd (l : IRList IRConfig) : IRConfig := IRList.rec IRConfig (fun (_ : IRList IRConfig) => IRConfig) (IRConfig.halted IROutcome.fuel_out) (fun (x : IRConfig) (_ : IRList IRConfig) (_ : IRConfig) => x) l

def ir_vcg_ctl (l : IRList IRConfig) : IRList IRConfig := IRList.rec IRConfig (fun (_ : IRList IRConfig) => IRList IRConfig) (IRList.nil IRConfig) (fun (_ : IRConfig) (rest : IRList IRConfig) (_ : IRList IRConfig) => rest) l

def ir_vcg_run_sound (m : IRModule) (sf : IRMachine -> IRConfig) (hsf : forall (x : IRMachine), Eq IRConfig (ir_step m x) (sf x)) (env : QE) (mem : IRList IRMemSlot) (d : IRList Nat) (r : IRList IRFrame) (fs : IRList QF) (hf : ir_vcg_facts_hold env mem fs) (T : IRList QS) (hob : Eq (IRList IRConfig) (ir_vcg_lhs m sf env mem d r fs T) (ir_vcg_rhs m env mem d r fs T)) : ir_vcg_claim m env mem d r T :=
  IRList.rec QS
    (fun (T0 : IRList QS) => Eq (IRList IRConfig) (ir_vcg_lhs m sf env mem d r fs T0) (ir_vcg_rhs m env mem d r fs T0) -> ir_vcg_claim m env mem d r T0)
    (fun (_ : Eq (IRList IRConfig) (IRList.nil IRConfig) (IRList.nil IRConfig)) => Eq.refl IRConfig (IRConfig.halted IROutcome.fuel_out))
    (fun (st : QS) (rest : IRList QS) (ih : Eq (IRList IRConfig) (ir_vcg_lhs m sf env mem d r fs rest) (ir_vcg_rhs m env mem d r fs rest) -> ir_vcg_claim m env mem d r rest) (hob0 : Eq (IRList IRConfig) (ir_vcg_lhs m sf env mem d r fs (IRList.cons QS st rest)) (ir_vcg_rhs m env mem d r fs (IRList.cons QS st rest))) =>
      Eq.trans IRConfig (ir_steps (ir_vcg_slen st (ir_vcg_len rest)) m (IRConfig.running (ir_vcg_mden env mem d r (ir_vcg_start st)))) (ir_steps (ir_vcg_len rest) m (ir_vcg_adv m env mem d r st)) (ir_vcg_final env mem d r (IRList.cons QS st rest)) (ir_vcg_adv_steps m env mem d r st (ir_vcg_len rest))
      (Eq.subst IRConfig (fun (c : IRConfig) => Eq IRConfig (ir_steps (ir_vcg_len rest) m c) (ir_vcg_final env mem d r (IRList.cons QS st rest)))
        (ir_vcg_target env mem d r st rest) (ir_vcg_adv m env mem d r st)
        (Eq.symm IRConfig (ir_vcg_adv m env mem d r st) (ir_vcg_target env mem d r st rest)
