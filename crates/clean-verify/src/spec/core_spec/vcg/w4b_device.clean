def ir_vcg_env4 (x0 : Nat) (x1 : Nat) (x2 : Nat) (x3 : Nat) : QE := QE.m (IRList.cons Nat x0 (IRList.cons Nat x1 (IRList.cons Nat x2 (IRList.cons Nat x3 (IRList.nil Nat))))) (IRList.nil IRScalar)

def ir_vcg_env5 (x0 : Nat) (x1 : Nat) (x2 : Nat) (x3 : Nat) (x4 : Nat) : QE := QE.m (IRList.cons Nat x0 (IRList.cons Nat x1 (IRList.cons Nat x2 (IRList.cons Nat x3 (IRList.cons Nat x4 (IRList.nil Nat)))))) (IRList.nil IRScalar)

