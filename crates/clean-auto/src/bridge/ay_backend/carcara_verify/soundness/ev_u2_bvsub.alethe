(assume h1 (= x (bvsub #b0000 #b1111)))
(assume h2 (= x #b0001))
(step e1 (cl (= (bvsub #b0000 #b1111) #b1111)) :rule evaluate)
(step t1 (cl (= x #b1111)) :rule trans :premises (h1 e1))
(step s2 (cl (= #b0001 x)) :rule symm :premises (h2))
(step t2 (cl (= #b0001 #b1111)) :rule trans :premises (s2 t1))
(step ev (cl (= (= #b0001 #b1111) false)) :rule evaluate)
(step q1 (cl (not (= #b0001 #b1111)) false) :rule equiv1 :premises (ev))
(step q2 (cl (not false)) :rule false)
(step done (cl) :rule resolution :premises (t2 q1 q2))
