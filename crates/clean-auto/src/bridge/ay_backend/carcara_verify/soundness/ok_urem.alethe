(assume h1 (= x #b01))
(assume h2 (= y #b01))
(assume h3 (= (bvurem x y) #b01))
(step cx (cl (= #b01 (@bbterm true false))) :rule bitblast_const)
(step e1 (cl (= x (@bbterm true false))) :rule trans :premises (h1 cx))
(step e2 (cl (= y (@bbterm true false))) :rule trans :premises (h2 cx))
(step e3 (cl (= (bvurem x y) (bvurem (@bbterm true false) (@bbterm true false)))) :rule cong :premises (e1 e2))
