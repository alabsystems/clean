(assume h0 (not (str.in_re s (re.++ (str.to_re "a") (str.to_re "b")))))
(assume nc (not (forall ((L Int)) (or (< L 0) (< (str.len s) L) (not (str.in_re (str.substr s 0 L) (str.to_re "a"))) (not (str.in_re (str.substr s L (- (str.len s) L)) (str.to_re "b")))))))
(step s (cl (forall ((L Int)) (or (< L 0) (< (str.len s) L) (not (str.in_re (str.substr s 0 L) (str.to_re "a"))) (not (str.in_re (str.substr s L (- (str.len s) L)) (str.to_re "b")))))) :rule re_unfold_neg :premises (h0))
(step done (cl) :rule resolution :premises (nc s))
